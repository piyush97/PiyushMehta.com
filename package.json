    "@types/react-dom": "^18.3.7",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/og": "^0.6.8",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^5.18.1",
    "ioredis": "^5.10.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
