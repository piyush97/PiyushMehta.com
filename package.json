{
  "name": "piyushmehta.com",
  "type": "module",
  "version": "3.2.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:prepare && npm run build:astro && npm run build:postprocess",
    "build:prepare": "node scripts/build/extract-critical-css.mjs && node scripts/migration/migrate-images-to-public.mjs",
    "build:astro": "cross-env PUBLIC_SUPABASE_URL=http://localhost:54321 PUBLIC_SUPABASE_ANON_KEY=dummy-key-for-local-dev astro build",
    "build:postprocess": "npx pagefind --site dist && node scripts/build/generate-enhanced-sitemap.mjs && node scripts/build/generate-static-rss.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "migrate:images": "node scripts/migration/migrate-images-to-public.mjs",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci": "biome ci .",
    "enhance-sitemap": "node scripts/build/generate-enhanced-sitemap.mjs",
    "generate-rss": "node scripts/build/generate-static-rss.mjs",
    "verify-rss": "node scripts/test/verify-rss.mjs",
    "test-seo": "node scripts/test/test-seo-files.mjs",
    "validate-og": "node scripts/test/validate-og-images.mjs",
    "test:rss": "node scripts/test/test-rss-output.mjs",
    "test:og": "node scripts/test/test-og-image.mjs",
    "test:all-scripts": "npm run test-seo && npm run verify-rss && npm run validate-og",
    "build:scripts": "npm run enhance-sitemap && npm run generate-rss",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.4",
    "@astrojs/react": "^4.3.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.5.0",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.6",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/astro": "^9.46.0",
    "@sentry/node": "^9.46.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.55.0",
    "@trpc/client": "^11.4.4",
    "@trpc/server": "^11.4.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "@vercel/og": "^0.7.2",
    "@vercel/speed-insights": "^1.2.0",
    "astro": "^5.13.2",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.1",
    "ioredis": "^5.7.0",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "next-cookies": "^2.0.3",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "satori": "^0.16.2",
    "satori-html": "^0.3.2",
    "tailwindcss": "3.4.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "2.1.2",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/typography": "^0.5.16",
    "lefthook": "^1.12.3",
    "pagefind": "^1.3.0",
    "typescript": "5.8.3",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-webpack-plugin": "^7.3.0"
  }
}
