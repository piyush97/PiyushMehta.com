{
  "name": "piyushmehta.com",
  "type": "module",
  "version": "3.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/extract-critical-css.mjs && node scripts/migrate-images-to-public.mjs && astro build && npx pagefind --site dist && node scripts/generate-enhanced-sitemap.mjs && node scripts/generate-static-rss.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "migrate:images": "node scripts/migrate-images-to-public.mjs",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci": "biome ci .",
    "enhance-sitemap": "node scripts/generate-enhanced-sitemap.mjs",
    "generate-rss": "node scripts/generate-static-rss.mjs",
    "verify-rss": "node scripts/verify-rss.mjs",
    "test-seo": "node scripts/test-seo-files.mjs",
    "test-rss": "node scripts/test-rss-output.mjs",
    "debug-rss": "node scripts/debug-rss-feed.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.4",
    "@astrojs/react": "^4.3.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.5.1",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.6",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/astro": "^9.46.0",
    "@sentry/node": "^9.46.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "@vercel/og": "^0.6.8",
    "@vercel/speed-insights": "^1.2.0",
    "astro": "^5.13.4",
    "ioredis": "^5.7.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.13.2",
    "tailwindcss": "^3.4.17"
