    "lint:fix": "biome lint --write src/",
    "format": "biome format --write .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci": "biome ci .",
    "enhance-sitemap": "node scripts/generate-enhanced-sitemap.mjs",
    "generate-rss": "node scripts/generate-static-rss.mjs",
    "verify-rss": "node scripts/verify-rss.mjs",
    "test-seo": "node scripts/test-seo-files.mjs",
    "test-rss": "node scripts/test-rss-output.mjs",
    "debug-rss": "node scripts/debug-rss-feed.mjs",
