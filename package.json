{
  "name": "piyushmehta.com",
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build.mjs",
    "deploy": "bun run build && varlock-wrangler deploy",
    "cf:types": "varlock-wrangler types .wrangler/worker-configuration.d.ts",
    "preview": "varlock-wrangler dev --config dist/server/wrangler.json",
    "astro": "astro",
    "migrate:images": "node scripts/migrate-images-to-public.mjs",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt . --write",
    "format:write": "vp fmt . --write",
    "check": "astro sync && bunx varlock codegen && vp check",
    "check:write": "astro sync && bunx varlock codegen && vp check --fix",
    "ci": "vp check",
    "test": "playwright test",
    "test:smoke": "playwright test tests/portfolio-smoke.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.4",
    "@astrojs/rss": "4.0.19",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/astro": "^10.74.0",
    "@sentry/cloudflare": "10.71.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "@varlock/astro-integration": "^1.4.2",
    "@varlock/cloudflare-integration": "1.5.0",
    "astro": "^7.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.3",
    "varlock": "^1.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20260827.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.5.1",
    "lefthook": "^2.1.14",
    "pagefind": "^1.5.2",
    "react-doctor": "^0.9.14",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "wrangler": "4.126.0"
  },
  "overrides": {
    "estree-walker": "2.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "engines": {
    "node": "26.8.1"
  },
  "packageManager": "bun@1.4.0"
}
