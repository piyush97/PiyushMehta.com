{
  "name": "piyushmehta.com",
  "type": "module",
  "version": "3.1.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "concurrently --kill-others-on-fail \"node scripts/extract-critical-css.mjs\" \"node scripts/migrate-images-to-public.mjs\" && astro build && concurrently --kill-others-on-fail \"node scripts/run-pagefind.mjs\" \"node scripts/generate-enhanced-sitemap.mjs\" \"node scripts/generate-static-rss.mjs\"",
    "preview": "astro preview",
    "astro": "astro",
    "migrate:images": "node scripts/migrate-images-to-public.mjs",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "ci": "biome ci .",
    "enhance-sitemap": "node scripts/generate-enhanced-sitemap.mjs",
    "generate-rss": "node scripts/generate-static-rss.mjs",
    "verify-rss": "node scripts/verify-rss.mjs",
    "test-seo": "node scripts/test-seo-files.mjs",
    "test-rss": "node scripts/test-rss-output.mjs",
    "debug-rss": "node scripts/debug-rss-feed.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test tests/portfolio-smoke.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.6",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/astro": "^10.52.0",
    "@sentry/node": "^10.52.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.3.1",
    "ioredis": "^5.10.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.12.2",
    "satori": "^0.26.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.2",
    "@biomejs/biome": "2.4.13",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.6",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
