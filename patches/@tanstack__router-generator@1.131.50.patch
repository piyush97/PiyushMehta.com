+
+// Shim: CONSTANTS and startAPIRouteSegmentsFromTSRFilePath were added after 1.131.50
+// but @tanstack/start-config@1.120.20 was compiled expecting them.
+const CONSTANTS = {
+  APIRouteExportVariable: 'APIRoute',
+};
+
+function startAPIRouteSegmentsFromTSRFilePath(filePath, _tsrConfig) {
+  const cleaned = filePath.replace(/^\//, '').replace(/\.(tsx?|jsx?)$/, '');
+  const parts = cleaned.split('/');
+  return parts.map((part) => {
+    if (part.startsWith('$') && part.endsWith(')')) {
+      // optional param like $id()
+      return { type: 'param', value: part.slice(1, -2) };
+    }
+    if (part === '$') {
+      return { type: 'splat', value: '*' };
+    }
+    if (part.startsWith('$')) {
+      return { type: 'param', value: part.slice(1) };
+    }
+    return { type: 'static', value: part };
+  });
+}
