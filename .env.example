# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Configuration (Supabase provides this automatically)
DATABASE_URL=postgresql://username:password@localhost:5432/newsletter_db

# Authentication
AUTH_SECRET=your_auth_secret_key_min_32_characters
JWT_SECRET=your_jwt_secret_key_for_token_signing
NEXTAUTH_URL=http://localhost:4321
NEXTAUTH_SECRET=your_nextauth_secret_32_characters_min

# Redis Configuration (Upstash for production, local for development)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
REDIS_URL=redis://localhost:6379  # For local development

# Database Performance Optimization
POSTGRES_URL=postgresql://username:password@localhost:5432/database
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=5000
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL=300

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@piyushmehta.com
FROM_NAME=Piyush Mehta

# GitHub Integration (Optional)
# Create a token at https://github.com/settings/tokens
# Only public_repo scope is needed
GITHUB_TOKEN=your_github_token_here

# Substack Integration (Optional)
SUBSTACK_PUBLICATION_URL=https://yourpublication.substack.com

# Sentry Configuration
SENTRY_DSN=your_sentry_dsn_here
PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug

# Environment
NODE_ENV=development
SITE_URL=http://localhost:4321

# GDPR & Analytics
ENABLE_ANALYTICS=false
COOKIE_CONSENT_REQUIRED=true
DATA_RETENTION_DAYS=365

# Security Configuration
ENABLE_RATE_LIMITING=true
MAX_COMMENTS_PER_HOUR=10
MAX_FAILED_LOGIN_ATTEMPTS=5
CSRF_SECRET=your_csrf_secret_key_32_characters

# Enhanced Security Settings
SECURITY_RATE_LIMIT_WINDOW=900000          # 15 minutes in milliseconds
SECURITY_RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window
SECURITY_STRICT_RATE_LIMIT_MAX=10          # Strict limit for sensitive endpoints
SECURITY_IP_REPUTATION_THRESHOLD=0.7       # IP reputation threshold (0.0-1.0)
SECURITY_IP_REPUTATION_CACHE_TTL=3600      # IP reputation cache TTL in seconds
SECURITY_ENABLE_IP_BLOCKING=true           # Enable IP-based blocking
SECURITY_ENABLE_BOT_DETECTION=true         # Enable bot detection
SECURITY_ENABLE_GEO_BLOCKING=false         # Enable geographic blocking
SECURITY_LOG_LEVEL=info                    # Security logging level (debug, info, warn, error)

# Certificate Transparency
SECURITY_ENABLE_CT_MONITORING=true         # Enable Certificate Transparency monitoring
SECURITY_CT_REPORT_URI=/api/ct-report      # CT violation report endpoint

# Content Security Policy
SECURITY_CSP_REPORT_URI=/api/csp-report    # CSP violation report endpoint
SECURITY_CSP_REPORT_ONLY=false             # Set to true for CSP report-only mode

# HSTS Configuration
SECURITY_HSTS_MAX_AGE=63072000             # HSTS max age (2 years)
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true      # Include subdomains in HSTS
SECURITY_HSTS_PRELOAD=true                 # Enable HSTS preload
