# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=src/varlock.env.d.ts)
# ----------

# ── Runtime ──────────────────────────────────────────────────────────────────
# @optional
NODE_ENV=development

# ── Legacy database variables ───────────────────────────────────────────────
# Retained only for migration/debugging compatibility. The current application
# has no database callsite.
# @optional @sensitive @type=url
POSTGRES_URL=

# Legacy alias; do not provision for the current architecture.
# @optional @sensitive @type=url
DATABASE_URL=

# ── Redis ────────────────────────────────────────────────────────────────────
# Legacy generic Redis variable; no active ioredis fallback exists.
# @optional @sensitive @type=url
REDIS_URL=

# Upstash Redis REST API (active serverless rate-limit and reaction store)
# @optional @sensitive @type=url
UPSTASH_REDIS_REST_URL=
# @optional @sensitive
UPSTASH_REDIS_REST_TOKEN=

# ── GitHub ───────────────────────────────────────────────────────────────────
# GitHub personal access token — public_repo scope only
# @optional @sensitive @example="github_pat_..."
GITHUB_TOKEN=

# ── Sentry ───────────────────────────────────────────────────────────────────
# Server-side DSN — intentionally public, Sentry embeds DSNs in client JS by design
# @optional
SENTRY_DSN=
# Client-side DSN (PUBLIC_ prefix = exposed to browser)
# @optional
PUBLIC_SENTRY_DSN=
# Used by sentry-vite-plugin to upload sourcemaps at build time
# @optional @sensitive
SENTRY_AUTH_TOKEN=
# @optional
SENTRY_ORG=
# @optional
SENTRY_PROJECT=

# ── Email — Resend ───────────────────────────────────────────────────────────
# API key from resend.com (used by the contact form)
# @optional @sensitive @example="re_..."
RESEND_API_KEY=
# @optional @type=email
CONTACT_FROM_EMAIL=contact@piyushmehta.com
# @optional @type=email
CONTACT_TO_EMAIL=contact@piyushmehta.com

# ── Legacy Sanity vars (from a previous project) ──────────────────────────────
# @optional
NEXT_PUBLIC_SANITY_DATASET=
# @optional
NEXT_PUBLIC_SANITY_PROJECT_ID=
# @optional @sensitive
SANITY_API_READ_TOKEN=
