# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=src/varlock.env.d.ts)
# ----------

# ── Runtime ──────────────────────────────────────────────────────────────────
# @optional
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used by newsletter subscription storage)
# @optional @sensitive @type=url
POSTGRES_URL=

# Legacy alias — prefer POSTGRES_URL
# @optional @sensitive @type=url
DATABASE_URL=

# ── Redis ────────────────────────────────────────────────────────────────────
# Generic Redis URL (ioredis fallback when Upstash not configured)
# @optional @sensitive @type=url
REDIS_URL=

# Upstash Redis REST API (preferred for serverless rate limiting)
# @optional @sensitive @type=url
UPSTASH_REDIS_REST_URL=
# @optional @sensitive
UPSTASH_REDIS_REST_TOKEN=

# ── GitHub ───────────────────────────────────────────────────────────────────
# GitHub personal access token — public_repo scope only
# @optional @sensitive @example="github_pat_..."
GITHUB_TOKEN=

# ── Sentry ───────────────────────────────────────────────────────────────────
# Server-side DSN — intentionally public, Sentry embeds DSNs in client JS by design
# @optional
SENTRY_DSN=
# Client-side DSN (PUBLIC_ prefix = exposed to browser)
# @optional
PUBLIC_SENTRY_DSN=
# Used by sentry-vite-plugin to upload sourcemaps at build time
# @optional @sensitive
SENTRY_AUTH_TOKEN=
# @optional
SENTRY_ORG=
# @optional
SENTRY_PROJECT=

# ── Email — Resend ───────────────────────────────────────────────────────────
# API key from resend.com (free tier: 3000 emails/month)
# @optional @sensitive @example="re_..."
RESEND_API_KEY=
# Resend Segment ID (Audiences are deprecated as of 2026; use Segments).
# Create one via POST /segments or in the Resend dashboard.
# @optional @example="78261eea-8f8b-4381-83c6-79fa7120f1cf"
RESEND_SEGMENT_ID=
# Verified sender for outbound newsletter broadcasts.
# @optional @type=email
RESEND_FROM=Piyush Mehta <news@piyushmehta.com>
# Reply-to address shown when subscribers hit Reply.
# @optional @type=email
RESEND_REPLY_TO=contact@piyushmehta.com
# @optional @type=email
CONTACT_FROM_EMAIL=contact@piyushmehta.com
# @optional @type=email
CONTACT_TO_EMAIL=contact@piyushmehta.com

# ── Email — Mailchimp ────────────────────────────────────────────────────────
# @optional @sensitive @example="abc123..."
MAILCHIMP_API_KEY=
# @optional
MAILCHIMP_AUDIENCE_ID=
# @optional @example="us1"
MAILCHIMP_SERVER_PREFIX=

# ── Email — ConvertKit ───────────────────────────────────────────────────────
# @optional @sensitive
CONVERTKIT_API_KEY=
# @optional
CONVERTKIT_FORM_ID=

# ── Legacy Sanity vars (from previous project, kept in Vercel) ───────────────
# @optional
NEXT_PUBLIC_SANITY_DATASET=
# @optional
NEXT_PUBLIC_SANITY_PROJECT_ID=
# @optional @sensitive
SANITY_API_READ_TOKEN=

# ── Newsletter security ───────────────────────────────────────────────────────
# Rate limiting window in milliseconds (default: 3600000 = 1 hour)
# @optional @type=number
NEWSLETTER_WINDOW_MS=
# Max requests per window per IP
# @optional @type=number
NEWSLETTER_MAX_REQUESTS=
# Max failed attempts before block
# @optional @type=number
NEWSLETTER_MAX_FAILED=
# Block duration in milliseconds
# @optional @type=number
NEWSLETTER_BLOCK_MS=
# Alert when subscriber count crosses this threshold
# @optional @type=number
NEWSLETTER_ALERT_THRESHOLD=
# Enable hCaptcha / Cloudflare Turnstile verification
# @optional @type=boolean
NEWSLETTER_CAPTCHA_ENABLED=
# Captcha secret key
# @optional @sensitive
NEWSLETTER_CAPTCHA_SECRET=
# Captcha score threshold (0.0–1.0)
# @optional @type=number
NEWSLETTER_CAPTCHA_THRESHOLD=
# Admin token for protected newsletter management endpoints
# @optional @sensitive
NEWSLETTER_ADMIN_TOKEN=
# Comma-separated trusted IP addresses (bypass rate limiting)
# @optional
NEWSLETTER_TRUSTED_IPS=
# Webhook URL to notify on new subscriptions
# @optional @type=url
NEWSLETTER_WEBHOOK_URL=
# Comma-separated domains to block from subscribing
# @optional
NEWSLETTER_CUSTOM_BLOCKED_DOMAINS=
