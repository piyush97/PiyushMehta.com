{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piyushmehta-com",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "vars": {
    "NODE_ENV": "production",
    "RESEND_FROM": "news@piyushmehta.com",
    "RESEND_REPLY_TO": "contact@piyushmehta.com",
    "CONTACT_FROM_EMAIL": "contact@piyushmehta.com",
    "CONTACT_TO_EMAIL": "contact@piyushmehta.com",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // trailingSlash is 'never' in astro.config.mjs, so canonical/og:url/twitter:url all emit
    // non-trailing-slash URLs (e.g. /blog/bloom-filters). Workers Assets' default
    // ("auto-trailing-slash") 307-redirects those to the trailing-slash form, contradicting
    // every URL the site itself advertises. This makes the served URL match.
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
}
