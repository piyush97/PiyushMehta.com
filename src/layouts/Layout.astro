---
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';
import favicon from '../assets/favicon.svg';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import SEO from '../components/SEO.astro';
import type { JsonLdData } from '../types/schema';
import '../styles/global.css';
import { initSiteMotion } from '../scripts/site-motion';

export interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string | { url: string; alt?: string; width?: number; height?: number; type?: string };
  author?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  canonical?: string;
  noindex?: boolean;
  schema?: JsonLdData;
  keywords?: string[];
  ogTemplate?: 'default' | 'minimal' | 'tech' | 'blog' | 'modern' | 'professional';
  ogTheme?: 'dark' | 'light' | 'retro';
  preloadImage?: string;
}

const {
  title,
  description = 'Piyush Mehta is a senior software engineer building reliable web platforms, AI workflows, and scalable product systems.',
  type = 'website',
  image,
  author,
  publishedTime,
  modifiedTime,
  tags,
  canonical,
  noindex,
  schema,
  keywords,
  ogTemplate = 'default',
  ogTheme = 'dark',
  preloadImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Piyush Mehta - Blog RSS Feed"
      href="/rss.xml"
    />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <SEO
      title={title}
      description={description}
      type={type}
      image={image}
      author={author}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      canonical={canonical}
      noindex={noindex}
      schema={schema}
      keywords={keywords}
      ogTemplate={ogTemplate === 'modern' || ogTemplate === 'professional' ? 'tech' : ogTemplate}
      ogTheme={ogTheme}
    />
    <script is:inline>
      const applyTheme = () => {
        const savedTheme = localStorage.getItem('theme');
        const preferredTheme =
          savedTheme ||
          (window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'professional-light'
            : 'professional-dark');
        const colorScheme = preferredTheme === 'professional-light' ? 'light' : 'dark';
        document.documentElement.classList.remove('professional-dark', 'professional-light', 'light', 'dark');
        document.documentElement.classList.add(preferredTheme);
        document.documentElement.style.colorScheme = colorScheme;
        document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', colorScheme);
        if (preferredTheme === 'professional-light') {
          document.documentElement.classList.add('light');
        }
      };

      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-to-main">Skip to main content</a>
    <Navbar />
    <main id="main-content" data-pagefind-body transition:animate="none">
      <slot />
    </main>
    <Footer />
    <SpeedInsights />
    <script>
      // Defer all motion/interaction logic until the browser is idle.
      // The reveal, parallax, and hero typography work is non-critical for
      // FCP/LCP — only the theme + route direction touch initial paint.
      import('../scripts/site-motion').then(({ initSiteMotion }) => {
        const runWhenIdle = () => {
          const idle = (window as unknown as {
            requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => void;
          }).requestIdleCallback;
          if (typeof idle === 'function') {
            idle(initSiteMotion, { timeout: 2000 });
          } else {
            window.setTimeout(initSiteMotion, 1500);
          }
        };

        document.addEventListener('astro:page-load', runWhenIdle);
        if (document.readyState !== 'loading') {
          runWhenIdle();
        } else {
          document.addEventListener('DOMContentLoaded', runWhenIdle, { once: true });
        }
      });
    </script>
  </body>
</html>
