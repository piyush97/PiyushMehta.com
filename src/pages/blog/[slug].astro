---
import { getCollection, render } from 'astro:content';
import ArticleMeta from '../../components/ArticleMeta.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import NewsletterSignup from '../../components/NewsletterSignup.tsx';
import OptimizedImage from '../../components/OptimizedImage.astro';
import PostReactions from '../../components/PostReactions.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import Layout from '../../layouts/Layout.astro';
import { createSocialCardMetadata } from '../../utils/social-card';
import { getSocialCardManifest } from '../../utils/social-card-manifest';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const toPostSlug = (id: string) => id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');
  return posts.map((post) => ({
    params: { slug: toPostSlug(post.id) },
    props: { post },
    cacheKey: post.digest,
  }));
}

const { post } = Astro.props;
const currentSlug = Astro.params.slug ?? post.id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');
const postBody = post.body ?? '';
const { Content } = await render(post);

const { title, description, date, author, tags, image, ogTemplate, ogTheme } = post.data;
const typedTags: string[] = tags ?? [];

// Calculate reading time (rough estimate)
const readingTime = Math.ceil(postBody.split(' ').length / 200);

const baseUrl = import.meta.env.DEV ? Astro.url.origin : Astro.site?.toString() || 'https://piyushmehta.com';
const socialImage = createSocialCardMetadata({
  pathname: `/blog/${currentSlug}`,
  baseUrl,
  title,
  author: author || 'Piyush Mehta',
  manifest: await getSocialCardManifest(),
});

// Generate canonical URL
const canonicalUrl = new URL(`/blog/${currentSlug}`, Astro.site).toString();

// Create structured data for the article
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description || `${title} - A blog post by ${author || 'Piyush Mehta'}`,
  author: {
    '@type': 'Person',
    name: author || 'Piyush Mehta',
    url: 'https://piyushmehta.com',
  },
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  url: canonicalUrl,
  keywords: typedTags.join(', '),
  wordCount: postBody.split(' ').length,
  timeRequired: `PT${readingTime}M`,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Person',
    name: 'Piyush Mehta',
    url: 'https://piyushmehta.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  image: {
    '@type': 'ImageObject',
    url: socialImage.url,
    description: socialImage.alt,
    width: socialImage.width,
    height: socialImage.height,
  },
};
---

<Layout
  title={title}
  description={description ||
    `${title} - A blog post by ${author || 'Piyush Mehta'}`}
  type="article"
  author={author}
  publishedTime={date}
  modifiedTime={date}
  tags={typedTags}
  canonical={canonicalUrl}
  image={socialImage}
  schema={articleSchema}
  ogTemplate={ogTemplate}
  ogTheme={ogTheme}
  preloadImage={image?.url}
>
  <div class="page-container blog-post-page">
    <div class="blog-post-shell">
      <!-- Breadcrumbs -->
      <div class="blog-post-breadcrumbs">
        <Breadcrumbs title={title} url={canonicalUrl} />
      </div>

      <article class="blog-post-article" itemscope itemtype="https://schema.org/Article" data-pagefind-body>
        <!-- Back Link -->
        <div class="blog-post-back">
          <a
            href="/blog/"
            class="blog-post-back__link"
          >
            <svg
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Blog
          </a>
        </div>

        <!-- Post Header -->
        <header class="blog-post-header">
          <h1
            class="blog-post-title"
            itemprop="headline"
            data-pagefind-meta="title"
          >
            {title}
          </h1>
          
          <!-- Hidden metadata for Pagefind -->
          <div data-pagefind-meta="description" class="hidden">{description}</div>
          <div data-pagefind-meta="author" class="hidden">{author || 'Piyush Mehta'}</div>
          <div data-pagefind-meta="date" class="hidden">{date.toISOString()}</div>
          <div data-pagefind-meta="type" class="hidden">blog</div>
          {typedTags.map((tag) => <div data-pagefind-meta="tag" class="hidden">{tag}</div>)}

          <div class="blog-post-meta">
            <div>
              <svg
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
              <time datetime={date.toISOString()} itemprop="datePublished">
                {
                  date.toLocaleDateString('en-US', {
                    timeZone: 'America/Toronto',
                  })
                }
              </time>
            </div>

            {
              author && (
                <div
                  itemprop="author"
                  itemscope
                  itemtype="https://schema.org/Person"
                >
                  <svg
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    />
                  </svg>
                  <span itemprop="name">by {author}</span>
                </div>
              )
            }

            <div>
              <svg
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>{readingTime} min read</span>
            </div>
          </div>

          {
            typedTags.length > 0 && (
              <div class="blog-post-tags">
                {typedTags.map((tag) => (
                  <span
                    class="blog-post-tag"
                    itemprop="keywords"
                  >
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
        </header>

        <!-- Featured Image -->
        {
          image && image.url && (
            <figure class="blog-post-hero-image">
              <OptimizedImage
                src={image.url}
                alt={image.alt || title}
                class="w-full h-auto"
                priority={true}
                quality={90}
                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 70vw"
              />
              {image.alt && (
                <figcaption>
                  {image.alt}
                </figcaption>
              )}
            </figure>
          )
        }

        <!-- Article Meta with Share Buttons -->
        <div class="blog-post-share">
          <ArticleMeta
            title={title}
            readingTime={readingTime}
            date={date}
            tags={typedTags}
            url={canonicalUrl}
          />
        </div>

        <!-- Post Content -->
        <div class="blog-post-content prose mdx-content" itemprop="articleBody">
          <Content />
        </div>

        <!-- Post Footer -->
        <footer class="blog-post-footer">
          <div>
            <a
              href="/blog/"
              class="blog-post-back__link"
            >
              <svg
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
              Back to Blog
            </a>

            <div>
              <meta itemprop="dateModified" content={date.toISOString()} />
              Last updated: {
                date.toLocaleDateString('en-US', {
                  timeZone: 'America/Toronto',
                })
              } Eastern Time
            </div>
          </div>
        </footer>
      </article>

      <div class="blog-post-after">
        <!-- Post Reactions -->
        <PostReactions 
          postId={currentSlug}
          title="Was this post helpful?"
          showCount={true}
          size="md"
          orientation="horizontal"
        />

        <!-- Newsletter Signup -->
        <div class="newsletter-cta-card" data-reveal>
          <div class="newsletter-cta-card__content">
            <svg class="newsletter-cta-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <div>
              <p class="newsletter-cta-card__heading">Enjoying the read?</p>
              <p class="newsletter-cta-card__text">
                One email when there's something worth saying. AI news, production lessons, 
                and builds — no spam, no fluff.
              </p>
            </div>
          </div>
          <NewsletterSignup client:visible variant="inline" source="blog-post-cta" />
        </div>

        <!-- Related Posts -->
        <RelatedPosts 
          currentSlug={currentSlug}
          currentTags={typedTags}
          maxPosts={3}
        />

        <!-- Comments Section -->
        <GiscusComments
          repo="piyushmehta/piyushmehta.com"
          repoId="R_kgDOL1234567890"
          category="Blog Comments"
          categoryId="DIC_kwDOL1234567890"
          mapping="pathname"
          reactionsEnabled={true}
          inputPosition="bottom"
          theme="preferred_color_scheme"
          lang="en"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</Layout>

<style>
  .blog-post-page {
    padding: clamp(2.75rem, 6vw, 5.5rem) 1rem clamp(4rem, 7vw, 6rem);
  }

  .blog-post-shell {
    width: min(100%, 1120px);
    margin-inline: auto;
  }

  .blog-post-breadcrumbs,
  .blog-post-back,
  .blog-post-share,
  .blog-post-footer,
  .blog-post-after {
    width: min(100%, 78ch);
    margin-inline: auto;
  }

  .blog-post-article {
    color: var(--color-text);
  }

  .blog-post-back {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .blog-post-back__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    text-underline-offset: 0.18em;
    transition:
      color 160ms ease,
      opacity 160ms ease;
  }

  .blog-post-back__link:hover {
    opacity: 0.82;
    text-decoration: underline;
  }

  .blog-post-back__link svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .blog-post-header {
    width: min(100%, 980px);
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-card-border) 76%, transparent);
    text-align: center;
  }

  .blog-post-title {
    max-width: 22ch;
    margin: 0 auto 1.25rem;
    color: var(--color-text-primary);
    font-size: clamp(2.45rem, 5vw, 4.35rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .blog-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem 1.25rem;
    margin: 0 auto 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.96rem;
    font-weight: 650;
  }

  .blog-post-meta > div {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .blog-post-meta svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: var(--color-accent);
  }

  .blog-post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .blog-post-tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    border: 1px solid rgba(var(--color-accent-rgb), 0.26);
    border-radius: 999px;
    background: rgba(var(--color-accent-rgb), 0.1);
    color: color-mix(in srgb, var(--color-accent) 88%, white);
    padding: 0.34rem 0.68rem;
    font-size: 0.84rem;
    font-weight: 800;
    line-height: 1;
  }

  .blog-post-hero-image {
    width: min(100%, 960px);
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
  }

  .blog-post-hero-image :global(img) {
    display: block;
    border: 1px solid color-mix(in srgb, var(--color-card-border) 84%, transparent);
    border-radius: 8px;
    background: var(--color-darker);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
  }

  .blog-post-hero-image figcaption {
    max-width: 74ch;
    margin: 0.75rem auto 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
    text-align: center;
  }

  .blog-post-share {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .blog-post-content {
    width: min(100%, 74ch);
    max-width: 74ch;
    margin: 0 auto;
    color: var(--color-text);
    font-size: clamp(1.06rem, 0.32vw + 1rem, 1.2rem);
    line-height: 1.85;
    letter-spacing: 0;
  }

  .blog-post-content :global(*) {
    max-width: 100%;
  }

  .blog-post-content :global(p) {
    margin: 0 0 1.35rem;
    color: var(--color-text);
    line-height: inherit;
    text-wrap: pretty;
  }

  .blog-post-content :global(h2),
  .blog-post-content :global(h3),
  .blog-post-content :global(h4) {
    color: var(--color-text-primary);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.12;
    text-wrap: balance;
    scroll-margin-top: 7rem;
  }

  .blog-post-content :global(h2) {
    margin: clamp(3rem, 7vw, 4.6rem) 0 1.15rem;
    font-size: clamp(1.75rem, 2.4vw, 2.45rem);
  }

  .blog-post-content :global(h3) {
    margin: 2.4rem 0 0.9rem;
    font-size: clamp(1.35rem, 1.6vw, 1.75rem);
  }

  .blog-post-content :global(h4) {
    margin: 2rem 0 0.75rem;
    font-size: 1.2rem;
  }

  .blog-post-content :global(a) {
    color: var(--color-accent);
    font-weight: 750;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .blog-post-content :global(a:hover) {
    color: color-mix(in srgb, var(--color-accent) 82%, white);
  }

  .blog-post-content :global(a:focus-visible) {
    border-radius: 0.2rem;
  }

  .blog-post-content :global(ul),
  .blog-post-content :global(ol) {
    display: grid;
    gap: 0.55rem;
    margin: 1.25rem 0 1.6rem;
    padding-left: 1.4rem;
  }

  .blog-post-content :global(li) {
    margin: 0;
    padding-left: 0.25rem;
    line-height: 1.75;
  }

  .blog-post-content :global(li::marker) {
    color: var(--color-accent);
    font-weight: 900;
  }

  .blog-post-content :global(blockquote) {
    margin: 2rem 0;
    border: 1px solid rgba(var(--color-accent-rgb), 0.24);
    border-radius: 0.75rem;
    background: rgba(var(--color-accent-rgb), 0.08);
    color: var(--color-text-primary);
    padding: 1.15rem 1.25rem;
    font-size: 1.05em;
    font-style: normal;
    line-height: 1.7;
  }

  .blog-post-content :global(blockquote p) {
    margin: 0;
    color: inherit;
  }

  .blog-post-content :global(strong),
  .blog-post-content :global(b) {
    color: var(--color-text-primary);
    font-weight: 850;
  }
  /* Inline-code chip styling lives in src/styles/global.css as the
     single source of truth, so blog and non-blog surfaces match. */

  .blog-post-content :global(pre) {
    margin: 2rem 0;
    border: 1px solid color-mix(in srgb, var(--color-card-border) 90%, transparent);
    border-radius: 8px;
    background: var(--color-darker);
    padding: 1.1rem;
    overflow-x: auto;
  }

  .blog-post-content :global(pre code) {
    background: transparent;
    color: var(--color-text-primary);
    padding: 0;
    white-space: pre;
  }

  .blog-post-content :global(table) {
    display: block;
    width: 100%;
    margin: 2rem 0;
    border: 1px solid var(--color-card-border);
    border-radius: 8px;
    border-spacing: 0;
    overflow-x: auto;
    background: rgba(var(--color-darker-rgb), 0.22);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .blog-post-content :global(th),
  .blog-post-content :global(td) {
    min-width: 9rem;
    border-bottom: 1px solid var(--color-card-border);
    padding: 0.78rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  .blog-post-content :global(th) {
    color: var(--color-text-primary);
    font-weight: 850;
    background: rgba(var(--color-accent-rgb), 0.09);
  }

  .blog-post-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  .blog-post-content :global(hr) {
    height: 1px;
    margin: 3rem 0;
    border: 0;
    background: var(--color-card-border);
  }

  .blog-post-footer {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-card-border) 78%, transparent);
    color: var(--color-text-secondary);
    font-size: 0.94rem;
  }

  .blog-post-footer > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .blog-post-after {
    width: min(100%, 1120px);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .newsletter-cta-card {
    margin-block: 3rem;
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid rgb(var(--border) / 0.5);
    background: linear-gradient(135deg, rgb(var(--surface)) 0%, color-mix(in srgb, rgb(var(--accent)) 4%, rgb(var(--surface)) 100%) 100%);
    transition: border-color 200ms ease;
  }

  .newsletter-cta-card:hover {
    border-color: rgb(var(--accent) / 0.4);
  }

  .newsletter-cta-card__content {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .newsletter-cta-card__icon {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: rgb(var(--accent));
    opacity: 0.8;
  }

  .newsletter-cta-card__heading {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    color: rgb(var(--text));
  }

  .newsletter-cta-card__text {
    font-size: 0.925rem;
    line-height: 1.55;
    margin: 0;
    color: rgb(var(--text) / 0.7);
  }

  @media (max-width: 720px) {
    .blog-post-page {
      padding-inline: 0.75rem;
    }

    .blog-post-title {
      max-width: 100%;
      font-size: clamp(2.3rem, 10vw, 2.9rem);
      line-height: 1.04;
    }

    .blog-post-header {
      text-align: left;
    }

    .blog-post-title,
    .blog-post-meta,
    .blog-post-tags {
      justify-content: flex-start;
      margin-inline: 0;
    }

    .blog-post-meta {
      align-items: flex-start;
      flex-direction: column;
    }

    .blog-post-content {
      font-size: 1.04rem;
      line-height: 1.78;
    }

    .blog-post-footer > div {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
