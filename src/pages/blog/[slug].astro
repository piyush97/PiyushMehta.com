---
import { getCollection, render } from 'astro:content';
import ArticleCareerCard from '../../components/ArticleCareerCard.astro';
import ArticleMeta from '../../components/ArticleMeta.astro';
import ArticleTableOfContents from '../../components/ArticleTableOfContents.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NextBestRead from '../../components/NextBestRead.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import PostReactions from '../../components/PostReactions.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import Layout from '../../layouts/Layout.astro';
import { generateCanonicalUrl } from '../../utils/og-generator';
import { selectBlogRecommendations, toBlogPostSlug } from '../../utils/blog-recommendations';
import { createSocialCardMetadata } from '../../utils/social-card';
import { getSocialCardManifest } from '../../utils/social-card-manifest';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const toPostSlug = (id: string) => id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');
  return posts.map((post) => ({
    params: { slug: toPostSlug(post.id) },
    props: { post },
    cacheKey: post.digest,
  }));
}

const { post } = Astro.props;
const currentSlug = Astro.params.slug ?? post.id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');
const postBody = post.body ?? '';
const { Content, headings } = await render(post);
const tableOfContentsHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);

const { title, description, date, updatedDate, author, tags, image, ogTemplate, ogTheme } = post.data;
const typedTags: string[] = tags ?? [];

const publishedPosts = await getCollection('blog', ({ data }) => !data.draft);
const [nextBestRecommendation] = selectBlogRecommendations(publishedPosts, {
  currentSlug,
  currentTags: typedTags,
  limit: 1,
});
const nextBest = nextBestRecommendation
  ? {
      slug: toBlogPostSlug(nextBestRecommendation.entry.id),
      title: nextBestRecommendation.entry.data.title,
      description: nextBestRecommendation.entry.data.description,
      date: nextBestRecommendation.entry.data.date,
      readingTime: Math.ceil((nextBestRecommendation.entry.body ?? '').trim().split(/\s+/).length / 200),
      matchingTags: nextBestRecommendation.matchingTags,
      similarity: nextBestRecommendation.similarity,
    }
  : undefined;

// Calculate reading time (rough estimate)
const readingTime = Math.ceil(postBody.split(' ').length / 200);
const displayDate = updatedDate || date;
const dateLabel = updatedDate ? 'Updated' : 'Published';
const formatArticleDate = (value: Date) =>
  value.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const baseUrl = import.meta.env.DEV ? Astro.url.origin : Astro.site?.toString() || 'https://piyushmehta.com';
const socialImage = createSocialCardMetadata({
  pathname: `/blog/${currentSlug}`,
  baseUrl,
  title,
  author: author || 'Piyush Mehta',
  manifest: await getSocialCardManifest(),
});

// Generate canonical URL
const canonicalUrl = generateCanonicalUrl(`/blog/${currentSlug}`, Astro.site?.toString() || 'https://piyushmehta.com');

// Create structured data for the article
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description || `${title} - A blog post by ${author || 'Piyush Mehta'}`,
  author: {
    '@type': 'Person',
    name: author || 'Piyush Mehta',
    url: 'https://piyushmehta.com',
  },
  datePublished: date.toISOString(),
  dateModified: (updatedDate || date).toISOString(),
  url: canonicalUrl,
  keywords: typedTags.join(', '),
  wordCount: postBody.split(' ').length,
  timeRequired: `PT${readingTime}M`,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Person',
    name: 'Piyush Mehta',
    url: 'https://piyushmehta.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  image: {
    '@type': 'ImageObject',
    url: socialImage.url,
    description: socialImage.alt,
    width: socialImage.width,
    height: socialImage.height,
  },
};
---

<Layout
  title={title}
  description={description ||
    `${title} - A blog post by ${author || 'Piyush Mehta'}`}
  type="article"
  author={author}
  publishedTime={date}
  modifiedTime={updatedDate || date}
  tags={typedTags}
  canonical={canonicalUrl}
  image={socialImage}
  schema={articleSchema}
  ogTemplate={ogTemplate}
  ogTheme={ogTheme}
  preloadImage={image?.url}
>
  <div class="page-container blog-post-page">
    <div class="blog-post-shell">
      <!-- Breadcrumbs -->
      <div class="blog-post-breadcrumbs">
        <Breadcrumbs title={title} url={canonicalUrl} />
      </div>

      <article class="blog-post-article" itemscope itemtype="https://schema.org/Article" data-pagefind-body>
        <!-- Post Header -->
        <header class="blog-post-header article-masthead" data-article-masthead>
          <div class="article-masthead__folio" aria-hidden="true" data-pagefind-ignore>
            <span>Field note</span>
            <span>{formatArticleDate(displayDate)}</span>
          </div>
          <div class="article-masthead__content">
            <h1
              class="blog-post-title"
              itemprop="headline"
              data-pagefind-meta="title"
            >
              {title}
            </h1>

            <!-- Hidden metadata for Pagefind -->
            <div data-pagefind-meta="description" class="hidden">{description}</div>
            <div data-pagefind-meta="author" class="hidden">{author || 'Piyush Mehta'}</div>
            <div data-pagefind-meta="date" class="hidden">{date.toISOString()}</div>
            <div data-pagefind-meta="type" class="hidden">blog</div>
            {typedTags.map((tag) => <div data-pagefind-meta="tag" class="hidden">{tag}</div>)}

            <ArticleMeta title={title} author={author} readingTime={readingTime} date={date} tags={typedTags} url={canonicalUrl} />
          </div>

          <section
            class="article-orientation"
            aria-labelledby="article-orientation-title"
            data-article-orientation
            data-pagefind-ignore
          >
            <div class="article-orientation__summary">
              <p class="article-orientation__title" id="article-orientation-title">In this note</p>
              {description && <p class="article-orientation__description" data-orientation-description>{description}</p>}
            </div>
            <dl class="article-orientation__facts">
              <div>
                <dt>Reading time</dt>
                <dd data-orientation-reading-time>{readingTime} min read</dd>
              </div>
              <div>
                <dt>Sections</dt>
                <dd data-orientation-section-count>{tableOfContentsHeadings.length} {tableOfContentsHeadings.length === 1 ? 'section' : 'sections'}</dd>
              </div>
            </dl>
          </section>
        </header>

        <!-- Featured Image -->
        {
          image && image.url && (
            <figure class="blog-post-hero-image">
              <OptimizedImage
                src={image.url}
                alt={image.alt || title}
                class="w-full h-auto"
                priority={true}
                quality={90}
                sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 70vw"
              />
              {image.alt && (
                <figcaption>
                  {image.alt}
                </figcaption>
              )}
            </figure>
          )
        }

        <!-- Post Content -->
        <div class:list={['article-reading-layout', { 'article-reading-layout--with-toc': tableOfContentsHeadings.length > 0 }]}>
          {tableOfContentsHeadings.length > 0 && <ArticleTableOfContents headings={tableOfContentsHeadings} />}
          <div class="blog-post-content prose mdx-content" itemprop="articleBody">
            <Content />
          </div>
        </div>

        <!-- Post Footer -->
        <footer class="blog-post-footer">
          <div>
            <a
              href="/blog/"
              class="blog-post-back__link"
            >
              <svg
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
              Back to Blog
            </a>

            <div class="article-date-record">
              <meta itemprop="dateModified" content={displayDate.toISOString()} />
              <span>{dateLabel}</span>
              <time datetime={displayDate.toISOString()}>{formatArticleDate(displayDate)}</time>
            </div>
          </div>
        </footer>
      </article>

      <div class="blog-post-after" aria-labelledby="article-continuation-title">
        <header class="article-continuation__header" data-pagefind-ignore>
          <h2 id="article-continuation-title">After this note</h2>
          <a href="/blog/" class="article-continuation__all">
            Browse all writing
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </header>

        {nextBest && <NextBestRead nextRead={nextBest} />}

        <!-- Post Reactions -->
        <PostReactions 
          postId={currentSlug}
          title="Was this post helpful?"
          showCount={true}
          size="sm"
          compact={true}
          orientation="horizontal"
        />

        <ArticleCareerCard />

        <!-- Related Posts -->
        <RelatedPosts 
          currentSlug={currentSlug}
          currentTags={typedTags}
          maxPosts={3}
          excludeSlugs={nextBest ? [nextBest.slug] : []}
        />


      </div>
    </div>
  </div>
</Layout>

<style>
  .blog-post-page {
    padding: clamp(2.75rem, 6vw, 5.5rem) 1rem clamp(4rem, 7vw, 6rem);
  }

  .blog-post-shell {
    width: min(100%, 1120px);
    margin-inline: auto;
  }

  .blog-post-breadcrumbs,
  .blog-post-back,
  .blog-post-share,
  .blog-post-footer,
  .blog-post-after {
    width: min(100%, 48rem);
    margin-inline: auto;
  }

  .blog-post-article {
    color: var(--color-text);
  }

  .blog-post-back {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .blog-post-back__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    text-underline-offset: 0.18em;
    transition:
      color 160ms ease,
      opacity 160ms ease;
  }

  .blog-post-back__link:hover {
    opacity: 0.82;
    text-decoration: underline;
  }

  .blog-post-back__link svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .blog-post-header {
    width: min(100%, 48rem);
    margin: 0 auto 2rem;
    padding-bottom: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-card-border) 76%, transparent);
    text-align: left;
  }

  .article-masthead {
    display: grid;
    grid-template-columns: minmax(7rem, 0.2fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .article-masthead__folio {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.45rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .article-masthead__folio span:last-child {
    color: var(--color-text-muted);
  }

  .article-masthead__content {
    min-width: 0;
  }

  .blog-post-title {
    text-align: left;
    max-width: 26ch;
    margin: 0 0 1.5rem;
    color: var(--color-text-primary);
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .article-orientation {
    margin-top: 1.5rem;
    padding: 1rem 0 0;
    border: 0;
    border-top: 1px solid var(--color-card-border);
    border-radius: 0;
    background: transparent;
  }

  .article-orientation__title {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-orientation__description {
    max-width: 68ch;
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.65;
  }

  .article-orientation__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 1rem 0 0;
  }

  .article-orientation__facts div {
    display: grid;
    gap: 0.25rem;
  }

  .article-orientation__facts dt {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-orientation__facts dd {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
  }

  .blog-post-hero-image {
    width: min(100%, 960px);
    margin: 0 auto clamp(2rem, 5vw, 3.5rem);
  }

  .blog-post-hero-image :global(img) {
    display: block;
    border: 1px solid color-mix(in srgb, var(--color-card-border) 84%, transparent);
    border-radius: 8px;
    background: var(--color-darker);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
  }

  .blog-post-hero-image figcaption {
    max-width: 74ch;
    margin: 0.75rem auto 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
    text-align: center;
  }

  .blog-post-share {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .article-reading-layout {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .article-reading-layout--with-toc {
      display: grid;
      grid-template-columns: minmax(0, 74ch) minmax(13rem, 16rem);
      justify-content: center;
      align-items: start;
      gap: 2.5rem;
    }

    .article-reading-layout--with-toc :global(.article-toc-root) {
      grid-column: 2;
      grid-row: 1;
      align-self: stretch;
    }

    .article-reading-layout--with-toc .blog-post-content {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .blog-post-content {
    width: min(100%, 74ch);
    max-width: 74ch;
    margin: 0 auto;
    color: var(--color-text);
    font-size: clamp(1.06rem, 0.32vw + 1rem, 1.2rem);
    line-height: 1.85;
    letter-spacing: 0;
  }

  .blog-post-content :global(*) {
    max-width: 100%;
  }

  .blog-post-content :global(p) {
    margin: 0 0 1.35rem;
    color: var(--color-text);
    line-height: inherit;
    text-wrap: pretty;
  }

  .blog-post-content :global(h2),
  .blog-post-content :global(h3),
  .blog-post-content :global(h4) {
    color: var(--color-text-primary);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.12;
    text-wrap: balance;
    scroll-margin-top: 7rem;
  }

  .blog-post-content :global(h2) {
    margin: clamp(3rem, 7vw, 4.6rem) 0 1.15rem;
    font-size: clamp(1.75rem, 2.4vw, 2.45rem);
  }

  .blog-post-content :global(h3) {
    margin: 2.4rem 0 0.9rem;
    font-size: clamp(1.35rem, 1.6vw, 1.75rem);
  }

  .blog-post-content :global(h4) {
    margin: 2rem 0 0.75rem;
    font-size: 1.2rem;
  }

  .blog-post-content :global(a) {
    color: var(--color-accent);
    font-weight: 750;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .blog-post-content :global(a:hover) {
    color: color-mix(in srgb, var(--color-accent) 82%, white);
  }

  .blog-post-content :global(a:focus-visible) {
    border-radius: 0.2rem;
  }

  .blog-post-content :global(ul),
  .blog-post-content :global(ol) {
    display: grid;
    gap: 0.55rem;
    margin: 1.25rem 0 1.6rem;
    padding-left: 1.4rem;
  }

  .blog-post-content :global(li) {
    margin: 0;
    padding-left: 0.25rem;
    line-height: 1.75;
  }

  .blog-post-content :global(li::marker) {
    color: var(--color-accent);
    font-weight: 900;
  }

  .blog-post-content :global(blockquote) {
    margin: 2rem 0;
    border: 1px solid rgba(var(--color-accent-rgb), 0.24);
    border-radius: 0.75rem;
    background: rgba(var(--color-accent-rgb), 0.08);
    color: var(--color-text-primary);
    padding: 1.15rem 1.25rem;
    font-size: 1.05em;
    font-style: normal;
    line-height: 1.7;
  }

  .blog-post-content :global(blockquote p) {
    margin: 0;
    color: inherit;
  }

  .blog-post-content :global(strong),
  .blog-post-content :global(b) {
    color: var(--color-text-primary);
    font-weight: 850;
  }
  /* Inline-code chip styling lives in src/styles/global.css as the
     single source of truth, so blog and non-blog surfaces match. */

  .blog-post-content :global(pre) {
    margin: 2rem 0;
    border: 1px solid color-mix(in srgb, var(--color-card-border) 90%, transparent);
    border-radius: 8px;
    background: var(--color-darker);
    padding: 1.1rem;
    overflow-x: auto;
  }

  .blog-post-content :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    white-space: pre;
  }

  .blog-post-content :global(pre code span[style*='#768390']) {
    color: #a8b2c0 !important;
  }

  .blog-post-content :global(table) {
    display: block;
    width: 100%;
    margin: 2rem 0;
    border: 1px solid var(--color-card-border);
    border-radius: 8px;
    border-spacing: 0;
    overflow-x: auto;
    background: rgba(var(--color-darker-rgb), 0.22);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .blog-post-content :global(th),
  .blog-post-content :global(td) {
    min-width: 9rem;
    border-bottom: 1px solid var(--color-card-border);
    padding: 0.78rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  .blog-post-content :global(th) {
    color: var(--color-text-primary);
    font-weight: 850;
    background: rgba(var(--color-accent-rgb), 0.09);
  }

  .blog-post-content :global(tr:last-child td) {
    border-bottom: 0;
  }

  .blog-post-content :global(hr) {
    height: 1px;
    margin: 3rem 0;
    border: 0;
    background: var(--color-card-border);
  }

  .blog-post-footer {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-card-border) 78%, transparent);
    color: var(--color-text-secondary);
    font-size: 0.94rem;
  }

  .article-date-record {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .article-date-record span {
    color: var(--color-accent);
    font-weight: 800;
  }

  .blog-post-footer > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .blog-post-after {
    width: min(100%, 1120px);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  @media (max-width: 720px) {
    .article-masthead {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .article-masthead__folio {
      flex-direction: row;
      justify-content: space-between;
      padding-top: 0;
    }

    .blog-post-page {
      padding-inline: 0.75rem;
    }

    .blog-post-title {
      max-width: 100%;
      font-size: clamp(2.3rem, 10vw, 2.9rem);
      line-height: 1.04;
    }

    .blog-post-header {
      text-align: left;
    }

    .blog-post-title,
    .blog-post-meta,
    .blog-post-tags {
      justify-content: flex-start;
      margin-inline: 0;
    }

    .blog-post-meta {
      align-items: flex-start;
      flex-direction: column;
    }

    .blog-post-content {
      font-size: 1.04rem;
      line-height: 1.78;
    }

    .blog-post-footer > div {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  /* Rendered article: margin-ruled ledger */
  .blog-post-page {
    padding: clamp(2.25rem, 5vw, 4.5rem) clamp(1rem, 4vw, 3rem) clamp(4rem, 8vw, 7rem);
  }

  .blog-post-shell {
    width: min(100%, 1200px);
  }

  .blog-post-breadcrumbs {
    width: 100%;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .blog-post-breadcrumbs :global(nav) {
    margin-bottom: 0;
  }

  .blog-post-breadcrumbs :global(ol) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
  }

  .blog-post-breadcrumbs :global(a) {
    color: var(--color-text-secondary);
  }

  .blog-post-breadcrumbs :global([aria-current='page']) {
    color: var(--color-text-primary);
  }

  .blog-post-header {
    width: 100%;
    display: grid;
    grid-template-areas:
      'folio content'
      'orientation orientation';
    grid-template-columns: minmax(9rem, 0.24fr) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .article-masthead__folio {
    grid-area: folio;
    align-self: start;
    gap: 0.65rem;
    padding-top: 0.85rem;
    border-top: 2px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  .article-masthead__folio span:last-child {
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .article-masthead__content {
    grid-area: content;
  }

  .blog-post-title {
    max-width: 24ch;
    margin-bottom: 1.35rem;
    font-size: clamp(2.6rem, 5.4vw, 4.8rem);
