---
import {
  portfolioMetrics,
  resumeAchievements,
  resumeEducation,
  resumeQuickFacts,
  resumeRoles,
  resumeSkillGroups,
} from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="Resume - Piyush Mehta"
  description="Resume of Piyush Mehta, senior software engineer focused on enterprise AI workflows, web platforms, system design, and developer education."
  type="website"
  ogTemplate="professional"
  ogTheme="dark"
>
  <section class="resume-hero">
    <div class="resume-hero__copy">
      <p class="eyebrow" data-hero-eyebrow>Resume</p>
      <h1 data-hero-title>Senior software engineer for AI workflows, web platforms, and durable systems.</h1>
      <p class="lede">
        This page is written for engineering leaders doing a quick diligence pass. It keeps the
        signal high: scope, outcomes, stack judgment, and the kinds of systems I like owning.
      </p>
      <div class="resume-actions">
        <a class="btn-primary" href="/projects/">Review case studies</a>
        <a class="btn-secondary" href="/contact-me/">Start a conversation</a>
        <button class="btn-ghost" id="resume-download-pdf" aria-label="Download resume as PDF">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download PDF
        </button>
      </div>
    </div>

    <aside class="resume-summary" aria-label="Resume quick facts">
      <dl>
        {resumeQuickFacts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </section>

  <section class="metrics-band" aria-label="Selected impact">
    {portfolioMetrics.map((metric) => (
      <article>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
        <p>{metric.detail}</p>
      </article>
    ))}
  </section>

  <section class="resume-section">
    <div class="section-heading">
      <p class="eyebrow">Experience</p>
      <h2>Roles with outcomes attached.</h2>
      <p>Work history trimmed toward delivery signal, not keyword density.</p>
    </div>

    <div class="timeline">
      {resumeRoles.map((role) => (
        <article class="timeline-card">
          <div class="timeline-card__meta">
            <span>{role.timeframe}</span>
            <p>{role.location}</p>
          </div>
          <div class="timeline-card__body">
            <h3>{role.title}</h3>
            <p class="timeline-card__company">{role.company}</p>
            <p class="timeline-card__summary">{role.summary}</p>
            <ul>
              {role.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="resume-section split-grid">
    <div>
      <div class="section-heading">
        <p class="eyebrow">Skills</p>
        <h2>Tools I actually use to ship.</h2>
      </div>
      <div class="skills-grid">
        {resumeSkillGroups.map((group) => (
          <article class="info-card">
            <h3>{group.title}</h3>
            <p>{group.items.join(' · ')}</p>
          </article>
        ))}
      </div>
    </div>

    <div>
      <div class="section-heading">
        <p class="eyebrow">Education</p>
        <h2>Formal training, kept compact.</h2>
      </div>
      <div class="stack-list">
        {resumeEducation.map((item) => (
          <article class="info-card">
            <h3>{item.degree}</h3>
            <p>{item.school}</p>
            <span>{item.location} · {item.timeframe}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="resume-section">
    <div class="section-heading">
      <p class="eyebrow">Recognition</p>
      <h2>Signals beyond job titles.</h2>
    </div>
    <div class="achievement-grid">
      {resumeAchievements.map((item) => (
        <article class="info-card">
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="resume-cta">
    <p class="eyebrow">Best next step</p>
    <h2>If you need technical judgment, product delivery, or AI workflow help, let’s talk.</h2>
    <div class="resume-actions">
      <a class="btn-primary" href="/contact-me/">Contact Piyush</a>
      <a class="btn-secondary" href="/blog/">Read technical writing</a>
      <button class="btn-ghost" onclick="window.print()" aria-label="Download resume as PDF">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download PDF
      </button>
    </div>
  </section>
</Layout>

<script is:inline>
  document.getElementById('resume-download-pdf')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  .resume-hero,
  .resume-section,
  .metrics-band,
  .resume-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .resume-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(4rem, 8vw, 6rem) 3rem;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .resume-hero h1,
  .section-heading h2,
  .resume-cta h2 {
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .resume-hero h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 7vw, 5.25rem);
  }

  .lede,
  .section-heading p,
  .timeline-card__summary,
  .info-card p,
  .resume-cta p + h2 {
    color: var(--color-text-secondary);
  }

  .lede {
    max-width: 44rem;
    margin: 1.35rem 0 0;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .resume-summary {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    padding: 1.25rem;
  }

  .resume-summary dl {
    margin: 0;
  }

  .resume-summary div + div {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-card-border);
  }

  .resume-summary dt {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resume-summary dd {
    margin: 0.35rem 0 0;
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .metrics-band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-card-border);
    background: var(--color-card-border);
  }

  .metrics-band article {
    min-height: 13.5rem;
    padding: 1.5rem;
    background: var(--color-surface-raised);
  }

  .metrics-band strong {
    display: block;
    color: var(--color-text-primary);
    font-size: 2.4rem;
    line-height: 1;
  }

  .metrics-band span {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-accent);
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .metrics-band p {
    margin: 0.85rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .resume-section {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .section-heading {
    max-width: 44rem;
    margin-bottom: 1.75rem;
  }

  .section-heading h2,
  .resume-cta h2 {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
  }

  .section-heading p {
    margin: 0.9rem 0 0;
    line-height: 1.7;
  }

  .timeline {
    display: grid;
    gap: 1rem;
  }

  .timeline-card,
  .info-card {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
  }

  .timeline-card {
    display: grid;
    grid-template-columns: minmax(170px, 220px) minmax(0, 1fr);
  }

  .timeline-card__meta,
  .timeline-card__body {
    padding: 1.35rem;
  }

  .timeline-card__meta {
    border-right: 1px solid var(--color-card-border);
  }

  .timeline-card__meta span {
    display: block;
    color: var(--color-accent);
    font-weight: 800;
  }

  .timeline-card__meta p,
  .info-card span {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .timeline-card__body h3,
  .info-card h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1.2rem;
  }

  .timeline-card__company {
    margin: 0.45rem 0 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .timeline-card__summary {
    margin: 0.9rem 0 0;
    line-height: 1.7;
  }

  .timeline-card ul {
    margin: 1rem 0 0;
    padding-left: 1.2rem;
    color: var(--color-text-secondary);
  }

  .timeline-card li + li {
    margin-top: 0.55rem;
  }

  .split-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .skills-grid,
  .achievement-grid,
  .stack-list {
    display: grid;
    gap: 1rem;
  }

  .skills-grid,
  .achievement-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .info-card {
    padding: 1.2rem;
  }

  .info-card p {
    margin: 0.7rem 0 0;
    line-height: 1.7;
  }

  .resume-cta {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .resume-cta h2 {
    max-width: 18ch;
    margin-top: 0.2rem;
  }

  @media (max-width: 960px) {
    .resume-hero,
    .split-grid,
    .timeline-card {
      grid-template-columns: 1fr;
    }

    .timeline-card__meta {
      border-right: 0;
      border-bottom: 1px solid var(--color-card-border);
    }

    .metrics-band,
    .skills-grid,
    .achievement-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .metrics-band,
    .skills-grid,
    .achievement-grid {
      grid-template-columns: 1fr;
    }
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.35rem;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    border-radius: 0.35rem;
    transition: color var(--motion-fast, 150ms) ease, border-color var(--motion-fast, 150ms) ease;
  }

  .btn-ghost:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media print {
    nav,
    footer,
    .resume-cta,
    #resume-download-pdf,
    .metrics-band {
      display: none !important;
    }
    .resume-hero h1 {
      font-size: 24pt;
    }
    .resume-hero {
      padding-block: 0.5in;
    }
    body {
      color: #000;
      background: #fff;
    }
    .resume-summary,
    .timeline-card,
    .info-card {
      border: 1px solid #ccc;
      break-inside: avoid;
    }
    .resume-section {
      padding-block: 0.3in;
    }
    .timeline-card {
      break-inside: avoid;
    }
    a {
      color: #000;
      text-decoration: underline;
    }
  }
</style>
