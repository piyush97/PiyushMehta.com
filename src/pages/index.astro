---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { caseStudies, resumeQuickFacts, socialLinks } from '../data/portfolio';
import speakerPhoto from '../images/piyush-devfest.jpg';
import speakerPhotoAvif320 from '../images/responsive/piyush-devfest-320.avif';
import speakerPhotoAvif640 from '../images/responsive/piyush-devfest-640.avif';
import speakerPhotoAvif960 from '../images/responsive/piyush-devfest-960.avif';
import speakerPhotoAvif1280 from '../images/responsive/piyush-devfest-1280.avif';
import speakerPhotoWebp320 from '../images/responsive/piyush-devfest-320.webp';
import speakerPhotoWebp640 from '../images/responsive/piyush-devfest-640.webp';
import speakerPhotoWebp960 from '../images/responsive/piyush-devfest-960.webp';
import speakerPhotoWebp1280 from '../images/responsive/piyush-devfest-1280.webp';
import speakerPhotoJpg320 from '../images/responsive/piyush-devfest-320.jpg';
import speakerPhotoJpg640 from '../images/responsive/piyush-devfest-640.jpg';
import speakerPhotoJpg960 from '../images/responsive/piyush-devfest-960.jpg';
import talk1 from '../images/talk1.png';
import talk2 from '../images/talk2.jpeg';
import talk3 from '../images/talk3.jpeg';
import talk4 from '../images/talk4.jpeg';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const speakerAlt = 'Piyush Mehta speaking on stage at a developer conference';
const heroSizes = '(max-width: 900px) calc(100vw - 2rem), 42vw';

// Reel frames: the speaker photo first (LCP), then real screenshots and photos from published posts.
const reelFrames = [
  {
    src: '/blog/understory-engineering-blogs-explained/images/explainer.png',
    width: 1440,
    height: 900,
    alt: 'An Understory explainer page with a large headline, a dek, the source publisher, and a TL;DR card beside a sheet record',
  },
  {
    src: '/blog/zfs-saved-my-data-seagate-warranty/images/zfs-drive-failure-hero.webp',
    width: 1600,
    height: 900,
    alt: 'Four-bay homelab storage enclosure and hard drives during a ZFS mirror recovery',
  },
  {
    src: '/blog/zfs-saved-my-data-seagate-warranty/images/zfs-mirror-resilver.webp',
    width: 1536,
    height: 1024,
    alt: 'Sealed hard drives with blue and green data blocks illustrating a ZFS mirror resilver',
  },
];

const heroLede =
  'I build durable product systems at the seam between ambitious ideas and operational reality.';
const baseLocation = resumeQuickFacts.find((fact) => fact.label === 'Based in')?.value;

// Work panels: case studies from portfolio data. Media is real: published screenshots, post covers and talk artwork.
// Enterprise AI Workflows has no shareable image, so its panel is a full type field with the case-study facts.
const panelTitles = [
  'Understory',
  'FocusTube',
  'RoastTube',
  'Enterprise AI Workflows',
  'Developer Education and Talks',
];
type PanelImage = { src: string; width: number; height: number; alt: string; crop?: boolean };
const panelImages: Record<string, PanelImage[]> = {
  Understory: [
    {
      src: '/blog/understory-engineering-blogs-explained/images/home.png',
      width: 1440,
      height: 900,
      crop: true,
      alt: 'The Understory index: a drawing-sheet layout headed "Engineering blogs, explained." with topic filters and a lead explainer',
    },
  ],
  FocusTube: [
    {
      src: '/blog/building-focustube-typesafe-jev/images/cover.svg',
      width: 1200,
      height: 630,
      alt: 'Diagram titled "Building FocusTube": YouTube metadata passes through Jev to a typed answer, probability 0.91',
    },
  ],
  RoastTube: [
    {
      src: '/blog/roasttube-ai-roast-youtube-history/images/cover.svg',
      width: 1200,
      height: 630,
      alt: 'RoastTube field note with a sample verdict: a brain rot score of 42 out of 100, computed from read-only Google OAuth signals',
    },
  ],
};
const panelPosters: Record<string, { src: ImageMetadata; alt: string }[]> = {
  'Developer Education and Talks': [
    {
      src: talk1,
      alt: 'Slide titled "Intro to Containers, Docker & K8s" by Piyush Mehta, Google DSC Lead, beside a stack of Docker whales',
    },
    {
      src: talk4,
      alt: 'Poster for a webinar, "DS & Algo Masterclass", with Piyush Mehta, Programming Instructor at YouTube and Ex-Google',
    },
  ],
};
// Big figure for a type-only panel, lifted from the outcome text itself.
const figureOf = (text: string) => text.match(/\d[\d,.]*\+?%?/)?.[0];
const caseHref = (title: string) => {
  const index = caseStudies.findIndex((study) => study.title === title);
  return index >= 0 ? `/projects#case-${index + 1}` : '/projects';
};
const panels = panelTitles.flatMap((title) => {
  const study = caseStudies.find((item) => item.title === title);
  return study
    ? [{ study, href: caseHref(title), images: panelImages[title] ?? [], posters: panelPosters[title] ?? [] }]
    : [];
});

// Writing list: latest published posts, newest first.
const toPostHref = (id: string) =>
  `/blog/${id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, '')}`;
const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 7)
  .map((post) => ({
    title: post.data.title,
    href: toPostHref(post.id),
    date: post.data.date,
    image: post.data.image,
  }));
const dateFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const covers = posts.flatMap((post, index) =>
  post.image
    ? [
        {
          index,
          src: post.image.url,
          width: post.image.width ?? 1200,
          height: post.image.height ?? 630,
          alt: post.image.alt || post.title,
        },
      ]
    : [],
);
const coverIndexByPost = new Map(covers.map((cover, order) => [cover.index, order]));

// On stage: real talk artwork and the speaker photo. Captions are omitted, the artwork carries its own text.
const talkStudy = caseStudies.find((study) => study.title === 'Developer Education and Talks');
const workshopLink = talkStudy?.links?.find((link) => link.label === 'Workshops');
const stagePortraits = [
  {
    src: talk2,
    alt: 'Poster for a free Masai SVCE Campus Chapter webinar, "Career Opportunities in Tech", with Piyush Mehta, Full Stack Developer at Nuclei',
  },
  {
    src: talk3,
    alt: 'Poster for a free webinar, "Introduction to Programming: Complete Roadmap", with Piyush Mehta, Full Stack Developer at Nuclei, Ex Google',
  },
  { src: speakerPhoto, alt: speakerAlt },
];
---

<Layout
  title="Piyush Mehta — Senior Software Engineer"
  description="Piyush Mehta, senior software engineer in Canada, builds reliable web platforms and AI workflows with TypeScript, React, Node.js, and cloud infrastructure."
  keywords={[
    'Piyush Mehta',
    'Senior Software Engineer',
    'TypeScript',
    'React',
    'Node.js',
    'Astro',
    'Software Architecture',
    'AI Workflows',
  ]}
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
  preloadImage={speakerPhotoAvif1280.src}
  preloadImageSrcset={`${speakerPhotoAvif320.src} 320w, ${speakerPhotoAvif640.src} 640w, ${speakerPhotoAvif960.src} 960w, ${speakerPhotoAvif1280.src} 1280w`}
  preloadImageSizes={heroSizes}
>
  <div class="home" data-home-root data-home-ledger>
    <section class="hero" data-hero data-home-section="hero" aria-label="Introduction">
      <div class="hero-stage">
        <h1 class="hero-title" data-hero-title>
          <span class="half half-a" data-reveal>Piyush Mehta</span>{' '}
          <span class="half half-b" data-reveal data-reveal-delay="60">ships AI tools.</span>
        </h1>

        <div class="reel" data-reel>
          <div class="reel-track" data-reel-track>
            <figure class="frame is-current">
              <picture>
                <source
                  type="image/avif"
                  srcset={`${speakerPhotoAvif320.src} 320w, ${speakerPhotoAvif640.src} 640w, ${speakerPhotoAvif960.src} 960w, ${speakerPhotoAvif1280.src} 1280w`}
                  sizes={heroSizes}
                />
                <source
                  type="image/webp"
                  srcset={`${speakerPhotoWebp320.src} 320w, ${speakerPhotoWebp640.src} 640w, ${speakerPhotoWebp960.src} 960w, ${speakerPhotoWebp1280.src} 1280w`}
                  sizes={heroSizes}
                />
                <img
                  src={speakerPhoto.src}
                  srcset={`${speakerPhotoJpg320.src} 320w, ${speakerPhotoJpg640.src} 640w, ${speakerPhotoJpg960.src} 960w, ${speakerPhoto.src} 1280w`}
                  sizes={heroSizes}
                  width={speakerPhoto.width}
                  height={speakerPhoto.height}
                  alt={speakerAlt}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
            </figure>
            {
              reelFrames.map((frame) => (
                <figure class="frame">
                  <img
                    src={frame.src}
                    width={frame.width}
                    height={frame.height}
                    alt={frame.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
        </div>

        <div class="hero-intro" data-reveal data-reveal-delay="100">
          <p class="hero-lede">{heroLede}</p>
          <form class="hero-ask" method="get" action="/ask" data-home-ask>
            <label class="sr-only" for="home-ask-q">Ask Piyush a question about his work</label>
            <input
              id="home-ask-q"
              name="q"
              type="text"
              autocomplete="off"
              placeholder="Ask about my projects or writing"
            />
            <button type="submit" class="action">Ask Piyush</button>
          </form>
          {baseLocation && <p class="hero-where">Based in {baseLocation}</p>}
        </div>
      </div>
    </section>

    <section class="work" data-home-section="work" aria-label="Selected work">
      {
        panels.map(({ study, href, images, posters }, index) => {
          const hasMedia = images.length > 0 || posters.length > 0;
          return (
            <article class:list={['panel', hasMedia ? 'panel--media' : 'panel--type', index % 2 === 1 && 'panel--alt']}>
              <h2 class="panel-title">
                <a class="panel-link" href={href}>
                  {study.title}
                </a>
              </h2>
              <div class="panel-text">
                <p class="panel-summary">{study.summary}</p>
                <p class="panel-stack">{study.stack.join(', ')}</p>
                {!hasMedia && (
                  <ul class="panel-approach">
                    {study.approach.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ul>
                )}
                {study.links && study.links.length > 0 && (
                  <ul class="panel-links">
                    {study.links.map((link) => (
                      <li>
                        <a href={link.href} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="panel-meta">
                  {study.timeframe}, {study.role}
                </p>
              </div>
              <div class:list={['panel-media', posters.length > 1 && 'panel-media--pair']} data-reveal>
                {images.map((image) => (
                  <img
                    class:list={['panel-shot', image.crop && 'panel-shot--crop']}
                    src={image.src}
                    width={image.width}
                    height={image.height}
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                ))}
                {posters.map((poster) => (
                  <Image
                    class="panel-shot"
                    src={poster.src}
                    alt={poster.alt}
                    widths={[480, 720, 960]}
                    sizes="(max-width: 900px) 92vw, 46vw"
                    loading="lazy"
                  />
                ))}
                <ul class:list={['panel-outcomes', !hasMedia && 'panel-outcomes--lead']}>
                  {study.outcomes.map((outcome) => (
                    <li>
                    {!hasMedia && figureOf(outcome) && (
                      <span class="panel-figure" aria-hidden="true">
                        {figureOf(outcome)}
                      </span>
                    )}
                    {outcome}
                  </li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </section>

    <section class="writing" data-writing data-home-section="writing" aria-labelledby="home-writing">
      <div class="writing-photo" aria-hidden="true">
        <div class="writing-frame">
          {
            covers.map((cover, order) => (
              <img
                class:list={['cover', order === 0 && 'is-active']}
                data-cover-img={order}
                src={cover.src}
                width={cover.width}
                height={cover.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
      </div>
      <div class="writing-list">
        <h2 id="home-writing" class="writing-heading">Recent writing</h2>
        <ul class="rows">
          {
            posts.map((post, index) => (
              <li>
                <article
                  class:list={['row', index === 0 && 'is-active']}
                  data-row
                  data-cover={coverIndexByPost.get(index) ?? ''}
                  data-reveal
                  data-reveal-delay={Math.min(index * 20, 100)}
                >
                  <h3 class="row-title" data-vt-title={`post-title-${post.href.replace('/blog/', '')}`}>
                    <a class="row-link" href={post.href}>
                      {post.title}
                    </a>
                  </h3>
                  <time class="row-date" datetime={post.date.toISOString()}>
                    {dateFormat.format(post.date)}
                  </time>
                </article>
              </li>
            ))
          }
        </ul>
        <p class="writing-all">
          <a href="/blog">All writing</a>
        </p>
      </div>
    </section>

    <section class="onstage" data-home-section="stage" aria-labelledby="home-onstage">
      <div class="onstage-pin">
        <h2 id="home-onstage">On stage</h2>
      </div>
      <ul class="onstage-roll">
        {
          stagePortraits.map((portrait) => (
            <li class="portrait" data-reveal>
              <Image
                class="portrait-img"
                src={portrait.src}
                alt={portrait.alt}
                widths={[400, 640, 960]}
                sizes="(max-width: 900px) 72vw, 28vw"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>
      {
        talkStudy && (
          <div class="onstage-note" data-reveal>
            <p>{talkStudy.summary}</p>
            {workshopLink && (
              <p>
                <a href={workshopLink.href} rel="noopener noreferrer">
                  Workshops
                </a>
              </p>
            )}
          </div>
        )
      }
    </section>

    <section class="contact" data-home-section="contact" aria-label="Contact">
      <p class="contact-line">Good systems begin with a precise conversation.</p>
      <p class="contact-display" data-reveal>
        <a href="/contact-me">Start a <span class="contact-break">conversation</span></a>
      </p>
      <div class="contact-foot">
        {baseLocation && <p>{baseLocation}</p>}
        <ul class="contact-social">
          {
            socialLinks.map((link) => (
              <li>
                <a href={link.href} rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { navigate } from 'astro:transitions/client';

  let teardown: (() => void) | undefined;

  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

  function initHome(): void {
    teardown?.();
    teardown = undefined;
    const root = document.querySelector<HTMLElement>('[data-home-root]');
    if (!root) return;
    root.classList.add('is-live');
    const cleanups: Array<() => void> = [];
    const listen = <T extends EventTarget>(
      target: T,
      type: string,
      handler: EventListenerOrEventListenerObject,
      options?: AddEventListenerOptions,
    ) => {
      target.addEventListener(type, handler, options);
      cleanups.push(() => target.removeEventListener(type, handler, options));
    };
    const frameLoop = (update: () => void) => {
      let raf = 0;
      const schedule = () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
      };
      listen(window, 'scroll', schedule, { passive: true });
      listen(window, 'resize', schedule);
      cleanups.push(() => cancelAnimationFrame(raf));
      update();
    };

    // Hero: the pinned stage advances the reel one frame per slice of scroll. Scroll itself is never intercepted.
    const hero = root.querySelector<HTMLElement>('[data-hero]');
    const stage = hero?.querySelector<HTMLElement>('.hero-stage');
    const track = hero?.querySelector<HTMLElement>('[data-reel-track]');
    const frames = track ? Array.from(track.querySelectorAll<HTMLElement>('.frame')) : [];
    if (hero && stage && track && frames.length > 1) {
      let current = 0;
      frameLoop(() => {
        const stuckTop = parseFloat(getComputedStyle(stage).top) || 0;
        const travel = hero.offsetHeight - stage.offsetHeight;
        if (travel <= 0) return;
        const progress = clamp((stuckTop - hero.getBoundingClientRect().top) / travel, 0, 1);
        const next = Math.min(frames.length - 1, Math.floor(progress * frames.length));
        if (next === current) return;
        current = next;
        track.style.setProperty('--i', String(next));
        frames.forEach((frame, index) => frame.classList.toggle('is-current', index === next));
      });
    }

    // Writing: the active row decides which cover is visible. Hover, focus and scroll position all drive it.
    const writing = root.querySelector<HTMLElement>('[data-writing]');
    if (writing) {
      const rows = Array.from(writing.querySelectorAll<HTMLElement>('[data-row]'));
      const covers = Array.from(writing.querySelectorAll<HTMLElement>('[data-cover-img]'));
      const activate = (row: HTMLElement) => {
        rows.forEach((item) => item.classList.toggle('is-active', item === row));
        const cover = row.dataset.cover;
        if (cover === undefined || cover === '') return;
        covers.forEach((image) => image.classList.toggle('is-active', image.dataset.coverImg === cover));
      };
      rows.forEach((row) => {
        listen(row, 'pointerenter', () => activate(row));
        listen(row, 'focusin', () => activate(row));
      });
      const photo = writing.querySelector<HTMLElement>('.writing-photo');
      frameLoop(() => {
        const box = writing.getBoundingClientRect();
        if (box.bottom < 0 || box.top > window.innerHeight || !photo) return;
        const phone = window.matchMedia('(max-width: 900px)').matches;
        const line = phone
          ? photo.getBoundingClientRect().bottom + 48
          : window.innerHeight * 0.5;
        let best: HTMLElement | undefined;
        let distance = Infinity;
        rows.forEach((row) => {
          const rect = row.getBoundingClientRect();
          const gap = Math.abs(rect.top + rect.height / 2 - line);
          if (gap < distance) {
            distance = gap;
            best = row;
          }
        });
        if (best && !best.classList.contains('is-active')) activate(best);
      });
    }

    // Ask: plain GET to /ask without JS. With JS the question travels in the hash the ask page already reads.
    const form = root.querySelector<HTMLFormElement>('[data-home-ask]');
    if (form) {
      listen(form, 'submit', (event) => {
        event.preventDefault();
        const question = String(new FormData(form).get('q') ?? '').trim();
        void navigate(question ? `/ask#q=${encodeURIComponent(question)}` : '/ask');
      });
    }

    teardown = () => cleanups.forEach((cleanup) => cleanup());
  }

  document.addEventListener('astro:page-load', initHome);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = undefined;
  });
</script>

<style>
  .home {
    --nav-h: 4.5rem;
    --gutter: clamp(1rem, 2.2vw, 2rem);
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-body);
  }

  .home a {
    color: inherit;
  }

  .home :where(h1, h2, h3) {
    color: inherit;
    margin: 0;
  }

  .home :global(img) {
    border-radius: 0;
  }

  /* Hero: pinned stage, sentence halves at the margins, a vertical reel between them */
  .hero {
    position: relative;
    --reel-w: 37vw;
    --gap: 24px;
    --ratio: 0.6667;
    --frame-h: calc(var(--reel-w) * var(--ratio));
    --step: calc(var(--frame-h) + var(--gap));
  }

  .home.is-live .hero {
    min-height: 280svh;
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--reel-w) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    height: calc(100svh - var(--nav-h));
    padding: 0 var(--gutter) var(--gutter);
    background: var(--bg);
  }

  .home.is-live .hero-stage {
    position: sticky;
    top: var(--nav-h);
  }

  .hero-title {
    display: contents;
    margin: 0;
  }

  .half {
    grid-row: 1;
    align-self: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-head);
    line-height: 0.88;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .half-a {
    grid-column: 1;
    justify-self: start;
  }

  .half-b {
    grid-column: 3;
    justify-self: end;
  }

  .reel {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    height: var(--frame-h);
    overflow: hidden;
  }

  .reel-track {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    transform: translateY(calc(-1 * var(--i, 0) * var(--step)));
    transition: transform 700ms var(--ease-out);
  }

  .frame {
    margin: 0;
    flex: none;
    height: var(--frame-h);
    overflow: hidden;
    background: var(--surface);
  }

  .frame picture,
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .frame img {
    object-fit: cover;
    transform: scale(1);
    transition: transform 900ms var(--ease-out);
  }

  .frame.is-current img {
    transform: scale(1.06);
    transition-duration: 6s;
  }

  .hero-intro {
    grid-column: 1 / 3;
    grid-row: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    max-width: 38rem;
  }

  .hero-lede {
    margin: 0;
    max-width: 34ch;
    font-size: var(--step-body);
    line-height: 1.45;
  }

  .hero-ask {
    display: flex;
    gap: 0.75rem;
    max-width: 34rem;
  }

  .hero-ask input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--step-body);
  }

  .hero-ask input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .action {
    min-height: 3rem;
    padding: 0 1.5rem;
    border: 0;
    border-radius: 0;
    background: var(--accent);
    color: var(--accent-ink);
    font: inherit;
    font-size: var(--step-body);
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      opacity 160ms var(--ease-out);
  }

  .action:hover {
    transform: translateY(-2px);
  }

  .action:active {
