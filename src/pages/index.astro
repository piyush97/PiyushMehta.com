---
import { getCollection } from 'astro:content';
import { caseStudies, socialLinks } from '../data/portfolio';
import speakerPhoto from '../images/piyush-devfest.jpg';
import speakerPhotoAvif320 from '../images/responsive/piyush-devfest-320.avif';
import speakerPhotoAvif640 from '../images/responsive/piyush-devfest-640.avif';
import speakerPhotoAvif960 from '../images/responsive/piyush-devfest-960.avif';
import speakerPhotoAvif1280 from '../images/responsive/piyush-devfest-1280.avif';
import speakerPhotoWebp320 from '../images/responsive/piyush-devfest-320.webp';
import speakerPhotoWebp640 from '../images/responsive/piyush-devfest-640.webp';
import speakerPhotoWebp960 from '../images/responsive/piyush-devfest-960.webp';
import speakerPhotoWebp1280 from '../images/responsive/piyush-devfest-1280.webp';
import speakerPhotoJpg320 from '../images/responsive/piyush-devfest-320.jpg';
import speakerPhotoJpg640 from '../images/responsive/piyush-devfest-640.jpg';
import speakerPhotoJpg960 from '../images/responsive/piyush-devfest-960.jpg';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const featuredCaseStudies = caseStudies.slice(0, 3);
const latestPosts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const toPostHref = (id: string) =>
  `/blog/${id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, '')}`;
---

<Layout
  title="Piyush Mehta — Senior Software Engineer"
  description="Piyush Mehta is a senior software engineer in Canada building reliable web platforms, AI workflows, and scalable product systems with TypeScript, React, Node.js, Astro, and cloud infrastructure."
  keywords={[
    'Piyush Mehta',
    'Senior Software Engineer',
    'TypeScript',
    'React',
    'Node.js',
    'Astro',
    'Software Architecture',
    'AI Workflows',
  ]}
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
  preloadImage={speakerPhotoAvif1280.src}
>
  <div class="home" data-home-ledger>
    <section class="ledger" aria-labelledby="home-title">
      <p class="ledger__edition">Piyush Mehta / Engineer’s Portfolio / 2026</p>

      <div class="ledger__stage">
        <div class="ledger__intro" data-home-section="intro" data-reveal data-reveal-delay="40">
          <p class="ledger__kicker"><span>01</span><span>The Systems Ledger</span></p>
          <h1 id="home-title" data-hero-title>
            Software that holds up<br />{' '}after the demo<span aria-hidden="true">.</span>
          </h1>
          <p class="ledger__lede">
            I build durable product systems at the seam between ambitious ideas and operational
            reality — with judgment that can be inspected, challenged, and trusted.
          </p>
        </div>

        <figure
          class="ledger__portrait"
          data-home-section="portrait"
          data-reveal
          data-reveal-delay="120"
          data-parallax
          data-parallax-speed="0.06"
        >
          <picture>
            <source
              type="image/avif"
              srcset={`${speakerPhotoAvif320.src} 320w, ${speakerPhotoAvif640.src} 640w, ${speakerPhotoAvif960.src} 960w, ${speakerPhotoAvif1280.src} 1280w`}
              sizes="(max-width: 900px) calc(100vw - 2rem), 42vw"
            />
            <source
              type="image/webp"
              srcset={`${speakerPhotoWebp320.src} 320w, ${speakerPhotoWebp640.src} 640w, ${speakerPhotoWebp960.src} 960w, ${speakerPhotoWebp1280.src} 1280w`}
              sizes="(max-width: 900px) calc(100vw - 2rem), 42vw"
            />
            <source
              type="image/jpeg"
              srcset={`${speakerPhotoJpg320.src} 320w, ${speakerPhotoJpg640.src} 640w, ${speakerPhotoJpg960.src} 960w, ${speakerPhoto.src} 1280w`}
              sizes="(max-width: 900px) calc(100vw - 2rem), 42vw"
            />
            <img
              src={speakerPhoto.src}
              width={speakerPhoto.width}
              height={speakerPhoto.height}
              alt="Piyush Mehta speaking on stage at a developer conference"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        </figure>

        <article class="ledger__evidence" data-home-section="evidence" data-reveal data-reveal-delay="160">
          <span class="ledger__signal" aria-hidden="true"></span>
          <h2>Enterprise AI Workflows</h2>
          <div class="ledger__evidence-body">
            <p><strong>Constraint</strong> — fragmented manual processes</p>
            <p><strong>Decision</strong> — workflow-first AI with security guardrails</p>
            <p><strong>Outcome</strong> — 30% greater workflow efficiency</p>
          </div>
          <a href="/projects/">
            View case study
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </article>

        <div class="ledger__actions" data-home-section="actions" aria-label="Primary actions">
          <a class="ledger__primary" href="/projects/">
            Review 3 case studies
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a class="ledger__secondary" href="/resume/">Read Résumé</a>
        </div>
      </div>

      <div class="ledger__metrics" data-home-section="metrics" aria-label="Selected impact" data-reveal>
        <article data-reveal data-reveal-stagger="0">
          <span class="ledger__metric-index">01</span>
          <strong>30%</strong>
          <h2>workflow efficiency</h2>
          <p>Enterprise AI workflow delivery</p>
        </article>
        <article data-reveal data-reveal-stagger="60">
          <span class="ledger__metric-index">02</span>
          <strong>35–40%</strong>
          <h2>fewer vulnerabilities</h2>
          <p>Secure engineering and review programs</p>
        </article>
        <article data-reveal data-reveal-stagger="120">
          <span class="ledger__metric-index">03</span>
          <strong>1,500+</strong>
          <h2>developers mentored</h2>
          <p>Workshops, community, and technical education</p>
        </article>
      </div>

      <div class="ledger__scroll" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24">
          <path d="m5 9 7 7 7-7"></path>
        </svg>
        <span>Scroll to explore</span>
      </div>
    </section>

    <section class="work" aria-labelledby="work-title">
      <header class="section-intro section-intro--compact" data-reveal>
        <p class="folio">02 / Work</p>
        <h2 id="work-title">Selected systems</h2>
      </header>

      <div class="work__list">
        {featuredCaseStudies.map((study, index) => (
          <article class="work-item" data-reveal data-reveal-stagger={String(index * 70)}>
            <div class="work-item__number">0{index + 1}</div>
            <div class="work-item__body">
              <p class="work-item__meta">{study.eyebrow} · {study.timeframe}</p>
              <h3>{study.title}</h3>
              <p>{study.summary}</p>
              <ul aria-label={`${study.title} technologies`}>
                {study.stack.slice(0, 5).map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <a href="/projects/" aria-label={`Read ${study.title} case study`}>
              <span>Case study</span><span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="notebook" aria-labelledby="notebook-title">
      <header class="section-intro" data-reveal>
        <p class="folio">03 / Field notes</p>
        <h2 id="notebook-title">Current notebook</h2>
        <p>Practical notes on systems, software, and decisions worth making visible.</p>
      </header>

      {latestPosts.length > 0 && (
        <div class="notebook__grid">
          {latestPosts.map((post, index) => (
            <article class:list={["note", { "note--lead": index === 0 }]} data-reveal data-reveal-stagger={String(index * 70)}>
              <div class="note__meta">
                <span>{post.data.tags?.[0] ?? 'Engineering'}</span>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
              </div>
              <h3><a href={toPostHref(post.id)}>{post.data.title}</a></h3>
              {post.data.description && <p>{post.data.description}</p>}
              <a class="note__link" href={toPostHref(post.id)} aria-label={`Read ${post.data.title}`}>
                Read note <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      )}
    </section>

    <section class="contact" data-reveal aria-labelledby="contact-title">
      <p class="folio">04 / Next chapter</p>
      <div>
        <h2 id="contact-title">Good systems begin with a precise conversation.</h2>
        <p>
          Open to senior software engineering and technical leadership opportunities where product
          judgment, reliability, and clear execution matter.
        </p>
      </div>
      <div class="contact__actions">
        <a href="/contact-me/">Start a conversation <span aria-hidden="true">↗</span></a>
        <div aria-label="Professional links">
          {socialLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .home {
    --home-paper: var(--color-bg);
    --home-paper-deep: var(--color-surface-raised);
    --home-ink: var(--color-text-primary);
    --home-muted: var(--color-text-secondary);
    --home-rule: var(--color-card-border);
    --home-wine: var(--color-accent);
    --home-motion-enter: 560ms;
    --home-motion-portrait: 900ms;
    --home-motion-rule: 420ms;
    --home-motion-nudge: 0.22rem;
    color: var(--home-ink);
    background: var(--home-paper);
    font-family: var(--font-sans);
  }

  .work,
  .notebook,
  .contact {
    width: min(1240px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .ledger {
    width: min(1552px, calc(100% - clamp(3rem, 7.2vw, 7.5rem)));
    margin-inline: auto;
    padding-top: 1.35rem;
  }

  .ledger__edition,
  .ledger__kicker,
  .ledger__evidence h2,
  .ledger__metric-index,
  .folio,
  .work-item__meta,
  .note__meta {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 800;
  }

  .ledger__edition {
    margin: 0;
    color: var(--home-muted);
    text-align: right;
  }

  .ledger__stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    min-height: clamp(35rem, 66vh, 40rem);
  }

  .ledger__intro {
    z-index: 3;
    grid-column: 1 / 9;
    grid-row: 1;
    align-self: center;
    padding-block: 4.5rem 3.8rem;
  }

  .ledger__actions {
    grid-column: 1 / 7;
    grid-row: 2;
    align-self: start;
    margin-top: -1rem;
  }

  .ledger__kicker {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 2.3rem;
    color: var(--home-wine);
    animation: home-fade-up var(--home-motion-enter) var(--motion-ease-out) 80ms both;
  }

  .ledger__kicker span:first-child {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ledger__kicker span:first-child::after {
    content: '';
    width: 3.25rem;
    height: 1px;
    background: currentColor;
  }

  .ledger h1,
  .section-intro h2,
  .contact h2,
  .work-item h3,
  .note h3 {
    font-family: var(--font-sans);
  }

  .ledger h1 {
    margin: 0;
    color: var(--home-ink);
    font-size: clamp(4.5rem, 6vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.87;
    animation: home-fade-up var(--home-motion-enter) var(--motion-ease-out) 140ms both;
  }

  .ledger h1 span {
    color: var(--home-wine);
  }

  .ledger__lede {
    max-width: 40rem;
    margin: 2.25rem 0 0;
    color: var(--home-muted);
    font-size: var(--text-xl);
    line-height: 1.55;
    animation: home-fade-up var(--home-motion-enter) var(--motion-ease-out) 220ms both;
  }

  .ledger__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8rem;
    margin-top: 2rem;
    animation: home-fade-up var(--home-motion-enter) var(--motion-ease-out) 300ms both;
  }

  .ledger__actions a,
  .ledger__evidence a,
  .contact__actions > a {
    display: inline-flex;
    min-height: 4rem;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    padding: 0.9rem 2rem;
    color: var(--home-ink);
    font-size: var(--text-lg);
    font-weight: 800;
    text-decoration: none;
    transition:
      background-color var(--motion-fast) var(--motion-ease-out),
      border-color var(--motion-fast) var(--motion-ease-out),
      color var(--motion-fast) var(--motion-ease-out),
      transform var(--motion-fast) var(--motion-ease-out);
  }

  .ledger__actions a:hover,
  .contact__actions > a:hover {
    transform: translateY(-2px);
  }

  .ledger__actions a:is(:hover, :focus-visible) svg,
  .ledger__evidence a:is(:hover, :focus-visible) svg,
  .contact__actions > a:is(:hover, :focus-visible) span[aria-hidden='true'] {
    transform: translateX(var(--home-motion-nudge));
  }

  .ledger__actions svg,
  .ledger__evidence svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    transition: transform var(--motion-fast) var(--motion-ease-out);
  }

  .contact__actions > a span[aria-hidden='true'] {
    display: inline-block;
    transition: transform var(--motion-fast) var(--motion-ease-out);
  }

  .ledger__primary,
  .contact__actions > a {
    border: 1px solid var(--home-wine);
    border-radius: var(--radius-sm);
    background: var(--home-wine);
    color: var(--color-accent-foreground) !important;
  }

  .ledger__secondary {
    border: 1px solid var(--home-muted);
    border-radius: var(--radius-sm);
  }

  .ledger__secondary:hover {
    border-color: var(--home-ink);
    background: var(--home-paper-deep);
  }

  .ledger__portrait {
    position: relative;
    z-index: 2;
    grid-column: 6 / 12;
    grid-row: 1 / 3;
    align-self: end;
    margin: 0;
    margin-bottom: -4.7rem;
    height: clamp(31rem, 62vh, 38rem);
    pointer-events: none;
  }

  .ledger__portrait::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        var(--home-paper) 0,
        transparent 14%,
        transparent 52%,
        var(--home-paper) 100%
      ),
      linear-gradient(
        90deg,
        var(--home-paper) 0,
        transparent 38%,
        transparent 62%,
        var(--home-paper) 92%
      );
    content: '';
  }

  .ledger__portrait picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ledger__portrait img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
    object-position: center;
    transform: scale(1.15);
    -webkit-mask-image: radial-gradient(
      ellipse 63% 76% at 55% 54%,
      #000 42%,
      transparent 88%
    );
    mask-image: radial-gradient(ellipse 63% 76% at 55% 54%, #000 42%, transparent 88%);
    animation: home-portrait-in var(--home-motion-portrait) var(--motion-ease-out) 180ms both;
  }

  .ledger__evidence {
    z-index: 4;
    grid-column: 11 / -1;
    grid-row: 1 / 3;
    align-self: start;
    margin: 2.5rem 0 0;
    padding: 1rem 0 0;
  }

  .ledger__signal {
    display: block;
    width: 1.75rem;
    height: 0.25rem;
    margin-bottom: 0.9rem;
    background: var(--home-wine);
    transform-origin: left center;
    animation: home-signal-in var(--home-motion-rule) var(--motion-ease-out) 300ms both;
  }

  .ledger__evidence h2 {
    margin: 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--home-rule);
    color: var(--home-ink);
    animation: home-fade-up var(--home-motion-enter) var(--motion-ease-out) 340ms both;
  }

  .ledger__evidence-body {
    padding-block: 0.9rem 0.35rem;
    border-bottom: 1px solid var(--home-rule);
    animation: home-fade-up var(--home-motion-enter) var(--motion-ease-out) 400ms both;
  }

  .ledger__evidence p {
    margin: 0 0 0.7rem;
    color: var(--home-muted);
    font-size: var(--text-base);
    line-height: 1.45;
  }

  .ledger__evidence strong {
    color: var(--home-ink);
  }

  .ledger__evidence a {
    min-height: 2.75rem;
    justify-content: flex-start;
    padding: 0.6rem 0;
    color: var(--home-wine);
    font-size: var(--text-base);
    animation: home-fade-up var(--home-motion-enter) var(--motion-ease-out) 460ms both;
  }

  .ledger__metrics {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--home-rule);
  }

  .ledger__metrics article {
    position: relative;
    min-height: 12.4rem;
    padding: 1.35rem 2.2rem 1.15rem 0.4rem;
  }

  .ledger__metrics article + article {
    padding-left: 3.6rem;
  }

  .ledger__metrics article + article::before {
    position: absolute;
    top: 1.6rem;
    bottom: 2.4rem;
    left: 0;
    width: 1px;
    background: var(--home-wine);
    content: '';
  }

  .ledger__metric-index {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--home-ink);
  }

  .ledger__metric-index::after {
    width: 2.6rem;
    height: 1px;
    background: var(--home-muted);
    content: '';
  }

  .ledger__metrics strong {
    display: block;
    margin-top: 0.55rem;
    color: var(--home-wine);
    font-size: clamp(2.6rem, 3.6vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    animation: home-fade-up var(--home-motion-enter) var(--motion-ease-out) 420ms both;
  }

  @keyframes home-fade-up {
    from {
      opacity: 0;
      transform: translateY(0.7rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes home-portrait-in {
    from {
      opacity: 0;
      filter: blur(8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes home-signal-in {
    from {
      opacity: 0;
      transform: scaleX(0.2);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .ledger__metrics h2 {
    margin: 0.25rem 0 0;
    color: var(--home-ink);
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: 1.2;
  }

  .ledger__metrics p {
    margin: 0.35rem 0 0;
    color: var(--home-muted);
    font-size: var(--text-base);
    line-height: 1.35;
  }

  .ledger__scroll {
    display: none;
  }

  .work,
  .notebook,
  .contact {
    padding-block: clamp(5rem, 9vw, 8rem);
    border-top: 1px solid var(--home-rule);
  }

  .section-intro {
    display: grid;
    grid-template-columns: 0.65fr 1.5fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-intro--compact {
    grid-template-columns: 0.65fr 2.5fr;
  }

  .folio {
    margin: 0;
    color: var(--home-wine);
  }

  .section-intro h2,
  .contact h2 {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .section-intro > p:last-child,
  .contact > div > p {
    max-width: 34rem;
    margin: 0;
    color: var(--home-muted);
    line-height: 1.7;
  }

  .work-item__body > p,
  .note > p {
    color: var(--home-muted);
    line-height: 1.65;
  }

  .work-item__body {
    min-width: 0;
  }

  .work__list {
    border-top: 1px solid var(--home-ink);
  }

  .work-item {
    display: grid;
    grid-template-columns: 0.35fr 2fr 0.65fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--home-rule);
  }

  .work-item__number {
    padding-top: 0.35rem;
    color: var(--home-wine);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .work-item__meta {
    margin: 0 0 0.85rem;
    color: var(--home-muted);
  }

  .work-item h3 {
    margin: 0;
    font-size: clamp(2.1rem, 3.5vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  .work-item__body > p {
    max-width: 50rem;
    margin: 1.1rem 0 0;
  }

  .work-item ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .work-item li {
    color: var(--home-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .work-item > a {
    display: flex;
    justify-content: space-between;
    align-self: start;
    gap: 1rem;
    padding-top: 0.35rem;
    color: var(--home-ink);
    font-size: 0.76rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .work-item > a span:first-child {
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3rem;
  }

  .notebook__grid {
    display: grid;
    grid-template-columns: 1.35fr 0.825fr 0.825fr;
    border-top: 1px solid var(--home-ink);
    border-bottom: 1px solid var(--home-ink);
  }

  .note {
    display: flex;
