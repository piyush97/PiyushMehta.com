---
import { getCollection } from 'astro:content';
import { caseStudies, portfolioMetrics, socialLinks } from '../data/portfolio';
import speakerPhoto from '../images/piyush-devfest.jpg';
import speakerPhotoAvif320 from '../images/responsive/piyush-devfest-320.avif';
import speakerPhotoAvif640 from '../images/responsive/piyush-devfest-640.avif';
import speakerPhotoAvif960 from '../images/responsive/piyush-devfest-960.avif';
import speakerPhotoAvif1280 from '../images/responsive/piyush-devfest-1280.avif';
import speakerPhotoWebp320 from '../images/responsive/piyush-devfest-320.webp';
import speakerPhotoWebp640 from '../images/responsive/piyush-devfest-640.webp';
import speakerPhotoWebp960 from '../images/responsive/piyush-devfest-960.webp';
import speakerPhotoWebp1280 from '../images/responsive/piyush-devfest-1280.webp';
import speakerPhotoJpg320 from '../images/responsive/piyush-devfest-320.jpg';
import speakerPhotoJpg640 from '../images/responsive/piyush-devfest-640.jpg';
import speakerPhotoJpg960 from '../images/responsive/piyush-devfest-960.jpg';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const featuredCaseStudies = caseStudies.slice(0, 3);
const latestPosts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const toPostHref = (id: string) =>
  `/blog/${id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, '')}`;
---

<Layout
  title="Piyush Mehta - Senior Software Engineer"
  description="Piyush Mehta is a senior software engineer in Canada building reliable web platforms, AI workflows, and scalable product systems with TypeScript, React, Node.js, Astro, and cloud infrastructure."
  keywords={[
    'Piyush Mehta',
    'Senior Software Engineer',
    'TypeScript',
    'React',
    'Node.js',
    'Astro',
    'Software Architecture',
    'AI Workflows',
  ]}
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
>
  <section class="home-hero" data-reveal>
    <span
      class="home-hero__accent home-hero__accent--north"
      aria-hidden="true"
      data-parallax
      data-parallax-speed="0.11"
    ></span>
    <span
      class="home-hero__accent home-hero__accent--east"
      aria-hidden="true"
      data-parallax
      data-parallax-speed="0.18"
    ></span>
    <div class="home-hero__copy" data-reveal data-reveal-delay="40">
      <p class="eyebrow" data-hero-eyebrow>Senior Software Engineer · Canada</p>
      <h1 data-hero-title>Software that holds up after the demo.</h1>
      <p class="lede">
        I work across product engineering, enterprise AI workflows, platform reliability, and
        developer education. This portfolio is for engineering leaders who want to inspect
        judgment: what shipped, which constraints mattered, and how tradeoffs were handled.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="btn-primary" href="/projects/">Inspect the work</a>
        <a class="btn-secondary" href="/resume/">Read the resume</a>
      </div>
      <div class="social-row" aria-label="Professional links">
        {socialLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>

    <figure class="hero-portrait" data-reveal data-reveal-delay="120" data-parallax data-parallax-speed="0.08">
      <picture>
        <source
          type="image/avif"
          srcset={`
            ${speakerPhotoAvif320.src} 320w,
            ${speakerPhotoAvif640.src} 640w,
            ${speakerPhotoAvif960.src} 960w,
            ${speakerPhotoAvif1280.src} 1280w
          `}
          sizes="(max-width: 920px) 100vw, (max-width: 1120px) 50vw, 540px"
        />
        <source
          type="image/webp"
          srcset={`
            ${speakerPhotoWebp320.src} 320w,
            ${speakerPhotoWebp640.src} 640w,
            ${speakerPhotoWebp960.src} 960w,
            ${speakerPhotoWebp1280.src} 1280w
          `}
          sizes="(max-width: 920px) 100vw, (max-width: 1120px) 50vw, 540px"
        />
        <source
          type="image/jpeg"
          srcset={`
            ${speakerPhotoJpg320.src} 320w,
            ${speakerPhotoJpg640.src} 640w,
            ${speakerPhotoJpg960.src} 960w,
            ${speakerPhoto.src} 1280w
          `}
          sizes="(max-width: 920px) 100vw, (max-width: 1120px) 50vw, 540px"
        />
        <img
          src={speakerPhoto.src}
          alt="Piyush Mehta speaking at a developer event"
          width={speakerPhoto.width}
          height={speakerPhoto.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <figcaption>
        Developer education, production systems, and hands-on infrastructure practice.
      </figcaption>
    </figure>
  </section>

  <section class="metrics-band" aria-label="Selected impact" data-reveal data-reveal-delay="80">
    {portfolioMetrics.map((metric, index) => (
      <article data-reveal data-reveal-stagger={String(index * 70)}>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
        <p>{metric.detail}</p>
      </article>
    ))}
  </section>
  <section class="section-block" data-reveal>
    <div class="section-heading" data-reveal data-reveal-delay="40">
      <p class="eyebrow">Writing</p>
      <h2>Current notebook</h2>
      <p>Notes on building reliable systems, shipping software, and the tools behind the work.</p>
    </div>

    {latestPosts.length > 0 && (
      <div class="notebook-grid">
        {latestPosts[0] && (
          <article class="notebook-card notebook-card--lead" data-reveal data-reveal-stagger="0">
            <div>
              {latestPosts[0].data.tags[0] && <span>{latestPosts[0].data.tags[0]}</span>}
              <h3>
                <a href={toPostHref(latestPosts[0].id)}>{latestPosts[0].data.title}</a>
              </h3>
              {latestPosts[0].data.description && <p>{latestPosts[0].data.description}</p>}
            </div>
            <div class="notebook-card__meta">
              <time datetime={latestPosts[0].data.date.toISOString()}>
                {latestPosts[0].data.date.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </time>
              <a href={toPostHref(latestPosts[0].id)}>Read article</a>
            </div>
          </article>
        )}

        {latestPosts.slice(1).length > 0 && (
          <div class="notebook-card__secondary">
            {latestPosts.slice(1).map((post, index) => (
              <article class="notebook-card" data-reveal data-reveal-stagger={String((index + 1) * 90)}>
                <div>
                  {post.data.tags[0] && <span>{post.data.tags[0]}</span>}
                  <h3>
                    <a href={toPostHref(post.id)}>{post.data.title}</a>
                  </h3>
                </div>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
              </article>
            ))}
          </div>
        )}
      </div>
    )}

    <a class="notebook-archive" href="/blog">Read all writing</a>
  </section>

  <section class="section-block" data-reveal>
    <div class="section-heading" data-reveal data-reveal-delay="40">
      <p class="eyebrow">Case Studies</p>
      <h2>Evidence over adjectives.</h2>
      <p>
        Strong engineering portfolios are not walls of technologies. They are decisions made under
        pressure, with constraints and outcomes attached.
      </p>
    </div>

    <div class="case-grid">
      {featuredCaseStudies.map((study, index) => (
        <article class="case-card" data-reveal data-reveal-stagger={String(index * 90)}>
          <div>
            <p class="case-card__eyebrow">{study.eyebrow}</p>
            <h3>{study.title}</h3>
            <p>{study.summary}</p>
          </div>
          <dl>
            <div>
              <dt>Role</dt>
              <dd>{study.role}</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>{study.stack.slice(0, 4).join(' · ')}</dd>
            </div>
          </dl>
          <a href="/projects/">Read the case study</a>
        </article>
      ))}
    </div>
  </section>

  <section class="closing-cta" data-reveal>
    <p class="eyebrow">Available for focused engineering conversations</p>
    <h2>Bring me a hard product constraint, a messy system, or a team that needs technical clarity.</h2>
    <div class="hero-actions">
      <a class="btn-primary" href="/contact-me/">Start a conversation</a>
      <a class="btn-secondary" href="/blog/">Read the technical writing</a>
    </div>
  </section>
</Layout>

<style>
  .home-hero,
  .section-block,
  .metrics-band,
  .closing-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .home-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    min-height: clamp(36rem, 64vh, 44rem);
    padding-block: clamp(4rem, 7vw, 5.5rem);
  }

  .home-hero__accent {
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
    opacity: 0.42;
    filter: blur(0.4px);
    z-index: 0;
  }

  .home-hero__accent--north {
    top: clamp(-2.2rem, -3vw, -1.2rem);
    left: clamp(0.5rem, 10vw, 7rem);
    width: clamp(7rem, 16vw, 12rem);
    height: clamp(7rem, 16vw, 12rem);
    border: 1px solid rgba(var(--color-accent-rgb), 0.35);
    background:
      radial-gradient(circle at 32% 35%, rgba(var(--color-accent-rgb), 0.26), transparent 62%),
      rgba(var(--color-accent-rgb), 0.08);
  }

  .home-hero__accent--east {
    right: clamp(-1.4rem, 2vw, 0.5rem);
    bottom: clamp(1.2rem, 5vw, 4rem);
    width: clamp(6rem, 14vw, 10rem);
    height: clamp(6rem, 14vw, 10rem);
    border: 1px solid rgba(var(--color-accent-rgb), 0.28);
    background: rgba(var(--color-accent-rgb), 0.12);
    box-shadow: 0 20px 48px rgba(var(--color-accent-rgb), 0.18);
  }

  .home-hero h1 {
    max-width: 14ch;
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(3.5rem, 5vw, 5rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .lede {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-secondary);
    font-size: 1.25rem;
    line-height: 1.75;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-actions,
  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .social-row {
    margin-top: 1rem;
  }

  .social-row a {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .social-row a:hover {
    color: var(--color-accent);
  }

  .hero-portrait {
    margin: 0;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
    position: relative;
    z-index: 1;
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hero-portrait figcaption {
    padding: 1rem;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .metrics-band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-card-border);
    background: var(--color-card-border);
  }

  .metrics-band article {
    min-height: 15rem;
    padding: 1.4rem;
    background: var(--color-surface-raised);
  }

  .metrics-band strong {
    display: block;
    color: var(--color-accent);
    font-size: 3.6rem;
    line-height: 1;
  }

  .metrics-band span {
    display: block;
    margin-top: 0.8rem;
    color: var(--color-text-primary);
    font-weight: 800;
    line-height: 1.3;
  }

  .metrics-band p,
  .case-card p,
  .section-heading p,
  .notebook-card p {
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .section-block {
    padding-block: clamp(4.5rem, 9vw, 7rem);
  }

  .section-heading {
    max-width: 48rem;
  }

  .section-heading h2,
  .closing-cta h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 3.75rem;
    line-height: 1.05;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .notebook-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .case-card,
  .notebook-card {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
  }

  .case-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 28rem;
    padding: 1.4rem;
  }

  .notebook-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 20rem;
    padding: 1.4rem;
  }

  .notebook-card--lead {
    min-height: 30rem;
  }

  .notebook-card__secondary {
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .notebook-card__meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }

  .notebook-card time {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .notebook-archive {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .case-card__eyebrow,
  .notebook-card span {
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-card h3,
  .notebook-card h3 {
    margin: 0.7rem 0 0;
    color: var(--color-text-primary);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .case-card dl {
    display: grid;
    gap: 0.85rem;
    margin: 1.5rem 0;
  }

  .case-card dt {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-card dd {
    margin: 0.2rem 0 0;
    color: var(--color-text-primary);
  }

  .case-card a,
  .notebook-card a {
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }


  .closing-cta {
    padding-block: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--color-card-border);
  }

  @media (max-width: 920px) {
    .home-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .home-hero h1 {
      font-size: 4.2rem;
    }

    .lede {
      font-size: 1.15rem;
    }

    .metrics-band strong {
      font-size: 2.8rem;
    }

    .section-heading h2,
    .closing-cta h2 {
      font-size: 2.9rem;
    }

    .metrics-band,
    .case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .notebook-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 620px) {
    .home-hero h1 {
      max-width: 10ch;
      font-size: 3rem;
    }

    .lede {
      font-size: 1.05rem;
    }

    .metrics-band strong {
      font-size: 2.2rem;
    }

    .section-heading h2,
    .closing-cta h2 {
      font-size: 2.1rem;
    }

    .metrics-band,
    .case-grid {
      grid-template-columns: 1fr;
    }

    .metrics-band article,
    .case-card,
    .notebook-card {
      min-height: 0;
    }
  }
</style>
