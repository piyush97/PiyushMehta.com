---
export const prerender = true;

import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.DEV ? Astro.url.origin : Astro.site?.toString() || 'https://piyushmehta.com';

const cards = [
  {
    label: 'Home',
    url: `${baseUrl}/og/home.png`,
    page: `${baseUrl}/`,
  },
  {
    label: 'Writing',
    url: `${baseUrl}/og/blog.png`,
    page: `${baseUrl}/blog/`,
  },
  {
    label: 'Article',
    url: `${baseUrl}/og/blog/bloom-filters.png`,
    page: `${baseUrl}/blog/bloom-filters`,
  },
  {
    label: 'Work',
    url: `${baseUrl}/og/projects.png`,
    page: `${baseUrl}/projects/`,
  },
];
---

<Layout
  title="OG Image Showcase"
  description="Crawler-safe Open Graph image previews for PiyushMehta.com."
  type="website"
  ogTemplate="minimal"
  ogTheme="dark"
>
  <section class="og-shell">
    <header>
      <p class="eyebrow">Open Graph</p>
      <h1>Clean share cards.</h1>
      <p>
        These are the production social card URLs used by Open Graph and Twitter metadata. They are
        PNG, 1200x630, cacheable, and crawler-friendly.
      </p>
      <a href="/og/home.png">Open home card</a>
    </header>

    <div class="card-list">
      {cards.map((card) => (
        <article>
          <div>
            <p class="eyebrow">{card.label}</p>
            <a href={card.page}>{card.page}</a>
          </div>
          <img src={card.url} alt={`${card.label} social card`} width="1200" height="630" />
          <code>{card.url}</code>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .og-shell {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  header {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  header p {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  header a,
  article a {
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .card-list {
    display: grid;
    gap: 2rem;
  }

  article {
    display: grid;
    gap: 0.9rem;
    border-top: 1px solid var(--color-card-border);
    padding-top: 1.25rem;
  }

  article > div {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
  }

  code {
    display: block;
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .og-shell {
      width: min(100% - 1rem, 1120px);
    }
  }
</style>
