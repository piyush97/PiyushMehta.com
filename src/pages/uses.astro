---
import SEO from '../components/SEO.astro';
import Layout from '../layouts/Layout.astro';

const title = 'Uses - My Development Setup';
const description =
  'A comprehensive list of the tools, software, hardware, and services I use for development, content creation, and daily productivity.';
---

<Layout title={title} description={description}>

  <!-- Enhanced Hero Section -->
  <section class="uses-hero-section">
    <!-- Animated background elements -->
    <div class="uses-hero-bg-pattern"></div>
    <div class="uses-hero-bg-gradient"></div>
    <div class="uses-hero-particle-field">
      <div class="particle particle-1"></div>
      <div class="particle particle-2"></div>
      <div class="particle particle-3"></div>
      <div class="particle particle-4"></div>
    </div>
    <div class="uses-hero-floating-elements">
      <div class="uses-floating-element uses-element-1">
        <div class="floating-icon">💻</div>
        <div class="floating-pulse"></div>
      </div>
      <div class="uses-floating-element uses-element-2">
        <div class="floating-icon">⚙️</div>
        <div class="floating-pulse"></div>
      </div>
      <div class="uses-floating-element uses-element-3">
        <div class="floating-icon">🛠️</div>
        <div class="floating-pulse"></div>
      </div>
    </div>

    <!-- Content container -->
    <div class="relative z-10 container-base">
      <div class="py-16 text-center md:py-24">
        <div class="hero-content-wrapper">
          <p class="uses-hero-intro">
            <span class="intro-icon">⚡</span>
            <span class="intro-text">My Development Stack</span>
          </p>
          <h1 class="uses-hero-title">
            <span class="title-primary">Uses</span>
            <strong class="title-accent">Setup</strong>
            <div class="title-underline"></div>
          </h1>
          <p class="uses-hero-teaser">
            A comprehensive overview of the <span class="highlight">tools</span
            >, <span class="highlight">hardware</span>, and <span
              class="highlight">software</span
            >
            that power my development workflow and content creation process.
          </p>
          <div class="uses-hero-meta">
            <div class="meta-item">
              <span class="meta-icon">📅</span>
              <span class="meta-text">Last updated: June 1, 2025</span>
            </div>
            <div class="meta-item">
              <span class="meta-icon">🔄</span>
              <span class="meta-text">Regularly updated</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="page-container">
    <div class="max-w-4xl container-base">
      <!-- Development Tools -->
      <section class="mb-12">
        <h2 class="mb-6 text-2xl font-bold text-accent">
          💻 Development Tools
        </h2>

        <div class="space-y-8">
          <!-- Code Editors -->
          <div class="uses-category">
            <h3 class="mb-4 text-xl font-semibold">Code Editors & IDEs</h3>
            <div class="grid gap-4">
              <div class="uses-item">
                <h4 class="font-medium text-accent">Visual Studio Code</h4>
                <p class="text-muted">
                  My primary code editor for most development work. Lightning
                  fast with excellent extension ecosystem.
                </p>
                <div class="uses-details">
                  <span class="uses-tag">Primary</span>
                  <a
                    href="https://code.visualstudio.com/"
                    class="uses-link"
                    target="_blank"
                    rel="noopener"
                  >
                    Visit →
                  </a>
                </div>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">Zed</h4>
                <p class="text-muted">
                  High-performance code editor built for speed and
                  collaboration, with excellent Rust and modern language
                  support.
                </p>
                <div class="uses-details">
                  <span class="uses-tag">Fast</span>
                  <a
                    href="https://zed.dev/"
                    class="uses-link"
                    target="_blank"
                    rel="noopener"
                  >
                    Visit →
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- VS Code Extensions -->
          <div class="uses-category">
            <h3 class="mb-4 text-xl font-semibold">VS Code Extensions</h3>
            <div class="grid gap-4 md:grid-cols-2">
              <div class="uses-item">
                <h4 class="font-medium text-accent">Prettier</h4>
                <p class="text-muted">
                  Code formatter that keeps my code consistent across all
                  projects.
                </p>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">ESLint</h4>
                <p class="text-muted">
                  JavaScript linter that helps catch errors and enforce coding
                  standards.
                </p>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">GitLens</h4>
                <p class="text-muted">
                  Supercharges the Git capabilities in VS Code with blame
                  annotations and history.
                </p>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">Thunder Client</h4>
                <p class="text-muted">
                  REST API client for VS Code - great alternative to Postman.
                </p>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">Auto Rename Tag</h4>
                <p class="text-muted">
                  Automatically renames paired HTML/JSX tags when editing.
                </p>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">Bracket Pair Colorizer</h4>
                <p class="text-muted">
                  Makes matching brackets easier to identify with colors.
                </p>
              </div>
            </div>
          </div>

          <!-- Terminal -->
          <div class="uses-category">
            <h3 class="mb-4 text-xl font-semibold">Terminal & Command Line</h3>
            <div class="grid gap-4">
              <div class="uses-item">
                <h4 class="font-medium text-accent">Warp</h4>
                <p class="text-muted">
                  Modern terminal with AI assistance, collaborative features,
                  and excellent developer experience.
                </p>
                <div class="uses-details">
                  <span class="uses-tag">macOS</span>
                  <a
                    href="https://www.warp.dev/"
                    class="uses-link"
                    target="_blank"
                    rel="noopener"
                  >
                    Visit →
                  </a>
                </div>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">Oh My Zsh</h4>
                <p class="text-muted">
                  Framework for Zsh shell with plugins and themes that boost
                  productivity.
                </p>
                <div class="uses-details">
                  <span class="uses-tag">Shell</span>
                  <a
                    href="https://ohmyz.sh/"
                    class="uses-link"
                    target="_blank"
                    rel="noopener"
                  >
                    Visit →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Enhanced Tech Stack -->
      <section class="mb-12">
        <div class="tech-stack-header">
          <h2 class="mb-2 text-3xl font-bold text-accent">🚀 Tech Stack</h2>
          <p class="mb-8 text-lg text-muted">Technologies I love working with and my proficiency levels</p>
        </div>

        <div class="tech-stack-container">
          <!-- Frontend Technologies -->
          <div class="tech-category" data-category="frontend">
            <div class="tech-category-header">
              <div class="category-icon">🎨</div>
              <h3 class="category-title">Frontend Development</h3>
              <div class="category-badge">UI/UX Focus</div>
            </div>
            
            <div class="tech-grid">
              <div class="tech-card" data-level="95">
                <div class="tech-icon">⚛️</div>
                <div class="tech-content">
                  <h4 class="tech-name">React</h4>
                  <p class="tech-description">Component-based UI library for modern web applications</p>
                  <div class="tech-meta">
                    <span class="tech-years">4+ years</span>
                    <span class="tech-level">Expert</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="95"></div>
                </div>
              </div>

              <div class="tech-card" data-level="90">
                <div class="tech-icon">▲</div>
                <div class="tech-content">
                  <h4 class="tech-name">Next.js</h4>
                  <p class="tech-description">Full-stack React framework with SSR, SSG, and API routes</p>
                  <div class="tech-meta">
                    <span class="tech-years">3+ years</span>
                    <span class="tech-level">Advanced</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="90"></div>
                </div>
              </div>

              <div class="tech-card" data-level="85">
                <div class="tech-icon">🚀</div>
                <div class="tech-content">
                  <h4 class="tech-name">Astro</h4>
                  <p class="tech-description">Modern static site generator for content-focused websites</p>
                  <div class="tech-meta">
                    <span class="tech-years">2+ years</span>
                    <span class="tech-level">Advanced</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="85"></div>
                </div>
              </div>

              <div class="tech-card" data-level="92">
                <div class="tech-icon">🔷</div>
                <div class="tech-content">
                  <h4 class="tech-name">TypeScript</h4>
                  <p class="tech-description">Type-safe JavaScript for scalable application development</p>
                  <div class="tech-meta">
                    <span class="tech-years">4+ years</span>
                    <span class="tech-level">Expert</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="92"></div>
                </div>
              </div>

              <div class="tech-card" data-level="88">
                <div class="tech-icon">🎨</div>
                <div class="tech-content">
                  <h4 class="tech-name">Tailwind CSS</h4>
                  <p class="tech-description">Utility-first CSS framework for rapid UI development</p>
                  <div class="tech-meta">
                    <span class="tech-years">3+ years</span>
                    <span class="tech-level">Advanced</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="88"></div>
                </div>
              </div>

              <div class="tech-card" data-level="80">
                <div class="tech-icon">✨</div>
                <div class="tech-content">
                  <h4 class="tech-name">Framer Motion</h4>
                  <p class="tech-description">Production-ready motion library for React animations</p>
                  <div class="tech-meta">
                    <span class="tech-years">2+ years</span>
                    <span class="tech-level">Proficient</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="80"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Backend Technologies -->
          <div class="tech-category" data-category="backend">
            <div class="tech-category-header">
              <div class="category-icon">⚙️</div>
              <h3 class="category-title">Backend Development</h3>
              <div class="category-badge">Server & Data</div>
            </div>
            
            <div class="tech-grid">
              <div class="tech-card" data-level="90">
                <div class="tech-icon">🟢</div>
                <div class="tech-content">
                  <h4 class="tech-name">Node.js</h4>
                  <p class="tech-description">JavaScript runtime for scalable server-side applications</p>
                  <div class="tech-meta">
                    <span class="tech-years">4+ years</span>
                    <span class="tech-level">Advanced</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="90"></div>
                </div>
              </div>

              <div class="tech-card" data-level="85">
                <div class="tech-icon">🚂</div>
                <div class="tech-content">
                  <h4 class="tech-name">Express.js</h4>
                  <p class="tech-description">Minimal and flexible Node.js web application framework</p>
                  <div class="tech-meta">
                    <span class="tech-years">4+ years</span>
                    <span class="tech-level">Advanced</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="85"></div>
                </div>
              </div>

              <div class="tech-card" data-level="82">
                <div class="tech-icon">🐘</div>
                <div class="tech-content">
                  <h4 class="tech-name">PostgreSQL</h4>
                  <p class="tech-description">Advanced relational database for complex applications</p>
                  <div class="tech-meta">
                    <span class="tech-years">3+ years</span>
                    <span class="tech-level">Proficient</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="82"></div>
                </div>
              </div>

              <div class="tech-card" data-level="78">
                <div class="tech-icon">🍃</div>
                <div class="tech-content">
                  <h4 class="tech-name">MongoDB</h4>
                  <p class="tech-description">NoSQL database for flexible document-based storage</p>
                  <div class="tech-meta">
                    <span class="tech-years">3+ years</span>
                    <span class="tech-level">Proficient</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="78"></div>
                </div>
              </div>

              <div class="tech-card" data-level="88">
                <div class="tech-icon">🔺</div>
                <div class="tech-content">
                  <h4 class="tech-name">Prisma</h4>
                  <p class="tech-description">Next-generation ORM with type-safe database access</p>
                  <div class="tech-meta">
                    <span class="tech-years">2+ years</span>
                    <span class="tech-level">Advanced</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="88"></div>
                </div>
              </div>

              <div class="tech-card" data-level="75">
                <div class="tech-icon">🔴</div>
                <div class="tech-content">
                  <h4 class="tech-name">Redis</h4>
                  <p class="tech-description">In-memory data store for caching and real-time features</p>
                  <div class="tech-meta">
                    <span class="tech-years">2+ years</span>
                    <span class="tech-level">Proficient</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="75"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- DevOps & Tools -->
          <div class="tech-category" data-category="tools">
            <div class="tech-category-header">
              <div class="category-icon">🛠️</div>
              <h3 class="category-title">DevOps & Tools</h3>
              <div class="category-badge">Infrastructure</div>
            </div>
            
            <div class="tech-grid">
              <div class="tech-card" data-level="85">
                <div class="tech-icon">🐙</div>
                <div class="tech-content">
                  <h4 class="tech-name">Git & GitHub</h4>
                  <p class="tech-description">Version control and collaborative development platform</p>
                  <div class="tech-meta">
                    <span class="tech-years">5+ years</span>
                    <span class="tech-level">Advanced</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="85"></div>
                </div>
              </div>

              <div class="tech-card" data-level="80">
                <div class="tech-icon">🐳</div>
                <div class="tech-content">
                  <h4 class="tech-name">Docker</h4>
                  <p class="tech-description">Containerization for consistent development environments</p>
                  <div class="tech-meta">
                    <span class="tech-years">3+ years</span>
                    <span class="tech-level">Proficient</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="80"></div>
                </div>
              </div>

              <div class="tech-card" data-level="88">
                <div class="tech-icon">▲</div>
                <div class="tech-content">
                  <h4 class="tech-name">Vercel</h4>
                  <p class="tech-description">Platform for frontend deployment and edge functions</p>
                  <div class="tech-meta">
                    <span class="tech-years">3+ years</span>
                    <span class="tech-level">Advanced</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="88"></div>
                </div>
              </div>

              <div class="tech-card" data-level="75">
                <div class="tech-icon">☁️</div>
                <div class="tech-content">
                  <h4 class="tech-name">AWS</h4>
                  <p class="tech-description">Cloud services for scalable application infrastructure</p>
                  <div class="tech-meta">
                    <span class="tech-years">2+ years</span>
                    <span class="tech-level">Proficient</span>
                  </div>
                </div>
                <div class="skill-bar">
                  <div class="skill-progress" data-width="75"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Hardware -->
      <section class="mb-12">
        <h2 class="mb-6 text-2xl font-bold text-accent">🖥️ Hardware & Setup</h2>

        <div class="space-y-8">
          <!-- Computer -->
          <div class="uses-category">
            <h3 class="mb-4 text-xl font-semibold">Computer</h3>
            <div class="grid gap-4">
              <div class="uses-item">
                <h4 class="font-medium text-accent">
                  MacBook Pro 14" (M1 Pro)
                </h4>
                <p class="text-muted">
                  Primary development machine with excellent performance and
                  portability. Perfect for development work and coding on the
                  go.
                </p>
                <div class="uses-details">
                  <span class="uses-tag">Primary</span>
                  <span class="uses-tag">2021</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Accessories -->
          <div class="uses-category">
            <h3 class="mb-4 text-xl font-semibold">Accessories</h3>
            <div class="grid gap-4 md:grid-cols-2">
              <div class="uses-item">
                <h4 class="font-medium text-accent">LG 27UK650-W 27"</h4>
                <p class="text-muted">
                  4K UHD monitor with excellent color accuracy and USB-C
                  connectivity. Great for development and design work.
                </p>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">
                  Logitech MX Mechanical Mini
                </h4>
                <p class="text-muted">
                  Compact wireless mechanical keyboard with tactile switches and
                  excellent battery life.
                </p>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">Logitech MX Master 3</h4>
                <p class="text-muted">
                  Wireless mouse with precise tracking, customizable buttons,
                  and excellent ergonomics for productivity.
                </p>
              </div>

              <div class="uses-item">
                <h4 class="font-medium text-accent">AirPods Pro</h4>
                <p class="text-muted">
                  Noise-canceling wireless earbuds for focused work and video
                  calls.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Enhanced Services & Hosting -->
      <section class="mb-12">
        <div class="services-stack-header">
          <h2 class="mb-2 text-3xl font-bold text-accent">☁️ Services & Hosting</h2>
          <p class="mb-8 text-lg text-muted">Cloud services and platforms powering my development workflow</p>
        </div>

        <div class="services-stack-container">
          <!-- Hosting & Deployment -->
          <div class="service-category" data-category="hosting">
            <div class="service-category-header">
              <div class="category-icon">🚀</div>
              <h3 class="category-title">Hosting & Deployment</h3>
              <div class="category-badge">Edge & CDN</div>
            </div>
            
            <div class="service-grid">
              <div class="service-card" data-usage="95" data-status="primary">
                <div class="service-icon">▲</div>
                <div class="service-content">
                  <h4 class="service-name">Vercel</h4>
                  <p class="service-description">Primary deployment platform with edge functions and global CDN</p>
                  <div class="service-meta">
                    <span class="service-usage">Primary</span>
                    <span class="service-status">Active</span>
                  </div>
                </div>
                <div class="usage-bar">
                  <div class="usage-progress" data-width="95"></div>
                </div>
                <div class="service-badge service-primary">Primary</div>
              </div>

              <div class="service-card" data-usage="75" data-status="active">
                <div class="service-icon">🌐</div>
                <div class="service-content">
                  <h4 class="service-name">Netlify</h4>
                  <p class="service-description">Static site hosting with serverless functions and form handling</p>
                  <div class="service-meta">
                    <span class="service-usage">Secondary</span>
                    <span class="service-status">Active</span>
                  </div>
                </div>
                <div class="usage-bar">
                  <div class="usage-progress" data-width="75"></div>
                </div>
                <div class="service-badge service-secondary">Secondary</div>
              </div>

              <div class="service-card" data-usage="85" data-status="active">
                <div class="service-icon">☁️</div>
                <div class="service-content">
                  <h4 class="service-name">AWS</h4>
                  <p class="service-description">Cloud infrastructure for scalable applications and data storage</p>
                  <div class="service-meta">
                    <span class="service-usage">Enterprise</span>
                    <span class="service-status">Active</span>
                  </div>
                </div>
                <div class="usage-bar">
                  <div class="usage-progress" data-width="85"></div>
                </div>
                <div class="service-badge service-enterprise">Enterprise</div>
              </div>

              <div class="service-card" data-usage="70" data-status="active">
                <div class="service-icon">🌊</div>
                <div class="service-content">
                  <h4 class="service-name">DigitalOcean</h4>
                  <p class="service-description">Simple cloud hosting for backend services and databases</p>
                  <div class="service-meta">
                    <span class="service-usage">Development</span>
                    <span class="service-status">Active</span>
                  </div>
                </div>
                <div class="usage-bar">
                  <div class="usage-progress" data-width="70"></div>
                </div>
                <div class="service-badge service-development">Development</div>
              </div>
            </div>
          </div>

          <!-- Development Services -->
          <div class="service-category" data-category="development">
            <div class="service-category-header">
              <div class="category-icon">⚙️</div>
              <h3 class="category-title">Development Services</h3>
              <div class="category-badge">DevOps & Tools</div>
            </div>
            
            <div class="service-grid">
              <div class="service-card" data-usage="95" data-status="primary">
                <div class="service-icon">🐙</div>
                <div class="service-content">
                  <h4 class="service-name">GitHub</h4>
                  <p class="service-description">Version control, CI/CD, and collaborative development platform</p>
                  <div class="service-meta">
                    <span class="service-usage">Primary</span>
                    <span class="service-status">Daily</span>
                  </div>
                </div>
                <div class="usage-bar">
                  <div class="usage-progress" data-width="95"></div>
                </div>
                <div class="service-badge service-primary">Primary</div>
              </div>

              <div class="service-card" data-usage="88" data-status="active">
                <div class="service-icon">🛡️</div>
                <div class="service-content">
                  <h4 class="service-name">Sentry</h4>
                  <p class="service-description">Error tracking and performance monitoring for production apps</p>
                  <div class="service-meta">
                    <span class="service-usage">Monitoring</span>
                    <span class="service-status">Active</span>
                  </div>
                </div>
                <div class="usage-bar">
                  <div class="usage-progress" data-width="88"></div>
                </div>
                <div class="service-badge service-monitoring">Monitoring</div>
              </div>

              <div class="service-card" data-usage="90" data-status="active">
                <div class="service-icon">🔶</div>
                <div class="service-content">
