<script>
  // Enhanced Tech Stack Interactivity
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize skill bar animations
    function initSkillBars() {
      const techCards = document.querySelectorAll('.tech-card');
      
      techCards.forEach(card => {
        const skillProgress = card.querySelector('.skill-progress');
        const level = card.getAttribute('data-level');
        
        if (skillProgress && level) {
          skillProgress.style.setProperty('--skill-width', level + '%');
        }
      });
    }

    // Initialize usage bar animations for services
    function initUsageBars() {
      const serviceCards = document.querySelectorAll('.service-card');
      
      serviceCards.forEach(card => {
        const usageProgress = card.querySelector('.usage-progress');
        const usage = card.getAttribute('data-usage');
        
        if (usageProgress && usage) {
          usageProgress.style.setProperty('--usage-width', usage + '%');
        }
      });
    }

    // Intersection Observer for scroll animations
    function initScrollAnimations() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add('animate');
              
              // Animate tech cards within the category
              if (entry.target.classList.contains('tech-category')) {
                const techCards = entry.target.querySelectorAll('.tech-card');
                techCards.forEach((card, cardIndex) => {
                  setTimeout(() => {
                    card.classList.add('animate');
                  }, cardIndex * 100);
                });
              }
              
              // Animate service cards within the category
              if (entry.target.classList.contains('service-category')) {
                const serviceCards = entry.target.querySelectorAll('.service-card');
                serviceCards.forEach((card, cardIndex) => {
                  setTimeout(() => {
                    card.classList.add('animate');
                  }, cardIndex * 100);
                });
              }
            }, index * 200);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      // Observe tech categories
      document.querySelectorAll('.tech-category').forEach(category => {
        observer.observe(category);
      });
      
      // Observe service categories
      document.querySelectorAll('.service-category').forEach(category => {
        observer.observe(category);
      });
    }

    // Enhanced hover effects
    function initHoverEffects() {
      const techCards = document.querySelectorAll('.tech-card');
      const serviceCards = document.querySelectorAll('.service-card');
      
      techCards.forEach(card => {
        card.addEventListener('mouseenter', function() {
          // Add ripple effect
          const ripple = document.createElement('div');
          ripple.className = 'ripple';
          ripple.style.cssText = `
            position: absolute;
            border-radius: 50%;
            background: rgba(var(--color-accent-rgb), 0.1);
            width: 100px;
            height: 100px;
            animation: ripple 0.6s linear;
            pointer-events: none;
          `;
          
          const rect = this.getBoundingClientRect();
          const size = 100;
          const x = event.clientX - rect.left - size / 2;
          const y = event.clientY - rect.top - size / 2;
          
          ripple.style.left = x + 'px';
          ripple.style.top = y + 'px';
          
          this.appendChild(ripple);
          
          setTimeout(() => {
            ripple.remove();
          }, 600);
        });
      });
      
      // Add hover effects to service cards
      serviceCards.forEach(card => {
        card.addEventListener('mouseenter', function() {
          // Add ripple effect
          const ripple = document.createElement('div');
          ripple.className = 'ripple';
          ripple.style.cssText = `
            position: absolute;
            border-radius: 50%;
            background: rgba(var(--color-accent-rgb), 0.1);
            width: 100px;
            height: 100px;
            animation: ripple 0.6s linear;
            pointer-events: none;
          `;
          
          const rect = this.getBoundingClientRect();
          const size = Math.max(rect.width, rect.height);
          const x = event.clientX - rect.left - size / 2;
          const y = event.clientY - rect.top - size / 2;
          
          ripple.style.left = x + 'px';
          ripple.style.top = y + 'px';
          
          this.appendChild(ripple);
          
          setTimeout(() => {
            ripple.remove();
          }, 600);
        });
      });
    }

    // Add ripple animation keyframes
    const style = document.createElement('style');
    style.textContent = `
      @keyframes ripple {
        to {
          transform: scale(4);
          opacity: 0;
        }
      }
    `;
    document.head.appendChild(style);

    // Initialize all functionality
    initSkillBars();
    initUsageBars();
    initScrollAnimations();
    initHoverEffects();

    // Optional: Add keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Tab') {
        document.querySelectorAll('.tech-card:focus').forEach(card => {
          card.classList.add('keyboard-focus');
        });
      }
    });
  });
</script>
