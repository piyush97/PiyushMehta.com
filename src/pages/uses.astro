---
import { setupPrinciples, usesCategories } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Uses - Piyush Mehta"
  description="A curated look at the tools Piyush Mehta uses for software engineering, infrastructure practice, technical writing, and developer education."
  type="website"
  ogTemplate="minimal"
  ogTheme="light"
>
  <section class="page-hero" data-pagefind-body>
    <div class="page-hero__copy">
      <p class="eyebrow">Uses</p>
      <h1 data-pagefind-meta="title">Tools reveal how someone thinks.</h1>
      <p class="lede">
        A curated snapshot of my working setup. Less about a perfect shopping list, more about
        habits underneath it: fast feedback, readable systems, repeatable environments, and clear
        communication.
      </p>
    </div>

    <aside class="principle-panel">
      <p class="eyebrow">Setup rule</p>
      <h2>Workflow matters more than novelty.</h2>
      <p>
        I keep tools when they reduce friction between idea, implementation, review, and verification.
      </p>
    </aside>
  </section>

  <section class="page-section">
    <div class="tool-grid">
      {usesCategories.map((category) => (
        <article class="info-card">
          <h2>{category.title}</h2>
          <p>{category.description}</p>
          <div>
            {category.items.map((item) => <span>{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section split-grid">
    <div class="section-heading">
      <p class="eyebrow">Principles</p>
      <h2>Setup should make work easier to inspect.</h2>
    </div>
    <div class="stack-list">
      {setupPrinciples.map((principle, index) => (
        <article class="info-card">
          <span>Principle {index + 1}</span>
          <p>{principle}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="accent-cta">
    <div>
      <p class="eyebrow">More context</p>
      <h2>Setup is part of the work.</h2>
      <p>
        I write about migrations, local environments, and operating-system choices when they change
        how engineering feels day to day.
      </p>
    </div>
    <a class="btn-dark" href="/blog/macos-to-arch-linux-omarchy-developer-productivity/">
      Read setup essay
    </a>
  </section>
</Layout>

<style>
  .page-hero,
  .page-section,
  .accent-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(4rem, 8vw, 6rem) 3rem;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: var(--color-text-primary);
    letter-spacing: 0;
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(3.2rem, 8vw, 5.4rem);
    line-height: 1.02;
  }

  .section-heading h2,
  .accent-cta h2 {
    font-size: clamp(2.1rem, 4vw, 3.35rem);
    line-height: 1.05;
  }

  .lede,
  .principle-panel p,
  .info-card p,
  .accent-cta p {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .lede {
    max-width: 44rem;
    margin: 1.35rem 0 0;
    font-size: 1.15rem;
  }

  .principle-panel,
  .info-card {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    padding: 1.25rem;
  }

  .principle-panel h2,
  .info-card h2 {
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .page-section {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .info-card p {
    margin: 0.75rem 0 0;
  }

  .info-card div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .info-card span {
    display: inline-flex;
    border: 1px solid var(--color-card-border);
    padding: 0.35rem 0.55rem;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.25rem;
  }

  .section-heading {
    max-width: 42rem;
  }

  .stack-list {
    display: grid;
    gap: 1rem;
  }

  .accent-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: end;
    margin-block: clamp(3rem, 7vw, 5rem);
    border: 1px solid var(--color-card-border);
    background: var(--color-accent);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .accent-cta .eyebrow,
  .accent-cta h2,
  .accent-cta p {
    color: var(--color-darker);
  }

  .btn-dark {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    background: var(--color-darker);
    padding: 0.8rem 1.1rem;
    color: white;
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .page-hero,
    .tool-grid,
    .split-grid,
    .accent-cta {
      grid-template-columns: 1fr;
    }
  }
</style>
