---
import {
  caseStudies,
  portfolioMetrics,
  serviceEngagements,
  technologyPrinciples,
} from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const keywords = [
  'Software Engineering',
  'Technical Consulting',
  'Enterprise AI Workflows',
  'Web Platforms',
  'Architecture Review',
  'TypeScript',
  'React',
  'Node.js',
  'Astro',
  'Cloud Infrastructure',
];

const proofPoints = caseStudies.slice(0, 4);
---

<Layout
  title="Software Engineering Consulting | Piyush Mehta"
  description="Focused software engineering help for web platforms, AI workflows, architecture reviews, and technical delivery."
  keywords={keywords}
  type="website"
  ogTemplate="professional"
  ogTheme="dark"
>
  <section class="page-hero" data-pagefind-body>
    <div class="page-hero__copy">
      <p class="eyebrow" data-hero-eyebrow>Focused engineering help</p>
      <h1 data-hero-title data-pagefind-meta="title">Technical clarity for real systems.</h1>
      <p class="lede">
        I help teams reason through architecture, ship web platforms, integrate AI workflows,
        and improve reliability without adding unnecessary complexity.
      </p>
      <div class="actions">
        <a class="btn-primary" href="/contact-me/">Start conversation</a>
        <a class="btn-secondary" href="/projects/">Review case studies</a>
      </div>
    </div>

    <aside class="metric-panel" aria-label="Selected impact">
      {portfolioMetrics.map((metric) => (
        <article>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </article>
      ))}
    </aside>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="eyebrow">Engagements</p>
      <h2>Useful work, scoped around decision.</h2>
      <p>
        Best consulting leaves a team with fewer mysteries: clearer tradeoffs, a working path
        forward, and code or documentation that can survive review.
      </p>
    </div>
    <div class="engagement-grid">
      {serviceEngagements.map((engagement) => (
        <article class="info-card">
          <h3>{engagement.title}</h3>
          <p>{engagement.summary}</p>
          <ul>
            {engagement.usefulFor.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="eyebrow">Proof</p>
      <h2>Work should make argument.</h2>
    </div>
    <div class="proof-grid">
      {proofPoints.map((study, index) => (
        <article class="info-card">
          <span>{study.eyebrow}</span>
          <h3>{study.title}</h3>
          <p>{study.summary}</p>
          <a href={`/projects/#case-${index + 1}`}>Read case study</a>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section split-grid">
    <div class="section-heading">
      <p class="eyebrow">How I work</p>
      <h2>Boring in places that should be boring.</h2>
    </div>
    <div class="stack-list">
      {technologyPrinciples.map((principle, index) => (
        <article class="info-card">
          <span>Principle {index + 1}</span>
          <p>{principle}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="accent-cta" id="consultation">
    <div>
      <p class="eyebrow">Available for focused conversations</p>
      <h2>Bring hard constraint.</h2>
      <p>
        Share product goal, system pressure, and what already hurts. I will help turn it into a
        practical engineering path.
      </p>
    </div>
    <a class="btn-dark" href="/contact-me/">Contact Piyush</a>
  </section>
</Layout>

<style>
  .page-hero,
  .page-section,
  .accent-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
    padding-block: clamp(4rem, 8vw, 6rem) 3rem;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-text-primary);
    letter-spacing: 0;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3.2rem, 8vw, 5.5rem);
    line-height: 1.02;
  }

  .section-heading h2,
  .accent-cta h2 {
    font-size: clamp(2.1rem, 4vw, 3.35rem);
    line-height: 1.05;
  }

  .lede,
  .section-heading p,
  .info-card p,
  .accent-cta p {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .lede {
    max-width: 44rem;
    margin: 1.35rem 0 0;
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .metric-panel,
  .info-card {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
  }

  .metric-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    background: var(--color-card-border);
  }

  .metric-panel article {
    min-height: 10rem;
    padding: 1.15rem;
    background: var(--color-surface-raised);
  }

  .metric-panel strong {
    display: block;
    color: var(--color-text-primary);
    font-size: 2.2rem;
    line-height: 1;
  }

  .metric-panel span,
  .info-card span {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-accent);
    font-weight: 800;
    line-height: 1.5;
  }

  .page-section {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .section-heading {
    max-width: 44rem;
    margin-bottom: 1.5rem;
  }

  .engagement-grid,
  .proof-grid,
  .stack-list {
    display: grid;
    gap: 1rem;
  }

  .engagement-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .proof-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.25rem;
  }

  .info-card {
    padding: 1.2rem;
  }

  .info-card h3 {
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .info-card p {
    margin: 0.75rem 0 0;
  }

  .info-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .info-card li {
    border: 1px solid var(--color-card-border);
    padding: 0.35rem 0.55rem;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .info-card a {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .accent-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: end;
    margin-block: clamp(3rem, 7vw, 5rem);
    border: 1px solid var(--color-card-border);
    background: var(--color-accent);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .accent-cta .eyebrow,
  .accent-cta h2,
  .accent-cta p {
    color: var(--color-darker);
  }

  .btn-dark {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    background: var(--color-darker);
    padding: 0.8rem 1.1rem;
    color: white;
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 1080px) {
    .proof-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .page-hero,
    .engagement-grid,
    .split-grid,
    .accent-cta {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .metric-panel,
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
