---
import Layout from '../layouts/Layout.astro';
import { caseStudies, socialLinks } from '../data/portfolio';
import socialCard from '../images/social.jpg';
---

<Layout
  title="Work - Piyush Mehta"
  description="Selected case studies, architecture tradeoffs, and engineering outcomes from Piyush Mehta, senior software engineer."
  image={socialCard.src}
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
>
  <section class="work-hero">
    <p class="eyebrow" data-hero-eyebrow>Selected Work</p>
    <h1 data-hero-title>Case studies for engineering leaders who care about tradeoffs.</h1>
    <p>
      Selected work is organized around the parts that matter in review: problem, constraints,
      approach, outcomes, and the technical choices behind them.
    </p>
    <div class="work-actions">
      <a class="btn-primary" href="/contact-me/">Discuss a system</a>
      <a class="btn-secondary" href="/resume/">View resume</a>
    </div>
  </section>

  <section class="case-study-list" aria-label="Case studies">
    {caseStudies.map((study, index) => (
      <article class="case-study" id={`case-${index + 1}`}>
        <div class="case-study__intro">
          <p class="eyebrow">{study.eyebrow}</p>
          <h2>{study.title}</h2>
          <p>{study.summary}</p>
          <dl>
            <div>
              <dt>Role</dt>
              <dd>{study.role}</dd>
            </div>
            <div>
              <dt>Timeframe</dt>
              <dd>{study.timeframe}</dd>
            </div>
          </dl>
        </div>

        <div class="case-study__body">
          <section>
            <h3>Problem</h3>
            <p>{study.problem}</p>
          </section>
          <section>
            <h3>Approach</h3>
            <ul>
              {study.approach.map((item) => <li>{item}</li>)}
            </ul>
          </section>
          <section>
            <h3>Outcomes</h3>
            <ul>
              {study.outcomes.map((item) => <li>{item}</li>)}
            </ul>
          </section>
          <section>
            <h3>Stack</h3>
            <div class="tag-row">
              {study.stack.map((item) => <span>{item}</span>)}
            </div>
          </section>
          {
            study.links && (
              <section>
                <h3>Links</h3>
                <div class="link-row">
                  {study.links.map((link) => (
                    <a href={link.href}>{link.label}</a>
                  ))}
                </div>
              </section>
            )
          }
        </div>
      </article>
    ))}
  </section>

  <section class="work-footer-cta">
    <h2>Want the short version?</h2>
    <p>
      I am strongest where product needs meet system constraints: AI workflows, scalable web
      platforms, pragmatic architecture, and teams that benefit from clear technical leadership.
    </p>
    <div class="link-row">
      {socialLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </section>
</Layout>

<style>
  .work-hero,
  .case-study-list,
  .work-footer-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .work-hero {
    padding-block: clamp(4rem, 7vw, 5.5rem);
  }

  .work-hero h1,
  .work-footer-cta h2 {
    max-width: 15.5ch;
    margin: 0;
    color: var(--color-text-primary);
    font-size: 4.8rem;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .work-hero p,
  .work-footer-cta p {
    max-width: 48rem;
    color: var(--color-text-secondary);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .work-actions,
  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .case-study-list {
    display: grid;
    gap: 1.25rem;
  }

  .case-study {
    display: grid;
    grid-template-columns: minmax(260px, 0.78fr) minmax(0, 1.22fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-card-border);
    background: var(--color-card-border);
  }

  .case-study__intro,
  .case-study__body {
    background: var(--color-surface-raised);
  }

  .case-study__intro {
    padding: clamp(1.3rem, 3vw, 2rem);
  }

  .case-study__intro h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 3rem;
    line-height: 1;
  }

  .case-study__intro p,
  .case-study__body p,
  .case-study__body li {
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .case-study dl {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
  }

  .case-study dt,
  .case-study__body h3 {
    color: var(--color-text-muted);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study dd {
    margin: 0.25rem 0 0;
    color: var(--color-text-primary);
  }

  .case-study__body {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.3rem, 3vw, 2rem);
  }

  .case-study__body h3 {
    margin: 0 0 0.5rem;
  }

  .case-study__body ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .tag-row,
  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.7rem;
  }

  .tag-row span {
    border: 1px solid var(--color-card-border);
    padding: 0.38rem 0.62rem;
    color: var(--color-text-primary);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .link-row a {
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .work-footer-cta {
    padding-block: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--color-card-border);
  }

  @media (max-width: 920px) {
    .work-hero h1,
    .work-footer-cta h2 {
      font-size: 3.5rem;
    }

    .case-study__intro h2 {
      font-size: 2.5rem;
    }

    .case-study {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .work-hero h1,
    .work-footer-cta h2 {
      font-size: 2.8rem;
    }

    .case-study__intro h2 {
      font-size: 2rem;
    }

  }
</style>
