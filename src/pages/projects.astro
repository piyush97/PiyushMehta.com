---
import CaseStudyRecord from '../components/CaseStudyRecord.astro';
import EditorialHeader from '../components/EditorialHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { caseStudies, socialLinks } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="Work - Piyush Mehta"
  description="Selected case studies, architecture tradeoffs, and engineering outcomes from Piyush Mehta, senior software engineer."
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
>
  <EditorialHeader
    class="work-hero"
    eyebrow="Selected Work"
    title="Case studies for engineering leaders who care about tradeoffs."
    description="Selected work is organized around the parts that matter in review: problem, constraints, approach, outcomes, and the technical choices behind them."
    actions={[
      { href: '/contact-me/', label: 'Discuss a system' },
      { href: '/resume/', label: 'View resume', variant: 'secondary' },
    ]}
    asideLabel="Work index"
  >
    <div slot="aside">
      <span>{caseStudies.length} case records</span>
      <span>Problem → approach → outcomes</span>
      <strong>Read the work as a sequence of decisions.</strong>
    </div>
  </EditorialHeader>

  <section class="case-index" aria-labelledby="case-index-heading" data-work-section="index">
    <SectionHeader
      eyebrow="Case index"
      title="Start with the decision."
      id="case-index-heading"
      description="Use the index to jump to a record, or read the sequence when you want the full thread."
    />

    <nav class="case-index__nav" aria-label="Jump to a case study">
      <ol>
        {caseStudies.map((study, index) => (
          <li>
            <a href={`#case-${index + 1}`}>
              <span class="case-index__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="case-index__title">{study.title}</span>
              <span class="case-index__timeframe">{study.timeframe}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <section class="case-study-list" aria-label="Case studies" data-work-section="records">
    {caseStudies.map((study, index) => <CaseStudyRecord study={study} index={index} />)}
  </section>

  <section class="work-footer-cta" data-work-section="next">
    <SectionHeader
      eyebrow="Next step"
      title="Want the short version?"
      description="I am strongest where product needs meet system constraints: AI workflows, scalable web platforms, pragmatic architecture, and teams that benefit from clear technical leadership."
    />
    <div class="link-row">
      {socialLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </section>
</Layout>

<style>
  .case-index,
  .case-study-list,
  .work-footer-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .case-index {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3.5rem, 7vw, 6rem);
  }

  .case-index__nav {
    margin-top: 2.25rem;
    border-block: 1px solid var(--color-card-border);
  }

  .case-index__nav ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    background: var(--color-card-border);
    list-style: none;
  }

  .case-index__nav li {
    min-width: 0;
    background: var(--color-bg);
  }

  .case-index__nav a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto 1rem;
    gap: 0.75rem;
    min-height: 4.2rem;
    align-items: center;
    padding: 0.8rem 1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease;
  }

  .case-index__nav a:hover,
  .case-index__nav a:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-bg));
    color: var(--color-accent);
  }

  .case-index__number,
  .case-index__timeframe {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case-index__number {
    color: var(--color-accent);
    font-weight: 800;
  }

  .case-index__title {
    overflow: hidden;
    font-size: 1rem;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .case-index__nav svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--motion-fast, 150ms) ease;
  }

  .case-index__nav a:hover svg,
  .case-index__nav a:focus-visible svg {
    transform: translateX(0.2rem);
  }

  .case-study-list {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  .work-footer-cta {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--color-card-border);
  }

  .work-footer-cta :global(.section-heading) {
    max-width: 48rem;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .link-row a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-bottom: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .link-row a:hover,
  .link-row a:focus-visible {
    color: var(--color-text-primary);
  }

  @media (max-width: 720px) {
    .case-index__nav ol {
      grid-template-columns: 1fr;
    }

    .case-index__nav a {
      grid-template-columns: 2.25rem minmax(0, 1fr) 1rem;
    }

    .case-index__timeframe {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .case-index,
    .case-study-list,
    .work-footer-cta {
      width: min(100% - 1rem, 1120px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-index__nav a,
    .case-index__nav svg {
      transition: none;
    }

    .case-index__nav a:hover svg,
    .case-index__nav a:focus-visible svg {
      transform: none;
    }
  }
</style>
