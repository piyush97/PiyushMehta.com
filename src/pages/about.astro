---
import {
  aboutFocusAreas,
  caseStudies,
  portfolioMetrics,
  writingHighlights,
} from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

const featuredStudies = caseStudies.slice(0, 3);
---

<Layout
  title="About - Piyush Mehta"
  description="About Piyush Mehta, a senior software engineer focused on reliable web platforms, AI workflows, technical writing, and architecture tradeoffs."
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
>
  <section class="page-hero" data-pagefind-body>
    <div class="page-hero__copy">
      <p class="eyebrow" data-hero-eyebrow>About Piyush</p>
      <h1 data-hero-title data-pagefind-meta="title">I build software with clarity, reliability, and useful proof.</h1>
      <p class="lede">
        Senior software engineer across TypeScript, React, Node.js, Astro, AI-assisted workflows,
        and cloud-backed product systems. I care about what ships, what can be maintained, and what
        the team learns while building it.
      </p>
      <div class="actions">
        <a class="btn-primary" href="/projects/">See work</a>
        <a class="btn-secondary" href="/resume/">Read resume</a>
      </div>
    </div>

    <aside class="principle-panel">
      <p class="eyebrow">Working thesis</p>
      <h2>Good engineering makes future decisions easier.</h2>
      <p>
        That shows up in code, docs, tests, migration plans, and how clearly a team can talk about
        tradeoffs under pressure.
      </p>
    </aside>
  </section>

  <section class="metric-band" aria-label="Selected impact">
    {portfolioMetrics.map((metric) => (
      <article>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
        <p>{metric.detail}</p>
      </article>
    ))}
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="eyebrow">Focus</p>
      <h2>The through-line is engineering judgment.</h2>
    </div>
    <div class="feature-grid">
      {aboutFocusAreas.map((area) => (
        <article class="info-card">
          <h3>{area.title}</h3>
          <p>{area.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section split-grid">
    <div class="section-heading">
      <p class="eyebrow">Proof</p>
      <h2>Places where pattern shows up.</h2>
    </div>
    <div class="stack-list">
      {featuredStudies.map((study, index) => (
        <article class="info-card">
          <span>{study.eyebrow}</span>
          <h3>{study.title}</h3>
          <p>{study.summary}</p>
          <a href={`/projects/#case-${index + 1}`}>Read case study</a>
        </article>
      ))}
    </div>
  </section>

  <section class="accent-cta">
    <div>
      <p class="eyebrow">Writing and teaching</p>
      <h2>I explain what I build.</h2>
      <p>
        Good engineering scales through shared understanding. Writing and workshops are part of how
        I make technical decisions easier for other people to inspect.
      </p>
    </div>
    <div class="writing-list">
      {writingHighlights.map((item) => (
        <a href={item.href}>
          <span>{item.theme}</span>
          <strong>{item.title}</strong>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-hero,
  .page-section,
  .metric-band,
  .accent-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(4rem, 8vw, 6rem) 3rem;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-text-primary);
    letter-spacing: 0;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 7vw, 5.25rem);
    line-height: 1.02;
  }

  .section-heading h2,
  .accent-cta h2 {
    font-size: clamp(2.1rem, 4vw, 3.35rem);
    line-height: 1.05;
  }

  .lede,
  .principle-panel p,
  .info-card p,
  .accent-cta p {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .lede {
    max-width: 44rem;
    margin: 1.35rem 0 0;
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .principle-panel,
  .info-card {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    padding: 1.25rem;
  }

  .principle-panel h2 {
    font-size: 1.4rem;
    line-height: 1.2;
  }

  .metric-band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-card-border);
    background: var(--color-card-border);
  }

  .metric-band article {
    min-height: 13rem;
    padding: 1.5rem;
    background: var(--color-surface-raised);
  }

  .metric-band strong {
    display: block;
    color: var(--color-text-primary);
    font-size: 2.4rem;
    line-height: 1;
  }

  .metric-band span,
  .info-card span {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-accent);
    font-weight: 800;
    line-height: 1.5;
  }

  .metric-band p {
    margin: 0.85rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .page-section {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .section-heading {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.25rem;
  }

  .stack-list,
  .writing-list {
    display: grid;
    gap: 1rem;
  }

  .info-card h3 {
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .info-card p {
    margin: 0.75rem 0 0;
  }

  .info-card a,
  .writing-list a {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .accent-cta {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.5rem;
    margin-block: clamp(3rem, 7vw, 5rem);
    border: 1px solid var(--color-card-border);
    background: var(--color-accent);
    padding: clamp(1.5rem, 4vw, 3rem);
    color: var(--color-darker);
  }

  .accent-cta .eyebrow,
  .accent-cta h2,
  .accent-cta p,
  .writing-list a {
    color: var(--color-darker);
  }

  .writing-list a {
    display: block;
    margin: 0;
    border: 1px solid rgba(0, 0, 0, 0.18);
    padding: 1rem;
  }

  .writing-list span {
    display: block;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .writing-list strong {
    display: block;
    margin-top: 0.45rem;
  }

  @media (max-width: 960px) {
    .page-hero,
    .split-grid,
    .accent-cta,
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .metric-band {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .metric-band {
      grid-template-columns: 1fr;
    }
  }
</style>
