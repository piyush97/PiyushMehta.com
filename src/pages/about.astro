---
import EditorialHeader from '../components/EditorialHeader.astro';
import EvidenceMetricRail from '../components/EvidenceMetricRail.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  aboutFocusAreas,
  caseStudies,
  portfolioMetrics,
  writingHighlights,
} from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const featuredStudies = caseStudies.slice(0, 3);
---

<Layout
  title="About - Piyush Mehta"
  description="About Piyush Mehta, a senior software engineer focused on reliable web platforms, AI workflows, technical writing, and architecture tradeoffs."
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
>
  <div data-pagefind-body>
    <EditorialHeader
      class="page-hero"
      eyebrow="About Piyush"
      title="I build software with clarity, reliability, and useful proof."
      description="Senior software engineer across TypeScript, React, Node.js, Astro, AI-assisted workflows, and cloud-backed product systems. I care about what ships, what can be maintained, and what the team learns while building it."
      actions={[
        { href: '/projects/', label: 'See work' },
        { href: '/resume/', label: 'Read resume', variant: 'secondary' },
      ]}
      asideLabel="Working thesis"
      pagefindTitle="title"
    >
      <div slot="aside">
        <span>Working thesis</span>
        <strong>Good engineering makes future decisions easier.</strong>
        <ul>
          <li>Clear constraints</li>
          <li>Visible tradeoffs</li>
          <li>Useful proof</li>
        </ul>
      </div>
    </EditorialHeader>

    <EvidenceMetricRail
      class="metric-band"
      metrics={portfolioMetrics}
      label="Selected impact"
    />

    <section class="page-section about-focus" data-about-section="focus">
      <SectionHeader
        eyebrow="Focus"
        title="The through-line is engineering judgment."
        description="The work changes shape around the system. The responsibility stays the same: make the next decision easier to inspect."
      />
      <div class="focus-register">
        {aboutFocusAreas.map((area, index) => (
          <article class="focus-record">
            <span class="focus-record__number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{area.title}</h3>
              <p>{area.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section about-proof" data-about-section="proof">
      <SectionHeader
        eyebrow="Proof"
        title="Places where pattern shows up."
        description="A few records make the approach concrete. The full case studies keep the constraints, decisions, and outcomes together."
      />
      <div class="proof-register">
        {featuredStudies.map((study, index) => (
          <article class="proof-record">
            <div class="proof-record__meta">
              <span>0{index + 1}</span>
              <span>{study.eyebrow}</span>
            </div>
            <div>
              <h3>{study.title}</h3>
              <p>{study.summary}</p>
            </div>
            <a href={`/projects/#case-${index + 1}`}>
              Read case study
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="accent-cta" data-about-section="writing">
      <div>
        <p class="eyebrow">Writing and teaching</p>
        <h2>I explain what I build.</h2>
        <p>
          Good engineering scales through shared understanding. Writing and workshops are part of how
          I make technical decisions easier for other people to inspect.
        </p>
      </div>
      <div class="writing-list">
        {writingHighlights.map((item) => (
          <a href={item.href}>
            <span>{item.theme}</span>
            <strong>{item.title}</strong>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-section,
  .metric-band,
  .accent-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .metric-band {
    margin-top: 0.5rem;
  }

  .page-section {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) 0;
  }

  .about-focus :global(.section-heading) {
    margin-bottom: 2rem;
  }

  .focus-register,
  .proof-register {
    border-block: 1px solid var(--color-card-border);
  }

  .focus-record {
    display: grid;
    grid-template-columns: minmax(3rem, 0.18fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-card-border);
  }

  .focus-record:last-child {
    border-bottom: 0;
  }

  .focus-record__number,
  .proof-record__meta {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .focus-record h3,
  .proof-record h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    line-height: 1.15;
  }

  .focus-record p,
  .proof-record p {
    max-width: 52rem;
    margin: 0.65rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .about-proof {
    padding-top: clamp(4rem, 9vw, 7rem);
  }

  .about-proof :global(.section-heading) {
    margin-bottom: 2rem;
  }

  .proof-record {
    display: grid;
    grid-template-columns: minmax(10rem, 0.28fr) minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-card-border);
  }

  .proof-record:last-child {
    border-bottom: 0;
  }

  .proof-record__meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .proof-record__meta span:last-child {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .proof-record > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .proof-record > a:hover,
  .proof-record > a:focus-visible {
    color: var(--color-text-primary);
  }

  .proof-record svg,
  .writing-list svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--motion-fast, 150ms) ease;
  }

  .proof-record > a:hover svg,
  .proof-record > a:focus-visible svg,
  .writing-list a:hover svg,
  .writing-list a:focus-visible svg {
    transform: translateX(0.2rem);
  }

  .accent-cta {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    margin-block: clamp(4rem, 9vw, 7rem);
    border: 1px solid var(--color-card-border);
    background: var(--color-accent);
    padding: clamp(1.5rem, 4vw, 3rem);
    color: var(--color-darker);
  }

  .accent-cta h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1;
  }

  .accent-cta p:not(.eyebrow) {
    margin: 1rem 0 0;
    line-height: 1.7;
  }

  .accent-cta .eyebrow {
    color: var(--color-darker);
  }

  .writing-list {
    display: grid;
    gap: 0;
    border-block: 1px solid rgba(0, 0, 0, 0.2);
  }

  .writing-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem;
    gap: 0.4rem 1rem;
    align-items: center;
    min-height: 4.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    padding: 0.8rem 0;
    color: var(--color-darker);
    text-decoration: none;
  }

  .writing-list a:last-child {
    border-bottom: 0;
  }

  .writing-list span {
    grid-column: 1 / -1;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .writing-list strong {
    font-size: 1rem;
    line-height: 1.35;
  }

  @media (max-width: 800px) {
    .proof-record {
      grid-template-columns: minmax(7rem, 0.3fr) minmax(0, 1fr);
    }

    .proof-record > a {
      grid-column: 2;
    }

    .accent-cta {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .metric-band,
    .page-section,
    .accent-cta {
      width: min(100% - 1rem, 1120px);
    }

    .focus-record,
    .proof-record {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .proof-record > a {
      grid-column: auto;
    }
  }
</style>
