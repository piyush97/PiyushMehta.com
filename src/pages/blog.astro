---
import { getCollection } from 'astro:content';
import BlogFilter from '../components/BlogFilter.astro';
import EditorialHeader from '../components/EditorialHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { writingHighlights } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

export const prerender = true;

const allPosts = await getCollection('blog');
const toPostSlug = (id: string) => id.replace(/\/index$/, '').replace(/\.(md|mdx)$/, '');

const toPlainText = (value: string) =>
  value
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/!\[[^\]]*]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)]\([^)]+\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[*_~>#-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const createExcerpt = (post: { data: { description?: string }; body?: string }) => {
  if (post.data.description?.trim()) {
    return post.data.description.trim();
  }

  const plain = toPlainText(post.body ?? '');
  if (!plain) {
    return 'Technical notes, implementation details, and lessons from production systems.';
  }

  return plain.slice(0, 180) + (plain.length > 180 ? '...' : '');
};

const calculateReadingTime = (post: { body?: string; data: { description?: string } }) => {
  const plain = toPlainText(post.body ?? post.data.description ?? '');
  const words = plain ? plain.split(' ').length : 0;
  return Math.max(1, Math.ceil(words / 200));
};

const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type ReadingPathStepConfig = {
  readonly slug: string;
  readonly stepLabel: string;
};

type ReadingPathConfig = {
  readonly id: string;
  readonly intent: string;
  readonly outcome: string;
  readonly steps: readonly [
    ReadingPathStepConfig,
    ReadingPathStepConfig,
    ReadingPathStepConfig,
  ];
};

const readingPathConfigs = [
  {
    id: 'safe-ai-agent',
    intent: 'I need to ship an AI agent safely',
    outcome: 'Build the protocol, map its trust boundaries, and verify actions before release.',
    steps: [
      { slug: 'building-mcp-server-typescript', stepLabel: 'Start with the protocol' },
      { slug: 'ai-agents-mcp-security-crisis', stepLabel: 'Inspect the trust boundary' },
      { slug: 'testing-ai-agent-actions', stepLabel: 'Prove the action gate' },
    ],
  },
  {
    id: 'production-migration',
    intent: 'I’m planning a production migration',
    outcome: 'Move from strategy to cutover with reliability, data safety, and platform constraints in view.',
    steps: [
      { slug: 'cron-to-event-driven', stepLabel: 'Frame the migration' },
      { slug: 'zero-downtime-database-migration-at-scale', stepLabel: 'Protect the data path' },
      { slug: 'vercel-to-cloudflare-migration', stepLabel: 'Adapt to the new runtime' },
    ],
  },
  {
    id: 'coding-agent-workflow',
    intent: 'I want a better coding-agent workflow',
    outcome: 'Give agents durable context, persistent sessions, and a faster keyboard-first desktop loop.',
    steps: [
      { slug: 'agents-md-repository-context', stepLabel: 'Give agents context' },
      { slug: 'herdr-terminal-multiplexer-coding-agents', stepLabel: 'Keep their sessions alive' },
      { slug: 'omaswitch-alt-tab-omarchy', stepLabel: 'Tighten the desktop loop' },
    ],
  },
] as const satisfies readonly ReadingPathConfig[];

class ReadingPathEntryError extends Error {
  readonly pathIntent: string;
  readonly slug: string;

  constructor(pathIntent: string, slug: string) {
    super(`Reading path "${pathIntent}" references missing or draft post "${slug}".`);
    this.name = 'ReadingPathEntryError';
    this.pathIntent = pathIntent;
    this.slug = slug;
  }
}

const publishedPostBySlug = new Map(
  publishedPosts.map((post) => [toPostSlug(post.id), post] as const)
);

const readingPaths = readingPathConfigs.map((path) => ({
  ...path,
  steps: path.steps.map((step) => {
    const post = publishedPostBySlug.get(step.slug);
    if (!post) {
      throw new ReadingPathEntryError(path.intent, step.slug);
    }

    return {
      ...step,
      title: post.data.title,
      description: createExcerpt(post),
      href: `/blog/${step.slug}/`,
      tags: post.data.tags ?? [],
      readingTime: calculateReadingTime(post),
    };
  }),
}));

// Prepare posts data for the BlogFilter component
const postsForFilter = publishedPosts.map((post) => ({
  id: toPostSlug(post.id),
  title: post.data.title,
  excerpt: createExcerpt(post),
  date: post.data.date.toISOString(),
  slug: toPostSlug(post.id),
  categories: post.data.tags || [],
  readingTime: calculateReadingTime(post),
}));

const avgReadingTime = postsForFilter.length
  ? Math.round(
      postsForFilter.reduce((total, post) => total + post.readingTime, 0) / postsForFilter.length
    )
  : 0;
const uniqueThemes = new Set(postsForFilter.flatMap((post) => post.categories)).size;
---

<Layout
  title="Software Architecture & AI Engineering Blog | Piyush Mehta"
  description="Technical writing from Piyush Mehta on software architecture, web platforms, AI workflows, migration strategy, and developer tooling."
  type="website"
  ogTemplate="blog"
  ogTheme="dark"
>
  <EditorialHeader
    class="writing-hero"
    eyebrow="Technical Writing"
    title="How I think through systems in public."
    description="Essays, implementation notes, and field reports about architecture, product engineering, platform reliability, AI workflows, and the human work of making software hold together."
    asideLabel="Writing themes"
  >
    <div slot="aside">
      <span>{publishedPosts.length} published pieces</span>
      <span>{avgReadingTime} min avg read</span>
      <span>{uniqueThemes} themes tracked</span>
      <strong>Current focus</strong>
      <ul>
        <li>Architecture decisions under real constraints</li>
        <li>Migration plans that reduce product risk</li>
        <li>Frontend systems that stay fast and maintainable</li>
        <li>AI workflows that respect trust boundaries</li>
      </ul>
    </div>
  </EditorialHeader>

  <section class="writing-featured" aria-label="Featured writing">
    <SectionHeader
      eyebrow="Start Here"
      title="Representative thinking."
      description="These pieces are useful signals for how I explain tradeoffs, document decisions, and turn ambiguous technical work into something teams can act on."
    />
    <div class="featured-grid">
      {writingHighlights.map((post, index) => (
        <article data-reveal data-reveal-stagger={String(index * 80)}>
          <span>{post.theme}</span>
          <h3><a href={post.href}>{post.title}</a></h3>
          <p>{post.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="reading-paths" aria-labelledby="reading-paths-heading">
    <SectionHeader
      eyebrow="Choose your outcome"
      title="Follow a path through the work."
      id="reading-paths-heading"
      description="Pick the problem in front of you, then move through three published field notes in order."
    />
    <div class="reading-paths__grid" data-reading-paths-grid>
      {readingPaths.map((path) => (
        <article
          class="reading-path-card"
          data-reading-path={path.id}
          aria-labelledby={`reading-path-${path.id}`}
        >
          <header>
            <p class="reading-path-card__label">Reading path</p>
            <h3 id={`reading-path-${path.id}`}>{path.intent}</h3>
            <p>{path.outcome}</p>
          </header>
          <ol>
            {path.steps.map((step, index) => (
              <li data-reading-path-step={String(index + 1)}>
                <p class="reading-path-step__label">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {step.stepLabel}
                </p>
                <h4><a href={step.href}>{step.title}</a></h4>
                <p class="reading-path-step__description">{step.description}</p>
                <div class="reading-path-step__meta">
                  <span>{step.readingTime} min read</span>
                  {step.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                </div>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="writing-index" aria-label="All writing">
    <SectionHeader
      eyebrow="Archive"
      title="Browse the full library."
      description="Evaluating engineering help? Explore consulting services, review project case studies, or read the résumé."
    />
    <div data-reveal data-reveal-delay="90">
      <BlogFilter posts={postsForFilter} />
    </div>
  </section>

</Layout>

<style>
  .writing-featured,
  .reading-paths,
  .writing-index {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 4.8rem;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .section-heading p,
  .featured-grid p {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .writing-featured,
  .reading-paths,
  .writing-index {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .section-heading {
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    max-width: 12ch;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
  }

  .section-heading p {
    max-width: 44rem;
    font-size: 1.05rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--color-card-border);
    background: var(--color-card-border);
  }

  .featured-grid article {
    min-height: 100%;
    background: var(--color-surface-raised);
    padding: clamp(1.15rem, 2.4vw, 1.7rem);
  }

  .featured-grid span {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-grid h3 {
    margin: 0.8rem 0;
    color: var(--color-text-primary);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .featured-grid a {
    color: inherit;
    text-decoration: none;
  }

  .featured-grid a:hover {
    color: var(--color-accent);
  }

  .reading-paths__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .reading-path-card {
    min-width: 0;
    border: 1px solid var(--color-card-border);
    border-radius: 0.75rem;
    background: var(--color-surface-raised);
    overflow: hidden;
  }

  .reading-path-card > header {
    padding: 1.5rem;
  }

  .reading-path-card__label,
  .reading-path-step__label {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reading-path-card__label {
    margin: 0 0 0.75rem;
  }

  .reading-path-card h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .reading-path-card header > p:last-child,
  .reading-path-step__description {
    color: var(--color-text-secondary);
    line-height: 1.625;
  }

  .reading-path-card header > p:last-child {
    margin: 0.75rem 0 0;
  }

  .reading-path-card ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-card-border);
    list-style: none;
  }

  .reading-path-card li {
    min-width: 0;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .reading-path-card li + li {
    border-top: 1px solid var(--color-card-border);
  }

  .reading-path-step__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
  }

  .reading-path-step__label span {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .reading-path-card h4 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
  }

  .reading-path-card h4 a {
    display: flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .reading-path-card h4 a:hover {
    color: var(--color-accent);
  }

  .reading-path-card h4 a:focus-visible {
    border-radius: 0.375rem;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .reading-path-step__description {
    margin: 0.5rem 0 0.75rem;
    font-size: 1rem;
  }

  .reading-path-step__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .reading-path-step__meta span {
    border: 1px solid var(--color-card-border);
    border-radius: 1rem;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.2;
  }

  @media (max-width: 860px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .reading-paths__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .writing-featured,
    .reading-paths,
    .writing-index {
      width: min(100% - 1rem, 1120px);
    }
  }
</style>
