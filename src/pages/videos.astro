---
import { videoHighlights, writingHighlights } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="Videos - Piyush Mehta"
  description="Selected technical videos from Piyush Mehta covering TypeScript, React, backend development, metadata, and portfolio engineering."
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
>
  <section class="page-hero" data-pagefind-body>
    <div class="page-hero__copy">
      <p class="eyebrow">Videos and workshops</p>
      <h1 data-pagefind-meta="title">Technical teaching, kept practical.</h1>
      <p class="lede">
        A small library from developer education work. Same through-line as portfolio: explain
        system, show tradeoff, make next step easier to take.
      </p>
      <div class="actions">
        <a class="btn-primary" href="https://youtube.com/@CoderWhoKnows">Open YouTube</a>
        <a class="btn-secondary" href="/blog/">Read writing</a>
      </div>
    </div>

    <aside class="principle-panel">
      <p class="eyebrow">Teaching style</p>
      <h2>Practical first, polished second.</h2>
      <p>
        Good technical education gives people a usable mental model, not just a finished demo.
      </p>
    </aside>
  </section>

  <section class="page-section">
    <div class="video-grid">
      {videoHighlights.map((video) => (
        <article class="video-card">
          <a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener">
            <img
              src={`https://img.youtube.com/vi/${video.id}/hqdefault.jpg`}
              alt={`Thumbnail for ${video.title}`}
              loading="lazy"
            />
          </a>
          <div>
            <span>{video.topic}</span>
            <h2>{video.title}</h2>
            <p>{video.description}</p>
            <a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener">
              Watch on YouTube
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="accent-cta">
    <div>
      <p class="eyebrow">Prefer reading?</p>
      <h2>Same teaching instinct, deeper notes.</h2>
      <p>Writing gives more room for constraints, diagrams, migrations, and system tradeoffs.</p>
    </div>
    <div class="writing-list">
      {writingHighlights.map((item) => (
        <a href={item.href}>
          <span>{item.theme}</span>
          <strong>{item.title}</strong>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-hero,
  .page-section,
  .accent-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(4rem, 8vw, 6rem) 3rem;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: var(--color-text-primary);
    letter-spacing: 0;
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(3.2rem, 8vw, 5.4rem);
    line-height: 1.02;
  }

  .accent-cta h2 {
    font-size: clamp(2.1rem, 4vw, 3.35rem);
    line-height: 1.05;
  }

  .lede,
  .principle-panel p,
  .video-card p,
  .accent-cta p {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .lede {
    max-width: 44rem;
    margin: 1.35rem 0 0;
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .principle-panel,
  .video-card {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
  }

  .principle-panel {
    padding: 1.25rem;
  }

  .principle-panel h2 {
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .page-section {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .video-card {
    overflow: hidden;
  }

  .video-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-darker);
  }

  .video-card div {
    padding: 1.1rem;
  }

  .video-card span,
  .writing-list span {
    display: block;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .video-card h2 {
    margin-top: 0.55rem;
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .video-card p {
    margin: 0.75rem 0 0;
  }

  .video-card a:last-child {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .accent-cta {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 1.5rem;
    margin-block: clamp(3rem, 7vw, 5rem);
    border: 1px solid var(--color-card-border);
    background: var(--color-accent);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .accent-cta .eyebrow,
  .accent-cta h2,
  .accent-cta p,
  .writing-list a,
  .writing-list span {
    color: var(--color-darker);
  }

  .writing-list {
    display: grid;
    gap: 1rem;
  }

  .writing-list a {
    display: block;
    border: 1px solid rgba(0, 0, 0, 0.18);
    padding: 1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .writing-list strong {
    display: block;
    margin-top: 0.45rem;
  }

  @media (max-width: 960px) {
    .page-hero,
    .accent-cta {
      grid-template-columns: 1fr;
    }

    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
