---
import Layout from '../layouts/Layout.astro';
import { caseStudies, reactStrengths } from '../data/portfolio';

const keywords = [
  'React Engineering',
  'Frontend Architecture',
  'TypeScript',
  'Web Platform Engineering',
  'Design Systems',
  'Performance Optimization',
  'Piyush Mehta',
];

const relevantWork = caseStudies.filter((study) =>
  study.stack.some((item) => ['React', 'TypeScript', 'React islands'].includes(item))
);
---

<Layout
  title="React Engineering | Piyush Mehta"
  description="React and TypeScript engineering from Piyush Mehta, focused on maintainable frontend architecture, product interfaces, and performance-sensitive web platforms."
  keywords={keywords}
  type="website"
  ogTemplate="tech"
  ogTheme="dark"
>
  <section class="page-hero" data-pagefind-body>
    <div class="page-hero__copy">
      <p class="eyebrow">React and TypeScript</p>
      <h1 data-pagefind-meta="title">React engineering as product infrastructure.</h1>
      <p class="lede">
        I use React where it earns runtime cost: complex interfaces, workflow tools, dashboards,
        design systems, and product surfaces that need careful interaction design.
      </p>
      <div class="actions">
        <a class="btn-primary" href="/projects/">See relevant work</a>
        <a class="btn-secondary" href="/contact-me/">Discuss frontend system</a>
      </div>
    </div>

    <aside class="principle-panel">
      <p class="eyebrow">Frontend posture</p>
      <h2>React should make product easier to change.</h2>
      <p>
        Strong frontend work is understandable state, accessible components, predictable data flow,
        and tests that catch real regressions.
      </p>
    </aside>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="eyebrow">Strengths</p>
      <h2>Important React decisions are often not about React.</h2>
    </div>
    <div class="feature-grid">
      {reactStrengths.map((strength) => (
        <article class="info-card">
          <h3>{strength.title}</h3>
          <p>{strength.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section split-grid">
    <div class="section-heading">
      <p class="eyebrow">Relevant work</p>
      <h2>Frontend work connected to systems.</h2>
    </div>
    <div class="stack-list">
      {relevantWork.map((study) => (
        <article class="info-card">
          <span>{study.eyebrow}</span>
          <h3>{study.title}</h3>
          <p>{study.summary}</p>
          <div>
            {study.stack.map((item) => <small>{item}</small>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="accent-cta">
    <div>
      <p class="eyebrow">Architecture fit</p>
      <h2>Framework choice should follow product shape.</h2>
      <p>
        This portfolio keeps Astro as foundation and uses React islands selectively. Same principle
        applies to product systems: choose runtime where interaction earns it.
      </p>
    </div>
    <a class="btn-dark" href="/contact-me/">Talk through React system</a>
  </section>
</Layout>

<style>
  .page-hero,
  .page-section,
  .accent-cta {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(4rem, 8vw, 6rem) 3rem;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--color-text-primary);
    letter-spacing: 0;
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(3.1rem, 8vw, 5.35rem);
    line-height: 1.02;
  }

  .section-heading h2,
  .accent-cta h2 {
    font-size: clamp(2.1rem, 4vw, 3.35rem);
    line-height: 1.05;
  }

  .lede,
  .principle-panel p,
  .info-card p,
  .accent-cta p {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .lede {
    max-width: 44rem;
    margin: 1.35rem 0 0;
    font-size: 1.15rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .principle-panel,
  .info-card {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    padding: 1.25rem;
  }

  .principle-panel h2 {
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .page-section {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }

  .section-heading {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.25rem;
  }

  .stack-list {
    display: grid;
    gap: 1rem;
  }

  .info-card h3 {
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .info-card p {
    margin: 0.75rem 0 0;
  }

  .info-card span {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .info-card div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .info-card small {
    border: 1px solid var(--color-card-border);
    padding: 0.35rem 0.55rem;
    color: var(--color-text-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .accent-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: end;
    margin-block: clamp(3rem, 7vw, 5rem);
    border: 1px solid var(--color-card-border);
    background: var(--color-accent);
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .accent-cta .eyebrow,
  .accent-cta h2,
  .accent-cta p {
    color: var(--color-darker);
  }

  .btn-dark {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    background: var(--color-darker);
    padding: 0.8rem 1.1rem;
    color: white;
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .page-hero,
    .feature-grid,
    .split-grid,
    .accent-cta {
      grid-template-columns: 1fr;
    }
  }
</style>
