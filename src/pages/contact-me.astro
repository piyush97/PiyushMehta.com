---
import ContactForm from '../components/ContactForm';
import Layout from '../layouts/Layout.astro';
import {
  contactChannels,
  contactPrompts,
  contactTopics,
} from '../data/portfolio';
---

<Layout
  title="Contact - Piyush Mehta"
  description="Contact Piyush Mehta about engineering leadership, AI workflows, web platforms, speaking, or technical writing."
  type="website"
  ogTemplate="modern"
  ogTheme="dark"
>
  <section class="contact-hero">
    <div class="contact-hero__copy">
      <p class="eyebrow" data-hero-eyebrow>Contact</p>
      <h1 data-hero-title>Bring hard engineering problems, not vague buzzwords.</h1>
      <p class="lede">
        Reach out for architecture reviews, AI workflow work, platform delivery, technical writing,
        or speaking. Best conversations start with context, constraints, and what “good” needs to
        look like.
      </p>
      <div class="contact-actions">
        <a class="btn-primary" href="mailto:contact@piyushmehta.com">Email Piyush</a>
        <a class="btn-secondary" href="/projects/">See work first</a>
      </div>
    </div>

    <aside class="contact-guidance" aria-label="What to include">
      <h2>Useful first message</h2>
      <ul>
        {contactPrompts.map((prompt) => <li>{prompt}</li>)}
      </ul>
    </aside>
  </section>

  <section class="contact-section">
    <div class="section-heading">
      <p class="eyebrow">Channels</p>
      <h2>Pick route that fits conversation.</h2>
    </div>
    <div class="channel-grid">
      {contactChannels.map((channel) => (
        <article class="info-card">
          <h3>{channel.label}</h3>
          <p>{channel.note}</p>
          <a href={channel.href}>Open {channel.label}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="contact-section split-grid">
    <div>
      <div class="section-heading">
        <p class="eyebrow">Good Fit</p>
        <h2>Work I’m happy to discuss.</h2>
      </div>
      <div class="topic-list">
        {contactTopics.map((topic) => (
          <article class="info-card">
            <h3>{topic.title}</h3>
            <p>{topic.detail}</p>
          </article>
        ))}
      </div>
    </div>

    <div>
      <div class="section-heading">
        <p class="eyebrow">Form</p>
        <h2>Prefer structured outreach.</h2>
        <p>
          Form opens an email draft with your details prefilled. Nothing gets silently “submitted”
          behind scenes.
        </p>
      </div>
      <div class="form-shell">
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-hero,
  .contact-section {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(4rem, 8vw, 6rem) 3rem;
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-hero h1,
  .section-heading h2,
  .contact-guidance h2 {
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .contact-hero h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 7vw, 5.15rem);
  }

  .lede,
  .section-heading p,
  .info-card p,
  .contact-guidance li {
    color: var(--color-text-secondary);
  }

  .lede {
    max-width: 44rem;
    margin: 1.35rem 0 0;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .contact-guidance,
  .info-card,
  .form-shell {
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
  }

  .contact-guidance {
    padding: 1.25rem;
  }

  .contact-guidance h2 {
    font-size: 1.3rem;
  }

  .contact-guidance ul {
    margin: 1rem 0 0;
    padding-left: 1.2rem;
  }

  .contact-guidance li + li {
    margin-top: 0.8rem;
  }

  .contact-section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  .section-heading {
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    font-size: clamp(2.1rem, 4vw, 3.25rem);
  }

  .section-heading p {
    margin: 0.9rem 0 0;
    line-height: 1.7;
  }

  .channel-grid,
  .topic-list {
    display: grid;
    gap: 1rem;
  }

  .channel-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .topic-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .split-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .info-card,
  .form-shell {
    padding: 1.2rem;
  }

  .info-card h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1.1rem;
  }

  .info-card p {
    margin: 0.7rem 0 0;
    line-height: 1.7;
  }

  .info-card a {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .info-card a:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 960px) {
    .contact-hero,
    .split-grid,
    .channel-grid,
    .topic-list {
      grid-template-columns: 1fr;
    }
  }
</style>
