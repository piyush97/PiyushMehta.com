---
import ContactForm from '../components/ContactForm';
import EditorialHeader from '../components/EditorialHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { contactChannels, contactPrompts, contactTopics } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="Contact - Piyush Mehta"
  description="Contact Piyush Mehta about engineering leadership, AI workflows, web platforms, speaking, or technical writing."
  type="website"
  ogTemplate="modern"
  ogTheme="dark"
>
  <EditorialHeader
    class="contact-hero"
    eyebrow="Contact"
    title="Bring hard engineering problems, not vague buzzwords."
    description="Reach out for architecture reviews, AI workflow work, platform delivery, technical writing, or speaking. Best conversations start with context, constraints, and what “good” needs to look like."
    actions={[
      { href: '#contact-form', label: 'Send a message' },
      { href: '/projects/', label: 'See work first', variant: 'secondary' },
    ]}
    asideLabel="Useful first message"
  >
    <div slot="aside">
      <span>Useful first message</span>
      <strong>Context makes the first reply useful.</strong>
      <ul>
        {contactPrompts.map((prompt) => <li>{prompt}</li>)}
      </ul>
    </div>
  </EditorialHeader>

  <section
    id="contact-form"
    class="contact-section contact-form-section"
    aria-labelledby="contact-form-heading"
    tabindex="-1"
    data-contact-section="form"
  >
    <SectionHeader
      eyebrow="Project brief"
      title="Send a message directly."
      id="contact-form-heading"
      description="Use the form to reach my inbox. It is rate-limited and spam-filtered; the useful details are the problem, constraints, and what a good outcome would make possible."
    />
    <div class="form-shell">
      <ContactForm client:load />
    </div>
  </section>

  <section class="contact-section" aria-labelledby="channels-heading" data-contact-section="channels">
    <SectionHeader
      eyebrow="Channels"
      title="Pick route that fits conversation."
      id="channels-heading"
      description="Use a direct channel when the question is simple, or send the project brief above when context matters."
    />
    <div class="channel-register">
      {contactChannels.map((channel) => (
        <article class="channel-record">
          <h3>{channel.label}</h3>
          <p>{channel.note}</p>
          <a href={channel.href}>
            Open {channel.label}
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="contact-section" aria-labelledby="topics-heading" data-contact-section="topics">
    <SectionHeader
      eyebrow="Good fit"
      title="Work I’m happy to discuss."
      id="topics-heading"
      description="These are useful starting points, not a gate. If the problem is adjacent but important, say what is actually stuck."
    />
    <div class="topic-register">
      {contactTopics.map((topic) => (
        <article class="topic-record">
          <h3>{topic.title}</h3>
          <p>{topic.detail}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .contact-section {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) 0;
    scroll-margin-top: 5rem;
  }

  .contact-form-section {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .contact-form-section :global(.section-heading) {
    max-width: 50rem;
  }

  .form-shell {
    max-width: 52rem;
    margin-top: 2.25rem;
    border-block: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .channel-register {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2.25rem;
    border: 1px solid var(--color-card-border);
    background: var(--color-card-border);
  }

  .channel-record {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 1.25rem;
    background: var(--color-bg);
  }

  .channel-record h3,
  .topic-record h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .channel-record p,
  .topic-record p {
    margin: 0.7rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .channel-record a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .channel-record a:hover,
  .channel-record a:focus-visible {
    color: var(--color-text-primary);
  }

  .channel-record svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--motion-fast, 150ms) ease;
  }

  .channel-record a:hover svg,
  .channel-record a:focus-visible svg {
    transform: translateX(0.2rem);
  }

  .topic-register {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2.25rem;
    border-block: 1px solid var(--color-card-border);
    background: var(--color-card-border);
  }

  .topic-record {
    min-width: 0;
    padding: 1.25rem;
    background: var(--color-bg);
  }

  @media (max-width: 900px) {
    .channel-register,
    .topic-register {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .contact-section {
      width: min(100% - 1rem, 1120px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-record svg {
      transition: none;
    }

    .channel-record a:hover svg,
    .channel-record a:focus-visible svg {
      transform: none;
    }
  }
</style>
