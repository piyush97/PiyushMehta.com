---
export interface Props {
  heading?: string;
}

const { heading = 'Get new posts by email' } = Astro.props;
---

<section class="subscribe" aria-labelledby="subscribe-heading" data-subscribe>
  <h2 id="subscribe-heading" class="subscribe__heading">{heading}</h2>
  <p class="subscribe__lede" id="subscribe-lede">
    One email per new post, with a link to read it. You confirm by email first and can unsubscribe
    from any message. The <a href="/rss.xml">RSS feed</a> stays available.
  </p>

  <form class="subscribe__form" method="post" action="/api/subscribe" novalidate data-subscribe-form>
    <label class="subscribe__honeypot" aria-hidden="true">
      Leave this field empty
      <input type="text" name="website" autocomplete="off" tabindex="-1" />
    </label>
    <div class="subscribe__row">
      <label class="subscribe__label" for="subscribe-email">Email address</label>
      <div class="subscribe__controls">
        <input
          id="subscribe-email"
          class="subscribe__input"
          type="email"
          name="email"
          inputmode="email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby="subscribe-lede subscribe-status"
        />
        <button class="subscribe__button" type="submit" data-subscribe-submit>Subscribe</button>
      </div>
    </div>
    <div data-subscribe-turnstile></div>
    <p
      id="subscribe-status"
      class="subscribe__status"
      role="status"
      aria-live="polite"
      data-state="idle"
      data-subscribe-status
      hidden
    >
    </p>
  </form>
  <noscript><p class="subscribe__status">Subscribing needs JavaScript for spam verification. Use the RSS feed instead.</p></noscript>
</section>

<script>
  import { requestTurnstileToken } from '../utils/turnstile';

  type State = 'idle' | 'empty' | 'sending' | 'success' | 'error';

  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const MESSAGES: Record<Exclude<State, 'idle'>, string> = {
    empty: 'Enter a valid email address.',
    sending: 'Verifying your browser and sending the confirmation email...',
    success: 'Check your inbox to confirm. Nothing is sent to you until you click the link.',
    error: 'Could not subscribe.',
  };

  function initSubscribeForm(root: HTMLElement) {
    if (root.dataset.subscribeReady === 'true') return;
    root.dataset.subscribeReady = 'true';

    const form = root.querySelector<HTMLFormElement>('[data-subscribe-form]');
    const status = root.querySelector<HTMLElement>('[data-subscribe-status]');
    const submit = root.querySelector<HTMLButtonElement>('[data-subscribe-submit]');
    const host = root.querySelector<HTMLElement>('[data-subscribe-turnstile]');
    const input = form?.elements.namedItem('email') as HTMLInputElement | null;
    const honeypot = form?.elements.namedItem('website') as HTMLInputElement | null;
    if (!form || !status || !submit || !host || !input) return;

    let busy = false;

    const show = (state: State, detail = '') => {
      status.dataset.state = state;
      status.hidden = state === 'idle';
      status.textContent = state === 'idle' ? '' : `${MESSAGES[state]}${detail ? ` ${detail}` : ''}`;
      input.setAttribute('aria-invalid', state === 'empty' || state === 'error' ? 'true' : 'false');
      submit.disabled = state === 'sending';
      form.setAttribute('aria-busy', state === 'sending' ? 'true' : 'false');
    };

    input.addEventListener('input', () => {
      if (!busy && status.dataset.state !== 'idle' && status.dataset.state !== 'success') show('idle');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (busy) return;

      const email = input.value.trim();
      if (!email || !EMAIL_PATTERN.test(email)) {
        show('empty', email ? 'Check the format, for example name@example.com.' : '');
        input.focus();
        return;
      }

      busy = true;
      show('sending');
      try {
        const config = await fetch('/api/chat/session', { signal: AbortSignal.timeout(10_000) });
        if (!config.ok) throw new Error('Verification unavailable.');
        const { siteKey } = (await config.json()) as { siteKey?: unknown };
        if (typeof siteKey !== 'string') throw new Error('Verification unavailable.');
        const token = await requestTurnstileToken(host, siteKey, 'newsletter-signup');

        const res = await fetch('/api/subscribe', {
          method: 'POST',
          signal: AbortSignal.timeout(35_000),
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website: honeypot?.value ?? '', token }),
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (!res.ok || !data.ok) {
          show('error', data.error ?? 'Try again in a few minutes.');
          input.focus();
          return;
        }
        input.value = '';
        show('success');
      } catch (error) {
        show(
          'error',
          error instanceof Error && error.message.startsWith('Verification')
            ? `${error.message} Retry, or use the RSS feed.`
            : 'Check your connection and try again.',
        );
        input.focus();
      } finally {
        busy = false;
        if (status.dataset.state === 'sending') show('idle');
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-subscribe]').forEach(initSubscribeForm);
  });
</script>

<style>
  .subscribe {
    margin-top: 2rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--color-card-border);
  }

  .subscribe__heading {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .subscribe__lede {
    max-width: 60ch;
    margin: 0.5rem 0 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .subscribe__lede a {
    display: inline-block;
    min-height: 2.75rem;
    line-height: 2.75rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .subscribe__form {
    display: grid;
    gap: 0.75rem;
  }

  .subscribe__honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .subscribe__label {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--color-text-primary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .subscribe__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .subscribe__input {
    flex: 1 1 16rem;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-card-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text-primary);
    font: inherit;
  }

  .subscribe__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .subscribe__input[aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  .subscribe__button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    border: 0;
    border-radius: 6px;
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    transition: background-color var(--motion-fast, 150ms) ease;
  }

  .subscribe__button:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-accent) 88%, var(--color-text-primary));
  }

  .subscribe__button:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .subscribe__button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .subscribe__status {
    margin: 0;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-card-border);
    border-radius: 6px;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .subscribe__status[hidden] {
    display: none;
  }

  .subscribe__status[data-state='success'] {
    border-color: var(--color-success);
  }

  .subscribe__status[data-state='error'],
  .subscribe__status[data-state='empty'] {
    border-color: var(--color-danger);
    background: var(--color-danger-surface, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .subscribe__button {
      transition: none;
    }
  }
</style>
