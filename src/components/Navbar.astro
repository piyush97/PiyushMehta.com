---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/resume/', label: 'Resume' },
  { href: '/contact-me/', label: 'Contact' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<nav class="site-nav" aria-label="Primary navigation" data-reveal>
  <a class="site-nav__brand" href="/" aria-label="Piyush Mehta home">
    <span>PM</span>
    <strong>Piyush Mehta</strong>
  </a>

  <div class="site-nav__links">
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </div>

  <button class="theme-button" type="button" aria-label="Toggle theme" data-theme-toggle>
    <span aria-hidden="true">◐</span>
  </button>
</nav>

<script is:inline>
  const themeButton = document.querySelector('[data-theme-toggle]');
  themeButton?.addEventListener('click', () => {
    const root = document.documentElement;
    const isLight = root.classList.contains('professional-light');
    const nextTheme = isLight ? 'professional-dark' : 'professional-light';
    root.classList.remove('professional-dark', 'professional-light', 'light', 'dark');
    root.classList.add(nextTheme);
    if (nextTheme === 'professional-light') {
      root.classList.add('light');
    }
    localStorage.setItem('theme', nextTheme);
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 4rem;
    padding: 0.65rem max(1rem, calc((100vw - 1120px) / 2));
    border-bottom: 1px solid var(--color-card-border);
    background: rgba(var(--color-bg-rgb), 0.86);
    backdrop-filter: blur(16px);
    animation: nav-slide-in var(--motion-slow, 560ms)
      var(--motion-spring, cubic-bezier(0.2, 0.9, 0.2, 1));
  }

  .site-nav__brand,
  .site-nav__links,
  .theme-button {
    display: flex;
    align-items: center;
  }

  .site-nav__brand {
    gap: 0.75rem;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .site-nav__brand span {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .site-nav__brand strong {
    font-size: 0.95rem;
  }

  .site-nav__links {
    justify-content: center;
    gap: 0.35rem;
  }

  .site-nav__links a {
    padding: 0.55rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 0.35rem;
    transition:
      color var(--motion-fast, 150ms) ease,
      background-color var(--motion-fast, 150ms) ease,
      transform var(--motion-fast, 150ms) ease;
  }

  .site-nav__links a:hover,
  .site-nav__links a[aria-current='page'] {
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.08);
    transform: translateY(-1px);
  }

  .theme-button {
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .theme-button:hover {
    color: var(--color-accent);
    transform: rotate(-10deg) scale(1.03);
    transition:
      transform var(--motion-fast, 150ms) ease,
      color var(--motion-fast, 150ms) ease;
  }

  @keyframes nav-slide-in {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 720px) {
    .site-nav {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand theme"
        "links links";
      gap: 0.55rem 1rem;
    }

    .site-nav__brand {
      grid-area: brand;
    }

    .site-nav__links {
      grid-area: links;
      grid-column: 1 / -1;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.15rem 0.25rem;
      overflow: visible;
    }

    .site-nav__links a {
      padding: 0.42rem 0.5rem;
      font-size: 0.86rem;
    }

    .theme-button {
      grid-area: theme;
      justify-self: end;
    }
  }
</style>
