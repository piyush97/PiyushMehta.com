---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/newsletter/', label: 'Newsletter' },
  { href: '/resume/', label: 'Resume' },
  { href: '/contact-me/', label: 'Contact' },
];

const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<nav class="site-nav" aria-label="Primary navigation" data-reveal>
  <a class="site-nav__brand" href="/" aria-label="Piyush Mehta home">
    <span>PM</span>
    <strong>Piyush Mehta</strong>
  </a>

  <div class="site-nav__links" id="desktop-nav-links">
    {
      navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </div>

  <div class="site-nav__actions">
    <button class="theme-button" type="button" aria-label="Toggle theme" data-theme-toggle>
      <span aria-hidden="true">◐</span>
    </button>

    <button class="hamburger" type="button" aria-label="Toggle menu" aria-expanded="false" data-mobile-toggle>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>
  </div>
</nav>

<div class="mobile-overlay" data-mobile-overlay hidden></div>

<div class="mobile-panel" data-mobile-panel hidden>
  <div class="mobile-panel__inner">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class={`mobile-nav-link${isActive(item.href) ? ' active' : ''}`}
          data-mobile-link
        >
          {item.label}
        </a>
      ))
    }
  </div>
</div>

<script is:inline>
  (() => {
    const toggle = document.querySelector('[data-mobile-toggle]');
    const panel = document.querySelector('[data-mobile-panel]');
    const overlay = document.querySelector('[data-mobile-overlay]');
    const links = document.querySelectorAll('[data-mobile-link]');
    let open = false;

    if (!toggle || !panel || !overlay) return;

    function show() {
      open = true;
      panel.removeAttribute('hidden');
      overlay.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      panel.offsetHeight;
      panel.classList.add('visible');
      overlay.classList.add('visible');
    }

    function hide() {
      open = false;
      panel.classList.remove('visible');
      overlay.classList.remove('visible');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(() => { if (!open) { panel.setAttribute('hidden', ''); overlay.setAttribute('hidden', ''); } }, 300);
    }

    toggle.addEventListener('click', () => (open ? hide() : show()));
    links.forEach((link) => link.addEventListener('click', hide));
    overlay.addEventListener('click', hide);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) hide(); });
    window.addEventListener('resize', () => { if (window.innerWidth >= 768 && open) hide(); });
  })();
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 4rem;
    padding: 0.65rem max(1rem, calc((100vw - 1120px) / 2));
    border-bottom: 1px solid var(--color-card-border);
    background: rgba(var(--color-bg-rgb), 0.86);
    backdrop-filter: blur(16px);
    animation: nav-slide-in var(--motion-slow, 560ms) var(--motion-spring, cubic-bezier(0.2, 0.9, 0.2, 1));
  }

  .site-nav__brand, .site-nav__links, .site-nav__actions { display: flex; align-items: center; }

  .site-nav__brand {
    gap: 0.75rem;
    min-height: 2.75rem;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .site-nav__brand span {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .site-nav__brand strong { font-size: 0.95rem; }

  .site-nav__links { justify-content: center; gap: 0.35rem; }

  .site-nav__links a {
    padding: 0.55rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 0.35rem;
    transition: color var(--motion-fast, 150ms) ease, background-color var(--motion-fast, 150ms) ease, transform var(--motion-fast, 150ms) ease;
  }

  .site-nav__links a:hover,
  .site-nav__links a[aria-current='page'] {
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.08);
    transform: translateY(-1px);
  }

  .site-nav__actions { gap: 0.5rem; }

  .theme-button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .theme-button:hover {
    color: var(--color-accent);
    transform: rotate(-10deg) scale(1.03);
    transition: transform var(--motion-fast, 150ms) ease, color var(--motion-fast, 150ms) ease;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    cursor: pointer;
    padding: 6px;
  }

  .hamburger__line {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .hamburger[aria-expanded='true'] .hamburger__line:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hamburger[aria-expanded='true'] .hamburger__line:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded='true'] .hamburger__line:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 48;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .mobile-overlay.visible { opacity: 1; }

  .mobile-panel {
    position: fixed;
    top: 4rem;
    left: 0;
    right: 0;
    z-index: 49;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-card-border);
    transform: translateY(-100%);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
  }
  .mobile-panel.visible { transform: translateY(0); opacity: 1; }

  .mobile-panel__inner {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.85rem 1rem;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: background-color var(--motion-fast, 150ms) ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.08);
  }

  @keyframes nav-slide-in {
    from { opacity: 0; transform: translateY(-14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 767px) {
    .site-nav__links { display: none; }
    .hamburger { display: flex; }
  }
</style>
