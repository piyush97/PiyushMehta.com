---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Work' },
  { href: '/blog', label: 'Writing' },
  { href: '/lab', label: 'Lab', title: 'Interactive demos' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact-me', label: 'Contact' },
  { href: 'https://understory.piyushmehta.com/', label: 'Understory', external: true, title: 'Understory: engineering blogs, explained' },
];

const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`));
---

<nav class="site-nav" aria-label="Primary navigation" data-reveal>
  <a class="site-nav__brand" href="/" aria-label="Piyush Mehta home">
    <span>PM</span>
    <strong>Piyush Mehta</strong>
  </a>

  {pathname === '/' && (
    <span class="site-nav__edition">
      Piyush Mehta / Engineer’s Portfolio / 2026
    </span>
  )}

  <div class="site-nav__links" id="desktop-nav-links">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          title={item.title}
        >
          {item.label}
          {item.external && <span aria-hidden="true"> ↗</span>}
        </a>
      ))
    }
  </div>

  <div class="site-nav__actions">
    <a class="ask-button" href="/ask" aria-current={pathname.startsWith('/ask') ? 'page' : undefined}><span aria-hidden="true">✦</span> Ask</a>
    <button class="theme-button" type="button" id="theme-toggle-btn" aria-label="Toggle theme" aria-pressed="false">
      <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>

    <button class="hamburger" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-panel" data-mobile-toggle>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>
  </div>
</nav>

<dialog class="mobile-panel" id="mobile-panel" data-mobile-panel closedby="any" aria-label="Site menu">
  <div class="mobile-panel__inner">
    <form method="dialog" class="mobile-panel__close-row">
      <button class="mobile-panel__close" type="submit" aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </form>
    <a class={`mobile-nav-link${pathname.startsWith('/ask') ? ' active' : ''}`} href="/ask" aria-current={pathname.startsWith('/ask') ? 'page' : undefined} data-mobile-link><span aria-hidden="true">✦</span> Ask Piyush</a>
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class={`mobile-nav-link${isActive(item.href) ? ' active' : ''}`}
          aria-current={isActive(item.href) ? 'page' : undefined}
          data-mobile-link
        >
          {item.label}
          {item.external && <span aria-hidden="true"> ↗</span>}
        </a>
      ))
    }
    <button class="mobile-theme-button" type="button" id="mobile-theme-toggle-btn" aria-label="Toggle theme" aria-pressed="false">
      <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <span>Toggle theme</span>
    </button>
  </div>
</dialog>

<script is:inline>
  (() => {
    if (document.documentElement.dataset.mobileMenuBound === 'true') return;
    document.documentElement.dataset.mobileMenuBound = 'true';

    // Native modal <dialog>: the browser makes the page inert, traps focus,
    // handles Escape and returns focus to the toggle on close.
    const getElements = () => {
      const toggle = document.querySelector('[data-mobile-toggle]');
      const panel = document.querySelector('[data-mobile-panel]');
      if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLDialogElement)) return null;
      return { toggle, panel };
    };

    // Exit animation needs `overlay` + discrete display transitions (Chromium only);
    // elsewhere, play the exit via [data-closing] before calling close().
    const nativeExit = () => CSS.supports('overlay', 'auto');
    const closePanel = async (panel) => {
      if (!panel.open) return;
      if (!nativeExit()) {
        panel.setAttribute('data-closing', '');
        const animations = panel.getAnimations({ subtree: true });
        if (animations.length) {
          await Promise.race([
            Promise.allSettled(animations.map((animation) => animation.finished)),
            new Promise((resolve) => setTimeout(resolve, 600)),
          ]);
        }
        panel.removeAttribute('data-closing');
      }
      panel.close();
    };

    // closedby="any" fallback (Safari): close on a press and release outside the panel.
    const outside = (event, panel) => {
      const rect = panel.getBoundingClientRect();
      return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
    };
    let pressedOutside = false;

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const elements = getElements();
      if (!elements) return;
      const { toggle, panel } = elements;

      if (event.target.closest('[data-mobile-toggle]') === toggle) {
        panel.showModal();
        toggle.setAttribute('aria-expanded', 'true');
        return;
      }
      if (event.target.closest('[data-mobile-panel] form[method="dialog"] button')) {
        event.preventDefault();
        closePanel(panel);
        return;
      }
      if (event.target.closest('[data-mobile-panel] a[href]')) panel.close();
    });

    // Escape and light dismiss fire `cancel`; route them through the animated close.
    document.addEventListener('cancel', (event) => {
      if (!(event.target instanceof HTMLDialogElement) || !event.target.matches('[data-mobile-panel]')) return;
      if (event.cancelable) {
        event.preventDefault();
        closePanel(event.target);
      }
    }, true);

    document.addEventListener('close', (event) => {
      if (!(event.target instanceof Element) || !event.target.matches('[data-mobile-panel]')) return;
      getElements()?.toggle.setAttribute('aria-expanded', 'false');
    }, true);

    if (!('closedBy' in HTMLDialogElement.prototype)) {
      document.addEventListener('pointerdown', (event) => {
        const panel = getElements()?.panel;
        pressedOutside = !!panel?.open && event.target === panel && outside(event, panel);
      });
      document.addEventListener('pointerup', (event) => {
        const panel = getElements()?.panel;
        if (panel?.open && pressedOutside && event.target === panel && outside(event, panel)) closePanel(panel);
        pressedOutside = false;
      });
    }

    window.addEventListener('resize', () => {
      const panel = getElements()?.panel;
      if (panel?.open && window.innerWidth >= 768) panel.close();
    });
  })();
</script>

<script is:inline>
  (() => {
    if (document.documentElement.dataset.themeControlsBound === 'true') return;
    document.documentElement.dataset.themeControlsBound = 'true';

    const root = document.documentElement;

    function syncColorScheme(isDark) {
      const colorScheme = isDark ? 'dark' : 'light';
      root.style.colorScheme = colorScheme;
      document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', colorScheme);
    }

    function syncIcons() {
      const isDark = root.classList.contains('professional-dark');
      document.querySelectorAll('#theme-toggle-btn, #mobile-theme-toggle-btn').forEach((button) => button.setAttribute('aria-pressed', String(isDark)));
      document.querySelectorAll('.theme-icon-sun').forEach((icon) => icon.classList.toggle('hidden', !isDark));
      document.querySelectorAll('.theme-icon-moon').forEach((icon) => icon.classList.toggle('hidden', isDark));
    }

    syncIcons();
    document.addEventListener('astro:page-load', syncIcons);
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', syncIcons);

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const btn = event.target.closest('#theme-toggle-btn, #mobile-theme-toggle-btn');
      if (!btn) return;

      const currentlyDark = root.classList.contains('professional-dark');
      root.classList.remove('professional-dark', 'professional-light', 'light', 'dark');
      if (currentlyDark) {
        root.classList.add('professional-light', 'light');
        try { localStorage.setItem('theme', 'professional-light'); } catch {}
      } else {
        root.classList.add('professional-dark');
        root.classList.remove('light');
        try { localStorage.setItem('theme', 'professional-dark'); } catch {}
      }
      syncColorScheme(!currentlyDark);
      syncIcons();
      btn.style.transform = 'scale(0.9)';
      setTimeout(() => { btn.style.transform = ''; }, 150);
    });
  })();
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 4rem;
    padding: 0.65rem max(1rem, calc((100vw - 1120px) / 2));
    border-bottom: 1px solid var(--color-card-border);
    background: rgba(var(--color-bg-rgb), 0.86);
    backdrop-filter: blur(16px);
    animation: nav-slide-in var(--motion-slow, 560ms) var(--motion-ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .site-nav__brand, .site-nav__links, .site-nav__actions { display: flex; align-items: center; }

  .site-nav__edition {
    display: none;
    justify-self: center;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-nav__brand {
    gap: 0.75rem;
    min-height: 2.75rem;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .site-nav__brand span {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .site-nav__brand strong { font-size: 0.95rem; }

  .site-nav__links { justify-content: center; gap: 0.35rem; }

  .site-nav__links a {
    padding: 0.55rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 0.35rem;
    transition: color var(--motion-fast, 150ms) ease, background-color var(--motion-fast, 150ms) ease, transform var(--motion-fast, 150ms) ease;
  }

  .site-nav__links a:hover,
  .site-nav__links a[aria-current='page'] {
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.08);
    transform: translateY(-1px);
  }

  .site-nav__actions { gap: 0.5rem; }

  .theme-button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    cursor: pointer;
    border-radius: 0.35rem;
    transition: color var(--motion-fast, 150ms) ease, border-color var(--motion-fast, 150ms) ease, transform var(--motion-fast, 150ms) ease;
  }
  .theme-button:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .theme-button svg {
    position: absolute;
  }
  .theme-icon-sun.hidden,
  .theme-icon-moon.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-card-border);
    background: var(--color-surface-raised);
    cursor: pointer;
    padding: 6px;
  }

  .hamburger__line {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .hamburger[aria-expanded='true'] .hamburger__line:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hamburger[aria-expanded='true'] .hamburger__line:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded='true'] .hamburger__line:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* Native modal <dialog>: page is inert, focus trapped, Escape + focus return built in. */
  .mobile-panel {
    inset: 4rem 0 auto 0;
    width: auto;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--color-card-border);
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    background: var(--color-bg);
    color: var(--color-text-primary);
    opacity: 0;
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  .mobile-panel:is([open]):where(:not([data-closing])) {
    opacity: 1;

    @starting-style {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-panel {
      transform: translateY(-1rem);
    }

    .mobile-panel:is([open]):where(:not([data-closing])) {
      transform: translateY(0);

      @starting-style {
        transform: translateY(-1rem);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-panel {
      transition-duration: 0.1s;
    }
  }

  .mobile-panel:modal {
    overscroll-behavior: contain;
  }

  .mobile-panel::backdrop {
    background-color: rgb(0 0 0 / 0);
    overflow: hidden;
    overscroll-behavior: contain;
    transition-property: background-color, display, overlay;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  .mobile-panel:is([open]):where(:not([data-closing]))::backdrop {
    background-color: rgb(0 0 0 / 0.4);

    @starting-style {
      background-color: rgb(0 0 0 / 0);
    }
  }

  .mobile-panel__close-row {
    display: flex;
    justify-content: flex-end;
  }

  .mobile-panel__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-card-border);
    border-radius: 6px;
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .mobile-panel__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .mobile-panel__inner {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.85rem 1rem;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: background-color var(--motion-fast, 150ms) ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-accent);
    background: rgba(var(--color-accent-rgb), 0.08);
  }

  .mobile-theme-button { display: none; }

  :global(html[data-navigated]) .site-nav {
    animation: none;
  }

  @keyframes nav-slide-in {
    from { opacity: 0; transform: translateY(-14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Tablet: all eight links need ~700px, so drop the wordmark (PM mark stays)
     and tighten links to keep the theme button inside the viewport. */
  @media (min-width: 768px) and (max-width: 1039px) {
    .site-nav__brand strong { display: none; }
    .site-nav__links { gap: 0; }
    .site-nav__links a { padding-inline: 0.4rem; font-size: 0.8rem; }
  }

  .site-nav__links a[aria-current='page'],
  .mobile-nav-link[aria-current='page'],
  .ask-button[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ask-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid rgba(var(--color-accent-rgb), 0.55);
    border-radius: 0.375rem;
    color: var(--color-accent);
    font-weight: 800;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-color 160ms ease-out;
  }
  .ask-button:hover,
  .ask-button[aria-current='page'] {
    background: rgba(var(--color-accent-rgb), 0.12);
  }
  .ask-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .site-nav__actions { gap: 0.5rem; }
  @media (min-width: 768px) and (max-width: 1039px) {
    .ask-button { padding-inline: 0.6rem; }
  }

  @media (max-width: 767px) {
    .ask-button { display: none; }
    .site-nav { grid-template-columns: auto 1fr auto; }
    .site-nav__links { display: none; }
    .site-nav__actions { justify-self: end; }
    .site-nav__edition {
      display: block;
      max-width: 11rem;
      overflow: visible;
      font-size: 0.5rem;
      line-height: 1.1;
      letter-spacing: 0.03em;
      text-align: center;
      white-space: normal;
    }
    .site-nav__brand strong,
    .site-nav .theme-button { display: none; }
    .site-nav__brand span {
      width: 2.75rem;
      height: 2.75rem;
      border-color: var(--color-accent);
      font-size: 1rem;
    }
    .hamburger {
      width: 2.75rem;
      height: 2.75rem;
      border: 0;
      background: transparent;
    }
    .mobile-theme-button {
      display: block;
      margin-top: 0.5rem;
      padding: 0.85rem 1rem;
      border: 1px solid var(--color-card-border);
      background: var(--color-surface-raised);
      color: var(--color-text-primary);
      font: inherit;
      text-align: left;
    }
    .mobile-theme-button:not([hidden]) { display: flex; align-items: center; gap: 0.6rem; width: 100%; }
    .mobile-theme-button svg.hidden { display: none; }
    .hamburger { display: flex; }
  }
</style>
