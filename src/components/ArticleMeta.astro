---
export interface Props {
  title: string;
  author?: string;
  readingTime?: number;
  date?: Date;
  tags?: string[];
  url?: string;
}
const { title, author, readingTime, date, tags = [], url = Astro.url.toString() } = Astro.props;
const shareLinks = [
  { name: 'LinkedIn', url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
  { name: 'X / Twitter', url: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}` },
  { name: 'Facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}` },
];
---
<div class="article-meta">
  <div class="article-meta__line">
    <div class="article-meta__byline">
      {author && <span itemprop="author" itemscope itemtype="https://schema.org/Person"><span itemprop="name">{author}</span></span>}
      {date && <time itemprop="datePublished" datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'America/Toronto' })}</time>}
      {readingTime && <span>{readingTime} min read</span>}
    </div>
    <details class="article-share">
      <summary>Share <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 16V3m-5 5 5-5 5 5M5 14v6h14v-6" /></svg></summary>
      <div class="article-share__options">
        {shareLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>)}
        <button type="button" data-copy-article data-url={url}>Copy link</button>
        <span class="article-share__status" role="status" aria-live="polite"></span>
      </div>
    </details>
  </div>
  {tags.length > 0 && <nav class="article-meta__topics" aria-label="Article topics">{tags.map((tag) => <a href={`/blog/?theme=${encodeURIComponent(tag)}`}>{tag}</a>)}</nav>}
</div>
<script>
  function initializeArticleSharing() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-article]').forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      button.addEventListener('click', async () => {
        const status = button.parentElement?.querySelector<HTMLElement>('[role="status"]');
        try {
          await navigator.clipboard.writeText(button.dataset.url || window.location.href);
          if (status) status.textContent = 'Link copied.';
        } catch {
          if (status) status.textContent = 'Could not copy. Copy the address from your browser.';
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initializeArticleSharing);
  initializeArticleSharing();
</script>
<style>
  .article-meta { text-align: left; font-size: 0.875rem; color: var(--color-text-secondary); }
  .article-meta__line { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .article-meta__byline { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding-block: 0.75rem; }
  .article-meta__byline > :first-child { color: var(--color-text-primary); font-weight: 700; }
  .article-meta__topics { display: flex; flex-wrap: wrap; column-gap: 1rem; margin-top: 0.5rem; }
  .article-meta__topics a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 0.3em; }
  .article-meta__topics a:hover { color: var(--color-accent); }
  .article-share { position: relative; flex-shrink: 0; }
  .article-share summary { display: flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; cursor: pointer; color: var(--color-text-primary); list-style: none; }
  .article-share summary::-webkit-details-marker { display: none; }
  .article-share svg { width: 1.125rem; height: 1.125rem; }
  .article-share__options { position: absolute; right: 0; top: 100%; z-index: 10; width: 13rem; padding: 0.5rem; border: 1px solid var(--color-card-border); border-radius: 0.5rem; background: var(--color-surface-raised); }
  .article-share__options a, .article-share__options button { display: flex; align-items: center; width: 100%; min-height: 2.75rem; padding: 0.5rem 0.75rem; color: var(--color-text-primary); font: inherit; text-align: left; background: transparent; border: 0; cursor: pointer; }
  .article-share__options a:hover, .article-share__options button:hover { background: var(--color-bg); }
  .article-share__status { display: block; padding-inline: 0.75rem; line-height: 1.5; }
  :is(a, button, summary):focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
</style>
