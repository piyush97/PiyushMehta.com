---
import type { MarkdownHeading } from 'astro';

interface Props {
  readonly headings: readonly MarkdownHeading[];
}

const { headings } = Astro.props;
---

<div class="article-toc-root">
  <nav
    class="article-toc article-toc--desktop"
    aria-labelledby="article-toc-desktop-label"
    data-article-toc="desktop"
    data-pagefind-ignore
  >
    <p class="article-toc__title" id="article-toc-desktop-label">On this page</p>
    <ol class="article-toc__list">
      {
        headings.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} data-toc-depth={heading.depth} data-astro-reload>{heading.text}</a>
          </li>
        ))
      }
    </ol>
  </nav>

  <details class="article-toc article-toc--mobile" data-article-toc="mobile" data-pagefind-ignore>
    <summary id="article-toc-mobile-label" aria-controls="article-toc-mobile-list">
      <span>On this page</span>
      <span class="article-toc__count">{headings.length} sections</span>
    </summary>
    <nav id="article-toc-mobile-list" aria-labelledby="article-toc-mobile-label">
      <ol class="article-toc__list">
        {
          headings.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} data-toc-depth={heading.depth} data-astro-reload>{heading.text}</a>
            </li>
          ))
        }
      </ol>
    </nav>
  </details>
</div>

<script>
  const initializeTableOfContentsLinks = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-article-toc] a[href^="#"]').forEach((link) => {
      if (link.dataset.tocNavigationInitialized === 'true') return;
      link.dataset.tocNavigationInitialized = 'true';

      const scrollToTarget = () => {
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        target?.scrollIntoView({ block: 'start' });
      };

      link.addEventListener('pointerdown', (event) => {
        if (event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
          scrollToTarget();
        }
      });

      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (target === null) return;

        event.preventDefault();
        window.history.pushState(null, '', link.hash);
        scrollToTarget();
      });
    });
  };

  document.addEventListener('astro:page-load', initializeTableOfContentsLinks);
  initializeTableOfContentsLinks();
</script>

<style>
  .article-toc-root {
    min-width: 0;
  }

  .article-toc {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.45;
  }

  .article-toc--desktop {
    display: none;
  }

  .article-toc--mobile {
    margin-bottom: 2rem;
    border: 1px solid var(--color-card-border);
    border-radius: 0.5rem;
    background: var(--color-surface-raised);
  }

  .article-toc--mobile summary {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    color: var(--color-text-primary);
    font-weight: 800;
    cursor: pointer;
  }

  .article-toc__count {
    flex: 0 0 auto;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .article-toc--mobile nav {
    border-top: 1px solid var(--color-card-border);
    padding: 0.5rem;
  }

  .article-toc__title {
    margin: 0;
    padding: 0 0.75rem 0.75rem;
    border-bottom: 1px solid var(--color-card-border);
    color: var(--color-text-primary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-toc__list {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-toc--desktop .article-toc__list {
    padding-top: 0.5rem;
  }

  .article-toc__list a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.375rem;
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
    text-decoration: none;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .article-toc__list a[data-toc-depth='2'] {
    padding: 0.5rem 0.75rem;
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .article-toc__list a[data-toc-depth='3'] {
    padding: 0.5rem 0.75rem 0.5rem 1.5rem;
  }

  .article-toc__list a:hover {
    background: rgba(var(--color-accent-rgb), 0.08);
    color: var(--color-accent);
  }

  :is(summary, a):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (min-width: 1024px) {
    .article-toc--mobile {
      display: none;
    }

    .article-toc--desktop {
      position: sticky;
      top: 6.5rem;
      display: block;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-toc__list a {
      transition: none;
    }
  }
</style>
