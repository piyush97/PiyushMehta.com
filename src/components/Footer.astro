---
const year = new Date().getFullYear();

const links = [
  { href: '/projects/', label: 'Work' },
  { href: '/blog/', label: 'Writing' },
  { href: '/resume/', label: 'Resume' },
  { href: '/uses/', label: 'Uses' },
  { href: '/contact-me/', label: 'Contact' },
];

const social = [
  { href: 'https://github.com/piyush97', label: 'GitHub' },
  { href: 'https://linkedin.com/in/piyush24', label: 'LinkedIn' },
  { href: 'mailto:contact@piyushmehta.com', label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer class="site-footer" data-reveal>
  <div>
    <p class="site-footer__eyebrow">Piyush Mehta</p>
    <h2>Senior software engineer for durable product systems.</h2>
    <p>
      Built with Astro, TypeScript, Tailwind, MDX, and a bias toward evidence over noise.
    </p>
  </div>

  <nav aria-label="Footer navigation">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <div class="site-footer__bottom">
    <span>&copy; {year} Piyush Mehta.</span>
    <div>
      {social.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding-block: clamp(3rem, 8vw, 5rem);
    border-top: 1px solid var(--color-card-border);
  }

  .site-footer__eyebrow {
    margin: 0 0 0.8rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-footer h2 {
    max-width: 16ch;
    margin: 0;
    color: var(--color-text-primary);
    font-size: 3.25rem;
    line-height: 1.05;
  }

  .site-footer p {
    max-width: 40rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .site-footer nav,
  .site-footer__bottom,
  .site-footer__bottom div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .site-footer nav {
    margin-top: 2rem;
  }

  .site-footer a {
    color: var(--color-text-secondary);
    font-weight: 800;
    text-decoration: none;
    transition:
      color var(--motion-fast, 150ms) ease,
      transform var(--motion-fast, 150ms) ease;
  }

  .site-footer a:hover {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .site-footer__bottom {
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-card-border);
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .site-footer h2 {
      font-size: 2.25rem;
    }
  }
</style>
