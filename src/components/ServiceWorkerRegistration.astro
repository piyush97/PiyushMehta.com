---
// Legacy compatibility component.
// Importing this component now retires the old PWA worker instead of registering it.
---

<script is:inline>
  const legacyPortfolioCacheNames = [
    'workbox-',
    'pages-cache',
    'critical-css-cache',
    'google-fonts-stylesheets',
    'google-fonts-webfonts',
    'images-cache',
    'static-resources',
    'astro-assets',
    'api-cache',
    'cdn-cache',
  ];

  const isLegacyPortfolioCache = (cacheName) =>
    legacyPortfolioCacheNames.some((cachePrefix) => cacheName.startsWith(cachePrefix));

  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker
        .getRegistrations()
        .then((registrations) =>
          Promise.all(registrations.map((registration) => registration.unregister()))
        )
        .then(() => {
          if (!('caches' in window)) {
            return [];
          }

          return caches
            .keys()
            .then((cacheNames) =>
              Promise.all(
                cacheNames
                  .filter((cacheName) => isLegacyPortfolioCache(cacheName))
                  .map((cacheName) => caches.delete(cacheName))
              )
            );
        })
        .catch(() => {});
    });
  }
</script>
