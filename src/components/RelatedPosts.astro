---
import { getCollection } from 'astro:content';
import { selectBlogRecommendations, toBlogPostSlug } from '../utils/blog-recommendations';

export interface Props {
  currentSlug: string;
  currentTags?: string[];
  maxPosts?: number;
  excludeSlugs?: string[];
}

const { currentSlug, currentTags = [], maxPosts = 3, excludeSlugs = [] } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = selectBlogRecommendations(allPosts, {
  currentSlug,
  currentTags,
  excludeSlugs,
  limit: maxPosts,
}).map(({ entry, similarity, matchingTags }) => ({
  ...entry,
  similarity,
  matchingTags,
}));

const formatDate = (value: Date) =>
  value.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const calculateReadingTime = (content: string) => {
  const wordCount = content.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(wordCount / 200));
};
---

{
  relatedPosts.length > 0 && (
    <section class="related-posts-section" aria-labelledby="related-posts-heading">
      <header class="related-posts-section__header">
        <div>
          <p class="related-posts-section__label">Continue the record</p>
          <h2 id="related-posts-heading">Related field notes.</h2>
        </div>
        <a href="/blog/" class="related-posts-section__all">
          View all writing
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </header>

      <div class="related-posts-list">
        {relatedPosts.map((post) => {
          const postSlug = toBlogPostSlug(post.id);
          const readingTime = calculateReadingTime(post.body ?? '');
          const postUrl = `/blog/${postSlug}/`;
          const tags = post.data.tags ?? [];
          const descriptionId = post.data.description ? `post-${postSlug}-description` : undefined;

          return (
            <article
              class="related-post-card"
              data-similarity={post.similarity.toFixed(2)}
            >
              <div class="related-post-card__meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span>{readingTime} min read</span>
              </div>
              <div class="related-post-card__body">
                <h3>
                  <a
                    href={postUrl}
                    class="stretched-link"
                    aria-describedby={descriptionId}
                  >
                    {post.data.title}
                  </a>
                </h3>
                {post.data.description && (
                  <p id={descriptionId}>{post.data.description}</p>
                )}
                {tags.length > 0 && (
                  <div class="related-post-card__tags" aria-label="Article topics">
                    {tags.slice(0, 3).map((tag: string) => <span>{tag}</span>)}
                  </div>
                )}
              </div>
              <a class="related-post-card__action" href={postUrl} aria-label={`Read “${post.data.title}”`}>
                Read note
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </article>
          );
        })}
      </div>
    </section>
  )
}

<script is:inline>
  class RelatedPostsAnalytics {
    constructor(section) {
      this.section = section;
      this.initializeTracking();
      this.addInteractiveFeatures();
    }

    initializeTracking() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.trackEvent('related_posts_viewed', {
                posts_shown: this.section.querySelectorAll('.related-post-card').length,
              });
            }
          });
        },
        { threshold: 0.5 }
      );

      observer.observe(this.section);

      this.section.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const postCard = event.target.closest('.related-post-card');
        if (!postCard) return;

        const similarity = Number.parseFloat(postCard.getAttribute('data-similarity') || '0');
        const title = postCard.querySelector('h3')?.textContent || '';
        this.trackEvent('related_post_clicked', {
          post_title: title,
          similarity_score: similarity,
          position: Array.from(postCard.parentElement?.children ?? []).indexOf(postCard),
        });
      });
    }

    addInteractiveFeatures() {
      const postCards = this.section.querySelectorAll('.related-post-card');

      postCards.forEach((card, index) => {
        const link = card.querySelector('.stretched-link');
        if (!link) return;

        link.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight' && index < postCards.length - 1) {
            event.preventDefault();
            postCards[index + 1].querySelector('.stretched-link')?.focus();
          } else if (event.key === 'ArrowLeft' && index > 0) {
            event.preventDefault();
            postCards[index - 1].querySelector('.stretched-link')?.focus();
          }
        });
      });
    }

    trackEvent(eventName, properties = {}) {
      if (typeof gtag !== 'undefined') {
        gtag('event', eventName, properties);
      }

      if (window.location.hostname === 'localhost') {
        console.log('Related Posts Event:', eventName, properties);
      }
    }
  }

  const initRelatedPosts = () => {
    document.querySelectorAll('.related-posts-section').forEach((section) => {
      if (section.dataset.relatedPostsInitialized === 'true') return;
      section.dataset.relatedPostsInitialized = 'true';
      new RelatedPostsAnalytics(section);
    });
  };

  document.addEventListener('astro:page-load', initRelatedPosts);
  initRelatedPosts();
</script>

<style>
  .related-posts-section {
    width: min(100%, 1120px);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-card-border);
  }

  .related-posts-section__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .related-posts-section__label {
    margin: 0 0 0.65rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .related-posts-section h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.05;
  }

  .related-posts-section__all,
  .related-post-card__action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }

  .related-posts-section__all:hover,
  .related-posts-section__all:focus-visible,
  .related-post-card__action:hover,
  .related-post-card__action:focus-visible {
    color: var(--color-text-primary);
  }

  .related-posts-section__all svg,
  .related-post-card__action svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--motion-fast, 150ms) ease;
  }

  .related-posts-section__all:hover svg,
  .related-posts-section__all:focus-visible svg,
  .related-post-card__action:hover svg,
  .related-post-card__action:focus-visible svg {
    transform: translateX(0.2rem);
  }

  .related-posts-list {
    display: grid;
    border-block: 1px solid var(--color-card-border);
  }

  .related-post-card {
    display: grid;
    grid-template-columns: minmax(9rem, 0.24fr) minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--color-card-border);
  }

  .related-post-card:last-child {
    border-bottom: 0;
  }

  .related-post-card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .related-post-card__body {
    min-width: 0;
  }

  .related-post-card h3 {
    max-width: 44rem;
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.12;
  }

  .related-post-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .related-post-card h3 a:hover,
  .related-post-card h3 a:focus-visible {
    color: var(--color-accent);
  }

  .related-post-card p {
    max-width: 50rem;
    margin: 0.6rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .related-post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }

  .related-post-card__tags span {
    border: 1px solid var(--color-card-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.2;
    padding: 0.3rem 0.4rem;
  }

  .related-post-card__action {
    white-space: nowrap;
  }

  .stretched-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 720px) {
    .related-posts-section__header {
      align-items: flex-start;
      flex-direction: column;
    }

    .related-post-card {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .related-post-card__meta {
      flex-direction: row;
      justify-content: space-between;
    }

    .related-post-card__action {
      justify-self: start;
    }
  }
</style>
