---
/**
 * Doorway into /ask. A plain link (no JS, no Turnstile off /ask): it only prefills the box.
 * Nothing is sent until the visitor presses Enter there.
 */
interface Props {
  q?: string;
  label: string;
  class?: string;
}
const { q, label, class: className = '' } = Astro.props;
const href = q ? `/ask/?q=${encodeURIComponent(q)}` : '/ask/';
---

<a class={`ask-link ${className}`} href={href} data-ask-link>
  <span aria-hidden="true">✦</span>
  {label}
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 12h14M13 6l6 6-6 6" />
  </svg>
</a>

<style>
  .ask-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--color-accent);
    font-weight: 800;
    text-decoration: none;
  }
  .ask-link svg {
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ask-link:hover svg,
  .ask-link:focus-visible svg {
    transform: translateX(0.25rem);
  }
  .ask-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ask-link svg {
      transition: none;
    }
  }
</style>
