---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageOptimizer } from '../utils/image-optimizer';

export interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  sizes?: string;
  quality?: number;
  formats?: string[];
  enablePlaceholder?: boolean;
  enableBlurHash?: boolean;
  region?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  priority = false,
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
  quality = 80,
  formats = ['webp', 'avif'],
  enablePlaceholder = true,
  enableBlurHash = true,
  region,
} = Astro.props;

// Use enhanced image optimizer for better performance and CDN integration
const generateAdvancedImageSet = async (imageSrc: ImageMetadata | string) => {
  // For string URLs, use the advanced optimizer directly
  if (typeof imageSrc === 'string') {
    return await imageOptimizer.generateResponsiveImages(imageSrc, {
      alt,
      width,
      height,
      priority,
      className,
      region,
    });
  }

  // For ImageMetadata, still use Astro's built-in optimization but enhanced
  const baseWidth = width || imageSrc.width;
  const baseHeight = height || imageSrc.height;
  const aspectRatio = baseWidth / baseHeight;

  // Generate different sizes for responsive design
  const widths = [320, 640, 768, 1024, 1280, 1536].filter((w) => w <= baseWidth);

  const variants = await Promise.all(
    widths.map(async (w) => {
      const h = Math.round(w / aspectRatio);
      const image = await getImage({
        src: imageSrc,
        width: w,
        height: h,
        quality,
        format: 'webp',
      });
      return `${image.src} ${w}w`;
    })
  );

  // Generate format-specific sources with better format ordering
  const formatOrder = ['avif', 'webp', 'jpeg']; // AVIF first for best compression
  const availableFormats = formats.filter((f) => formatOrder.includes(f));

  const sources = await Promise.all(
    availableFormats.map(async (format) => {
      const formatVariants = await Promise.all(
        widths.map(async (w) => {
          const h = Math.round(w / aspectRatio);
          const image = await getImage({
            src: imageSrc,
            width: w,
            height: h,
            quality,
            format: format as 'webp' | 'avif' | 'png' | 'jpg',
          });
          return `${image.src} ${w}w`;
        })
      );

      const mimeTypes: Record<string, string> = {
        avif: 'image/avif',
        webp: 'image/webp',
        jpeg: 'image/jpeg',
        jpg: 'image/jpeg',
        png: 'image/png',
      };

      return {
        format,
        srcset: formatVariants.join(', '),
        type: mimeTypes[format] || 'image/jpeg',
      };
    })
  );

  // Fallback image
  const fallbackImage = await getImage({
    src: imageSrc,
    width: baseWidth,
    height: baseHeight,
    quality,
    format: 'jpg',
  });

  return {
    fallback: {
      src: fallbackImage.src,
      srcSet: variants.join(', '),
      width: baseWidth,
      height: baseHeight,
      format: 'jpeg',
      fileSize: 0,
    },
    [formats[0]]: sources.find((s) => s.format === formats[0]),
    [formats[1]]: sources.find((s) => s.format === formats[1]),
  };
};

// Generate placeholder data
const placeholderData =
  enablePlaceholder && typeof src === 'string'
    ? await imageOptimizer.generatePlaceholder(src, {
        width: Math.min(width || 40, 40),
        height: Math.min(height || 30, 30),
        type: enableBlurHash ? 'blur' : 'solid',
      })
    : null;

const imageData = await generateAdvancedImageSet(src);
---

<picture class={className}>
  {/* AVIF format for best compression */}
  {imageData.avif && (
    <source
      srcset={imageData.avif.srcset}
      type="image/avif"
      sizes={sizes}
    />
  )}
  
  {/* WebP format for wide browser support */}
  {imageData.webp && (
    <source
      srcset={imageData.webp.srcset}
      type="image/webp"
      sizes={sizes}
    />
  )}
  
  {/* JPEG fallback */}
  <img
    src={imageData.fallback.src}
    srcset={imageData.fallback.srcSet}
    alt={alt}
    width={imageData.fallback.width}
    height={imageData.fallback.height}
    loading={priority ? 'eager' : loading}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    sizes={sizes}
    class="optimized-image"
    data-blurhash={placeholderData?.blurHash}
    data-dominant-color={placeholderData?.dominantColor}
    style={placeholderData?.dataUrl ? `background-image: url(${placeholderData.dataUrl}); background-size: cover; background-position: center;` : ''}
  />
</picture>

<style>
  .optimized-image {
    @apply w-full h-auto object-cover transition-all duration-500 ease-out;
    background-color: var(--placeholder-color, #f3f4f6);
  }

  .optimized-image[loading="lazy"] {
    @apply opacity-0 scale-105;
    filter: blur(5px);
  }

  .optimized-image.loaded {
    @apply opacity-100 scale-100;
    filter: blur(0);
  }

  .optimized-image.loading {
    @apply opacity-60;
    filter: blur(2px);
  }

  /* Enhanced placeholder with dominant color support */
  .optimized-image[data-dominant-color] {
    background-color: attr(data-dominant-color);
  }

  /* Progressive enhancement for blur hash */
  .optimized-image[data-blurhash] {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Performance optimizations */
  picture {
    display: block;
    contain: layout style;
  }

  /* Critical rendering optimizations */
  .optimized-image[fetchpriority="high"] {
    content-visibility: auto;
  }
</style>

<script>
  // Enhanced progressive image loading with performance monitoring
  if ('IntersectionObserver' in window) {
    const imageObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const img = entry.target as HTMLImageElement;
          const startTime = performance.now();
          
          // Set dominant color as CSS variable
          const dominantColor = img.dataset.dominantColor;
          if (dominantColor) {
            img.style.setProperty('--placeholder-color', dominantColor);
          }
          
          // Add loading class for animation
          img.classList.add('loading');
          
          // Handle successful load
          img.addEventListener('load', () => {
            const loadTime = performance.now() - startTime;
            img.classList.add('loaded');
            img.classList.remove('loading');
            
            // Remove background image once loaded
            img.style.backgroundImage = '';
            
            // Performance tracking
            if (loadTime > 1000) {
              console.warn(`Slow image load detected: ${img.src} took ${loadTime.toFixed(2)}ms`);
            }
          });

          // Handle error with fallback
          img.addEventListener('error', () => {
            img.classList.remove('loading');
            img.classList.add('error');
            
            // Try to fallback to JPEG if AVIF/WebP failed
            if (img.src.includes('.avif') || img.src.includes('.webp')) {
              const fallbackSrc = img.src.replace(/\.(avif|webp)/, '.jpg');
              img.src = fallbackSrc;
            } else {
              console.warn('Failed to load image:', img.src);
            }
          });

          imageObserver.unobserve(img);
        }
      });
    }, {
      rootMargin: '100px 0px', // Larger margin for better UX
      threshold: 0.1
    });

    // Enhanced image observation with retry mechanism
    document.querySelectorAll('img[loading="lazy"]').forEach((img) => {
      imageObserver.observe(img);
      
      // Preconnect to image domains for faster loading
      const imgSrc = (img as HTMLImageElement).src;
      if (imgSrc && !document.querySelector(`link[href*="${new URL(imgSrc).hostname}"]`)) {
        const preconnect = document.createElement('link');
        preconnect.rel = 'preconnect';
        preconnect.href = new URL(imgSrc).origin;
        document.head.appendChild(preconnect);
      }
    });
  }

  // Fallback for browsers without IntersectionObserver
  else {
    document.querySelectorAll('img[loading="lazy"]').forEach((img) => {
      (img as HTMLImageElement).loading = 'eager';
    });
  }
</script>