---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  sizes?: string;
  quality?: number;
  formats?: string[];
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  priority = false,
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
  quality = 80,
  formats = ['webp', 'avif'],
} = Astro.props;

const generateResponsiveImages = async (imageSrc: ImageMetadata | string) => {
  if (typeof imageSrc === 'string') {
    return { src: imageSrc, srcset: '', sources: [], width: width || undefined, height: height || undefined };
  }

  const baseWidth = width || imageSrc.width;
  const baseHeight = height || imageSrc.height;
  const aspectRatio = baseWidth / baseHeight;
  const widths = [320, 640, 768, 1024, 1280, 1536].filter((w) => w <= baseWidth);

  const variants = await Promise.all(
    widths.map(async (w) => {
      const h = Math.round(w / aspectRatio);
      const image = await getImage({ src: imageSrc, width: w, height: h, quality, format: 'webp' });
      return `${image.src} ${w}w`;
    })
  );

  const sources = await Promise.all(
    formats.map(async (format) => {
      const formatVariants = await Promise.all(
        widths.map(async (w) => {
          const h = Math.round(w / aspectRatio);
          const image = await getImage({ src: imageSrc, width: w, height: h, quality, format: format as 'webp' | 'avif' | 'png' | 'jpg' });
          return `${image.src} ${w}w`;
        })
      );
      return { format, srcset: formatVariants.join(', '), type: format === 'avif' ? 'image/avif' : 'image/webp' };
    })
  );

  const fallbackImage = await getImage({ src: imageSrc, width: baseWidth, height: baseHeight, quality, format: 'jpg' });

  return { src: fallbackImage.src, srcset: variants.join(', '), sources, width: baseWidth, height: baseHeight };
};

const imageData = await generateResponsiveImages(src);
---

{
  imageData.sources.length > 0 ? (
    <picture>
      {imageData.sources.map((source) => <source srcset={source.srcset} type={source.type} sizes={sizes} />)}
      <img src={imageData.src} srcset={imageData.srcset} alt={alt} class={className}
        loading={priority ? 'eager' : loading} decoding={priority ? 'async' : 'auto'}
        fetchpriority={priority ? 'high' : undefined} width={imageData.width} height={imageData.height} />
    </picture>
  ) : (
    <img src={imageData.src} alt={alt} class={className}
      loading={priority ? 'eager' : loading} decoding={priority ? 'async' : 'auto'}
      fetchpriority={priority ? 'high' : undefined} width={imageData.width} height={imageData.height} />
  )
}
