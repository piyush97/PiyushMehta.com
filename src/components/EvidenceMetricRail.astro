---
interface Metric {
  value: string;
  label: string;
  detail: string;
}

interface Props {
  metrics: Metric[];
  label?: string;
  class?: string;
}

const { metrics, label = 'Selected evidence', class: className = '' } = Astro.props;
---

<div class={`evidence-metric-rail ${className}`} role="list" aria-label={label}>
  {metrics.map((metric) => (
    <article class="evidence-metric" role="listitem">
      <strong>{metric.value}</strong>
      <span>{metric.label}</span>
      <p>{metric.detail}</p>
    </article>
  ))}
</div>

<style>
  .evidence-metric-rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border-block: 1px solid var(--color-card-border);
    background: var(--color-card-border);
  }

  .evidence-metric {
    min-width: 0;
    padding: clamp(1.1rem, 2.6vw, 1.6rem);
    background: var(--color-bg);
  }

  .evidence-metric strong {
    display: block;
    color: var(--color-text-primary);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  .evidence-metric span {
    display: block;
    margin-top: 0.7rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.4;
  }

  .evidence-metric p {
    margin: 0.65rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .evidence-metric-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .evidence-metric-rail {
      grid-template-columns: 1fr;
    }
  }
</style>
