---
interface BlogPost {
  title: string;
  excerpt: string;
  date: string;
  slug: string;
  categories: string[];
  readingTime: number;
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const formatDate = (dateString: string) =>
  new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<article
  class="editorial-article-row"
  data-post-card
  data-title={post.title.toLowerCase()}
  data-excerpt={post.excerpt.toLowerCase()}
  data-categories={post.categories.join('|').toLowerCase()}
  data-category-values={post.categories.join('|')}
  data-date={new Date(post.date).getTime()}
  data-reading-time={post.readingTime}
>
  <div class="editorial-article-row__meta writing-list__meta">
    <time datetime={post.date}>{formatDate(post.date)}</time>
    <span>{post.readingTime} min read</span>
  </div>
  <div class="editorial-article-row__body">
    <h3>
      <a href={`/blog/${post.slug}/`}>{post.title}</a>
    </h3>
    <p>{post.excerpt}</p>
    <div class="editorial-article-row__footer writing-list__footer">
      <div aria-label="Article topics">
        {post.categories.slice(0, 4).map((category) => <span>{category}</span>)}
      </div>
      <a href={`/blog/${post.slug}/`} aria-label={`Read “${post.title}”`}>
        Read note
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .editorial-article-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.24fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3.5rem);
    padding: clamp(1.25rem, 2.8vw, 2rem) clamp(1.15rem, 2.4vw, 1.7rem);
    background: transparent;
    transition: background 180ms ease;
  }

  .editorial-article-row:hover {
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-surface-raised));
  }

  .editorial-article-row__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.45rem;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .editorial-article-row__body {
    min-width: 0;
  }

  .editorial-article-row h3 {
    max-width: 46rem;
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .editorial-article-row h3 a {
    color: inherit;
    text-decoration: none;
  }

  .editorial-article-row h3 a:hover,
  .editorial-article-row h3 a:focus-visible {
    color: var(--color-accent);
  }

  .editorial-article-row p {
    max-width: 52rem;
    margin: 0.8rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .editorial-article-row__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 1.1rem;
  }

  .editorial-article-row__footer > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .editorial-article-row__footer span {
    display: inline-flex;
    border: 1px solid rgba(var(--color-accent-rgb), 0.32);
    color: var(--color-accent);
    font-size: 0.73rem;
    font-weight: 800;
    line-height: 1;
    padding: 0.4rem 0.55rem;
  }

  .editorial-article-row__footer > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-primary);
    font-weight: 800;
    text-decoration: none;
  }

  .editorial-article-row__footer > a:hover,
  .editorial-article-row__footer > a:focus-visible {
    color: var(--color-accent);
  }

  .editorial-article-row__footer svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--motion-fast, 150ms) ease;
  }

  .editorial-article-row__footer > a:hover svg,
  .editorial-article-row__footer > a:focus-visible svg {
    transform: translateX(0.2rem);
  }

  @media (max-width: 680px) {
    .editorial-article-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .editorial-article-row__meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-article-row,
    .editorial-article-row__footer svg {
      transition: none;
    }

    .editorial-article-row__footer > a:hover svg,
    .editorial-article-row__footer > a:focus-visible svg {
      transform: none;
    }
  }
</style>
