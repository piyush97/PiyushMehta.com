---
import type { SeriesContext } from '../utils/series';

interface Props {
  series: SeriesContext;
}

const { series } = Astro.props;
const current = series.posts[series.index - 1];
---

<nav class="series-rail" aria-labelledby="series-rail-title" data-series-rail data-pagefind-ignore>
  <p class="series-rail__label" id="series-rail-title">
    <span class="series-rail__part">Part {series.index} of {series.total}</span>
    <span class="series-rail__name">in {series.name}</span>
  </p>

  <details class="series-rail__parts">
    <summary>All {series.total} parts</summary>
    <ol>
      {
        series.posts.map((entry) => (
          <li>
            {entry === current ? (
              <a href={`/blog/${entry.slug}`} aria-current="page">
                {entry.title}
              </a>
            ) : (
              <a href={`/blog/${entry.slug}`}>{entry.title}</a>
            )}
          </li>
        ))
      }
    </ol>
  </details>

  {
    (series.prev || series.next) && (
      <div class="series-rail__steps">
        {series.prev ? (
          <a class="series-rail__step" href={`/blog/${series.prev.slug}`} rel="prev">
            <span class="series-rail__dir">Previous part</span>
            <span class="series-rail__title">{series.prev.title}</span>
          </a>
        ) : (
          <span />
        )}
        {series.next && (
          <a
            class="series-rail__step series-rail__step--next"
            href={`/blog/${series.next.slug}`}
            rel="next"
          >
            <span class="series-rail__dir">Next part</span>
            <span class="series-rail__title">{series.next.title}</span>
          </a>
        )}
      </div>
    )
  }
</nav>

<style>
  .series-rail {
    max-width: 74ch;
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-card-border);
    border-left: 3px solid var(--color-accent);
    border-radius: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .series-rail__label {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    color: var(--color-text-primary);
  }

  .series-rail__part {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .series-rail__name {
    font-weight: 700;
  }

  .series-rail__parts {
    margin-top: 0.5rem;
  }

  .series-rail__parts summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    cursor: pointer;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .series-rail__parts ol {
    margin: 0;
    padding: 0 0 0 1.5rem;
  }

  .series-rail a {
    color: inherit;
  }

  .series-rail__parts li a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-underline-offset: 3px;
  }

  .series-rail__parts a[aria-current='page'] {
    color: var(--color-text-primary);
    font-weight: 800;
    text-decoration: none;
  }

  .series-rail__parts a[aria-current='page']::after {
    content: ' (current)';
    font-weight: 400;
  }

  .series-rail__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .series-rail__step {
    display: flex;
    min-height: 2.75rem;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-card-border);
    text-decoration: none;
  }

  .series-rail__step--next {
    grid-column: 2;
    text-align: right;
  }

  .series-rail__dir {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .series-rail__title {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .series-rail a:hover {
    border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-card-border));
  }

  .series-rail a:focus-visible,
  .series-rail summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .series-rail__steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .series-rail__step--next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
