---
interface Props {
  title: string;
  pageUrl: string;
  embedUrl: string;
  embedHeight: number;
}

const { title, pageUrl, embedUrl, embedHeight } = Astro.props;
const safeTitle = title.replace(/"/g, '&quot;');
const snippet = `<iframe src="${embedUrl}" title="${safeTitle}" width="100%" height="${embedHeight}" style="border:0;max-width:760px" loading="lazy"></iframe>`;
---

<section class="lab-share" data-lab-share aria-labelledby="lab-share-title">
  <h2 id="lab-share-title">Share or embed</h2>

  <div class="lab-share__row">
    <label for="lab-share-link">Link to this demo</label>
    <div class="lab-share__field">
      <input id="lab-share-link" type="text" readonly value={pageUrl} data-copy-source="link" />
      <button type="button" class="btn-secondary" data-copy="link">Copy link</button>
    </div>
  </div>

  <div class="lab-share__row">
    <label for="lab-share-embed">Embed snippet (iframe, no site navigation)</label>
    <div class="lab-share__field">
      <textarea id="lab-share-embed" readonly rows="3" data-copy-source="embed" data-lab-embed-snippet>{snippet}</textarea>
      <button type="button" class="btn-secondary" data-copy="embed">Copy embed code</button>
    </div>
  </div>

  <p class="lab-share__status" role="status" aria-live="polite" data-copy-status></p>
</section>

<script>
  function initLabShare() {
    for (const root of document.querySelectorAll<HTMLElement>('[data-lab-share]')) {
      if (root.dataset.initialized) continue;
      root.dataset.initialized = 'true';
      const status = root.querySelector<HTMLElement>('[data-copy-status]');
      let timer: number | undefined;

      const announce = (message: string) => {
        if (!status) return;
        status.textContent = message;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          status.textContent = '';
        }, 4000);
      };

      for (const button of root.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const source = root.querySelector<HTMLInputElement | HTMLTextAreaElement>(
            `[data-copy-source="${button.dataset.copy}"]`,
          );
          if (!source) return;
          const label = button.dataset.copy === 'embed' ? 'Embed code' : 'Link';
          try {
            if (!navigator.clipboard?.writeText) throw new Error('clipboard unavailable');
            await navigator.clipboard.writeText(source.value);
            announce(`${label} copied.`);
          } catch {
            source.focus();
            source.select();
            announce(`Copy was blocked. The ${label.toLowerCase()} is selected: press Ctrl+C or Cmd+C.`);
          }
        });
      }
    }
  }
  initLabShare();
  document.addEventListener('astro:page-load', initLabShare);
</script>

<style>
  .lab-share {
    display: grid;
    gap: 1.25rem;
    padding: 1.4rem;
    border: 1px solid var(--color-card-border);
    border-radius: 0.75rem;
    background: var(--color-surface-raised);
  }

  h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .lab-share__row {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  label {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .lab-share__field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: start;
  }

  input,
  textarea {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-card-border);
    border-radius: 0.375rem;
    background: var(--color-bg);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lab-share__status {
    min-height: 1.4rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .lab-share__field {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
