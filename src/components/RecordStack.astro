---
/**
 * A stacked record: a short, ordered set of named items, each with an optional
 * mono tag and a line of detail.
 *
 * Used where prose would otherwise bold a term inside a paragraph — layered
 * systems, named patterns, constraints. The tag is for classification words the
 * source already uses (immutable, compressed, verbatim); it is never a section
 * number, because the items are a set, not a sequence.
 */

interface RecordItem {
  tag?: string;
  name: string;
  detail: string;
}

interface Props {
  items: readonly RecordItem[];
  label?: string;
  caption?: string;
  class?: string;
}

const { items, label, caption, class: className = '' } = Astro.props;
---

<figure class:list={['record-stack', className]}>
  <ol class="record-stack__list" aria-label={label}>
    {
      items.map((item) => (
        <li class="record-stack__row">
          {item.tag && <span class="record-stack__tag">{item.tag}</span>}
          <span class="record-stack__body">
            <strong class="record-stack__name">{item.name}</strong>
            <span class="record-stack__detail">{item.detail}</span>
          </span>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .record-stack {
    margin: 2.5rem 0;
    border-top: 1px solid var(--color-card-border);
    border-bottom: 1px solid var(--color-card-border);
  }

  /* Nested under the root so these resets outrank the article page's
     `ol { display: grid }` prose rule. */
  .record-stack .record-stack__list {
    display: block;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .record-stack .record-stack__row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0 1.25rem;
    align-items: baseline;
    margin: 0;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-card-border);
  }

  .record-stack .record-stack__row:last-child {
    border-bottom: 0;
  }

  .record-stack__tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .record-stack .record-stack__row:not(:has(.record-stack__tag)) {
    grid-template-columns: minmax(0, 1fr);
  }

  .record-stack__body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .record-stack__name {
    font-weight: 800;
    font-size: 1.02rem;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .record-stack__detail {
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  figcaption {
    padding: 0.85rem 0 1rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-card-border);
  }
</style>
