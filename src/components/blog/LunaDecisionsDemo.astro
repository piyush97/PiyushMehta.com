---
const fixtures = [
  {
    label: 'Clear billing request',
    ticket: 'I was charged twice for my subscription renewal. Please refund the duplicate payment.',
    probabilities: [0.94, 0.04, 0.02],
  },
  {
    label: 'Likely technical issue',
    ticket: 'Since the latest update, the dashboard returns a 500 error whenever I export a report.',
    probabilities: [0.06, 0.82, 0.12],
  },
  {
    label: 'Ambiguous account request',
    ticket: 'I changed my plan and now cannot access my workspace. Is this a payment or login problem?',
    probabilities: [0.43, 0.05, 0.52],
  },
];
const teams = ['Billing', 'Technical', 'Account'];
---

<section class="luna-demo not-prose" data-luna-demo aria-label="Decision threshold playground">
  <header>
    <p class="luna-demo__eyebrow">Interactive walkthrough</p>
    <h3>Where should this ticket go?</h3>
    <p>Illustrative fixtures, not model predictions. No API calls, keys, or costs.</p>
  </header>
  <label>
    Support ticket
    <select data-ticket>
      {fixtures.map(({ label, ticket, probabilities }) => (
        <option data-text={ticket} data-probabilities={probabilities.join(',')}>{label}</option>
      ))}
    </select>
  </label>
  <blockquote data-evidence>{fixtures[0].ticket}</blockquote>
  <label>
    Auto-route threshold: <output data-threshold-value>80%</output>
    <input data-threshold type="range" min="50" max="99" value="80" aria-label="Auto-route threshold" />
  </label>
  <p class="luna-demo__hint">Move the threshold or choose another ticket. Lower certainty goes to human review.</p>
  <ul class="luna-demo__probabilities" aria-label="Illustrative team probabilities">
    {teams.map((team, index) => (
      <li>
        <span>{team}</span>
        <meter min="0" max="1" value={fixtures[0].probabilities[index]} aria-label={`${team} probability`} />
        <output>{Math.round(fixtures[0].probabilities[index] * 100)}%</output>
      </li>
    ))}
  </ul>
  <p class="luna-demo__verdict" data-verdict role="status" aria-live="polite" aria-atomic="true">
    Auto-route to Billing: 94% meets the 80% threshold.
  </p>
  <noscript>Enable JavaScript to change the ticket and threshold. The initial example is shown above.</noscript>
</section>

<script>
  function initLunaDemos() {
    for (const demo of document.querySelectorAll<HTMLElement>('[data-luna-demo]')) {
      if (demo.dataset.initialized) continue;
      const ticket = demo.querySelector<HTMLSelectElement>('[data-ticket]');
      const threshold = demo.querySelector<HTMLInputElement>('[data-threshold]');
      const thresholdValue = demo.querySelector<HTMLOutputElement>('[data-threshold-value]');
      const evidence = demo.querySelector<HTMLElement>('[data-evidence]');
      const verdict = demo.querySelector<HTMLElement>('[data-verdict]');
      if (!ticket || !threshold || !thresholdValue || !evidence || !verdict) continue;
      demo.dataset.initialized = 'true';

      const update = () => {
        const option = ticket.selectedOptions[0];
        const probabilities = option.dataset.probabilities?.split(',').map(Number);
        if (!probabilities?.length) return;
        const cutoff = Number(threshold.value);
        const top = Math.max(...probabilities);
        const winner = probabilities.indexOf(top);
        const rows = demo.querySelectorAll<HTMLLIElement>('.luna-demo__probabilities li');
        thresholdValue.textContent = `${cutoff}%`;
        evidence.textContent = option.dataset.text ?? '';
        rows.forEach((row, index) => {
          const meter = row.querySelector('meter');
          const output = row.querySelector('output');
          if (meter) meter.value = probabilities[index];
          if (output) output.textContent = `${Math.round(probabilities[index] * 100)}%`;
        });
        const percent = Math.round(top * 100);
        const team = rows[winner]?.querySelector('span')?.textContent;
        verdict.textContent =
          top >= cutoff / 100
            ? `Auto-route to ${team}: ${percent}% meets the ${cutoff}% threshold.`
            : `Human review: ${percent}% is below the ${cutoff}% threshold.`;
        demo.dataset.review = String(top < cutoff / 100);
      };
      ticket.addEventListener('change', update);
      threshold.addEventListener('input', update);
      update();
    }
  }
  initLunaDemos();
  document.addEventListener('astro:page-load', initLunaDemos);
</script>

<style>
  .luna-demo {
    padding: 1.5rem;
    margin-block: 2rem;
    border: 1px solid var(--color-card-border);
    border-radius: 0.75rem;
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
  }
  .luna-demo__eyebrow { color: var(--color-accent); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  h3 { margin-block: 0.5rem; font-size: 1.35rem; line-height: 1.2; }
  header > p:last-child, .luna-demo__hint { color: var(--color-text-secondary); font-size: 0.8rem; line-height: 1.625; }
  label { display: block; margin-top: 1.5rem; font-weight: 800; }
  select { display: block; width: 100%; min-height: 2.75rem; margin-top: 0.5rem; padding: 0.625rem 0.75rem; border: 1px solid var(--color-card-border); border-radius: 0.375rem; background: var(--color-bg); color: var(--color-text-primary); font: inherit; font-weight: 400; }
  input { display: block; width: 100%; min-height: 2.75rem; accent-color: var(--color-accent); }
  select:focus-visible, input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  blockquote { margin: 1rem 0; padding: 0.75rem 1rem; border-left: 2px solid var(--color-accent); background: var(--color-bg); font-size: 1rem; line-height: 1.625; }
  .luna-demo__probabilities { list-style: none; margin: 1.5rem 0; padding: 0; }
  li { display: grid; grid-template-columns: 5rem 1fr 3rem; gap: 0.75rem; align-items: center; margin-block: 0.75rem; font-size: 0.8rem; }
  meter { width: 100%; height: 1rem; }
  li output { text-align: right; font-variant-numeric: tabular-nums; }
  .luna-demo__verdict { margin: 0; padding: 1rem; border: 1px solid var(--color-card-border); border-left: 2px solid var(--color-accent); border-radius: 0.375rem; background: var(--color-bg); font-weight: 800; line-height: 1.625; }
</style>
