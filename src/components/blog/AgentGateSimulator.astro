---
/**
 * Pick an illustrative agent PR, toggle gate jobs, see whether it merges and
 * whether what merged is safe. Fixtures are hand-written examples, not data.
 */
type Result = 'pass' | 'fail' | 'review';
const checks = [
  { id: 'tests', label: 'Unit tests', locked: true },
  { id: 'sast', label: 'Semgrep (diff-aware)', locked: false },
  { id: 'secrets', label: 'gitleaks', locked: false },
  { id: 'integrity', label: 'Test integrity', locked: false },
  { id: 'owners', label: 'Code owner review', locked: false },
] as const;
type CheckId = (typeof checks)[number]['id'];
const fixtures: { label: string; diff: string; results: Record<CheckId, Result>; risk: string | null }[] = [
  {
    label: 'Search endpoint',
    diff: "+ const rows = await db.query(\n+   `SELECT * FROM posts WHERE title LIKE '%${q}%'`\n+ );",
    results: { tests: 'pass', sast: 'fail', secrets: 'pass', integrity: 'pass', owners: 'pass' },
    risk: 'SQL injection (CWE-89) through the q parameter.',
  },
  {
    label: 'Payments test fixture',
    diff: "+ const stripe = new Stripe('sk_live_51Hx...redacted');\n+ it('charges the card', async () => { /* ... */ });",
    results: { tests: 'pass', sast: 'pass', secrets: 'fail', integrity: 'pass', owners: 'pass' },
    risk: 'Live API key committed to git history.',
  },
  {
    label: 'Migration that drops the monitor',
    diff: '  // src/monitoring/agent.ts\n- monitor.attach(ctx);\n  // src/monitoring/agent.test.ts\n- expect(ctx.monitor).toBeDefined();\n+ expect(ctx.monitor).toBeUndefined();',
    results: { tests: 'pass', sast: 'pass', secrets: 'pass', integrity: 'pass', owners: 'review' },
    risk: 'Monitoring removed, and the guard test now asserts it is gone.',
  },
  {
    label: 'Weakened auth test',
    diff: "  // tests/auth.test.ts\n- expect(res.status).toBe(403);\n- expect(audit).toHaveBeenCalled();\n+ it.skip('rejects expired tokens', ...);",
    results: { tests: 'pass', sast: 'pass', secrets: 'pass', integrity: 'fail', owners: 'pass' },
    risk: 'Expired-token rejection is no longer tested.',
  },
  {
    label: 'Org invoices endpoint',
    diff: "+ app.get('/api/orgs/:id/invoices', async (req, res) => {\n+   res.json(await invoices.forOrg(req.params.id));\n+ });",
    results: { tests: 'pass', sast: 'pass', secrets: 'pass', integrity: 'pass', owners: 'pass' },
    risk: 'No membership check (IDOR, CWE-639). Any signed-in user can read any org. Only an exploit-style test or a human reviewer catches this.',
  },
  {
    label: 'Rename a helper',
    diff: '- export function fmtDate(d) {\n+ export function formatDate(d) {',
    results: { tests: 'pass', sast: 'pass', secrets: 'pass', integrity: 'pass', owners: 'pass' },
    risk: null,
  },
];
const word: Record<Result, string> = { pass: 'Pass', fail: 'Fail', review: 'Needs review' };
---

<section class="gate-sim not-prose" data-gate-sim aria-label="Agent PR gate simulator">
  <script type="application/json" data-fixtures set:html={JSON.stringify(fixtures)} />
  <header>
    <p class="gate-sim__eyebrow">Interactive</p>
    <h3>Would this agent PR merge?</h3>
    <p>Hand-written example diffs, not benchmark data. Every PR here passes its unit tests.</p>
  </header>

  <label>
    Agent PR
    <select data-pr>
      {fixtures.map(({ label }, i) => <option value={i}>{label}</option>)}
    </select>
  </label>
  <pre data-diff>{fixtures[0].diff}</pre>

  <fieldset>
    <legend>Required checks (toggle to see what each one buys you)</legend>
    <ul>
      {checks.map((c) => (
        <li data-check={c.id}>
          <label class="gate-sim__toggle">
            <input type="checkbox" checked disabled={c.locked} />
            <span>{c.label}</span>
          </label>
          <output data-status>{word[fixtures[0].results[c.id]]}</output>
        </li>
      ))}
    </ul>
  </fieldset>

  <p class="gate-sim__verdict" data-verdict aria-live="polite"></p>
</section>

<script>
  type Result = 'pass' | 'fail' | 'review';
  const word: Record<Result, string> = { pass: 'Pass', fail: 'Fail', review: 'Needs review' };

  function initGateSims() {
    for (const sim of document.querySelectorAll<HTMLElement>('[data-gate-sim]')) {
      if (sim.dataset.initialized) continue;
      sim.dataset.initialized = 'true';
      const fixtures = JSON.parse(sim.querySelector('[data-fixtures]')?.textContent ?? '[]');
      const pr = sim.querySelector<HTMLSelectElement>('[data-pr]');
      const diff = sim.querySelector<HTMLElement>('[data-diff]');
      const verdict = sim.querySelector<HTMLElement>('[data-verdict]');
      const rows = [...sim.querySelectorAll<HTMLElement>('[data-check]')];
      if (!pr || !diff || !verdict || !fixtures.length) continue;

      const update = () => {
        const fx = fixtures[Number(pr.value)];
        diff.textContent = fx.diff;
        const blockers: string[] = [];
        for (const row of rows) {
          const on = row.querySelector<HTMLInputElement>('input')?.checked ?? false;
          const result: Result = fx.results[row.dataset.check ?? ''];
          const status = row.querySelector<HTMLElement>('[data-status]');
          if (status) status.textContent = on ? word[result] : 'Off';
          row.dataset.state = on ? result : 'off';
          if (on && result !== 'pass') blockers.push(row.querySelector('span')?.textContent ?? '');
        }
        if (blockers.length) {
          verdict.dataset.state = 'blocked';
          verdict.textContent = `Blocked by ${blockers.join(' and ')}. ${fx.risk ?? ''}`.trim();
        } else if (fx.risk) {
          verdict.dataset.state = 'unsafe';
          verdict.textContent = `Merged with a vulnerability. ${fx.risk}`;
        } else {
          verdict.dataset.state = 'safe';
          verdict.textContent = 'Merged. Nothing risky in this diff.';
        }
      };
      sim.addEventListener('change', update);
      update();
    }
  }
  initGateSims();
  document.addEventListener('astro:page-load', initGateSims);
</script>

<style>
  .gate-sim {
    padding: 1.5rem;
    margin-block: 2rem;
    border: 1px solid var(--color-card-border);
    border-radius: 0.75rem;
    background: var(--color-surface-raised);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    text-align: left;
    hyphens: none;
  }
  .gate-sim__eyebrow { color: var(--color-accent); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  h3 { margin-block: 0.5rem; font-size: 1.35rem; line-height: 1.2; }
  header > p:last-child { color: var(--color-text-secondary); font-size: 0.8rem; line-height: 1.625; }
  label { display: block; margin-top: 1.5rem; font-weight: 800; }
  select { display: block; width: 100%; min-height: 2.75rem; margin-top: 0.5rem; padding: 0.625rem 0.75rem; border: 1px solid var(--color-card-border); border-radius: 0.375rem; background: var(--color-bg); color: var(--color-text-primary); font: inherit; font-weight: 400; }
  pre { margin: 1rem 0; padding: 0.75rem 1rem; overflow-x: auto; border: 1px solid var(--color-card-border); border-radius: 0.375rem; background: var(--color-bg); font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.8rem; line-height: 1.6; white-space: pre; }
  fieldset { margin: 1.5rem 0 1rem; padding: 0; border: 0; min-width: 0; }
  legend { font-weight: 800; }
  ul { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 2.75rem; border-bottom: 1px solid var(--color-card-border); font-size: 0.9rem; }
  .gate-sim__toggle { display: flex; align-items: center; gap: 0.625rem; min-height: 2.75rem; margin: 0; font-weight: 400; cursor: pointer; }
  input { width: 1.25rem; height: 1.25rem; accent-color: var(--color-accent);
    flex-shrink: 0; }
  input:disabled + span { color: var(--color-text-secondary); }
  input:focus-visible, select:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  output { font-variant-numeric: tabular-nums; font-weight: 800; white-space: nowrap;
    flex-shrink: 0; }
  li[data-state='fail'] output, li[data-state='review'] output { color: var(--color-accent); }
  li[data-state='off'] output { color: var(--color-text-secondary); font-weight: 400; }
  .gate-sim__verdict { margin: 0; padding: 1rem; border: 1px solid var(--color-card-border); border-radius: 0.375rem; background: var(--color-bg); font-weight: 800; line-height: 1.625; }
  .gate-sim__verdict[data-state='blocked'], .gate-sim__verdict[data-state='unsafe'] { border-color: var(--color-accent); color: var(--color-accent); }
  .gate-sim p {
    text-align: left;
    hyphens: none;
  }
  .gate-sim__toggle {
    flex: 1;
    min-width: 0;
  }
</style>
