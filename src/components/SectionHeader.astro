---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
  class?: string;
  as?: 'h2' | 'h3';
}

const {
  eyebrow,
  title,
  description,
  id,
  class: className = '',
  as: headingLevel = 'h2',
} = Astro.props;
const Heading = headingLevel;
---

<header class={`section-heading editorial-section-header ${className}`} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading id={id}>{title}</Heading>
  {description && <p>{description}</p>}
</header>

<style>
  .editorial-section-header {
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .editorial-section-header > :global(h2),
  .editorial-section-header > :global(h3) {
    max-width: 15ch;
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(2.25rem, 4.5vw, 3.35rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .editorial-section-header :global(.eyebrow) {
    margin: 0 0 0.85rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .editorial-section-header > :global(p:last-child) {
    max-width: 44rem;
    margin: 0.9rem 0 0;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .editorial-section-header {
      margin-bottom: 1.5rem;
    }

    .editorial-section-header > :global(h2),
    .editorial-section-header > :global(h3) {
      font-size: clamp(2rem, 9vw, 2.8rem);
    }
  }
</style>
