---
import type { JsonLdData } from '../types/schema';
import {
  generateCanonicalUrl,
  generateStructuredData,
  type ImageMetadata,
  optimizeKeywords,
  sanitizeDescription,
  validateImageForSocialSharing,
} from '../utils/og-generator';
import { createSocialCardMetadata, resolveSocialCardForPathname } from '../utils/social-card';
import { getSocialCardManifest } from '../utils/social-card-manifest';

export interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string | { url: string; alt?: string; width?: number; height?: number; type?: string };
  url?: string;
  author?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  canonical?: string;
  noindex?: boolean;
  schema?: JsonLdData;
  keywords?: string[];
  ogTemplate?: 'default' | 'minimal' | 'tech' | 'blog';
  ogTheme?: 'dark' | 'light' | 'retro';
}

const {
  title,
  description = 'Piyush Mehta is a senior software engineer in Canada building reliable web platforms, enterprise AI workflows, and scalable product systems.',
  type = 'website',
  image,
  url = Astro.url.toString(),
  author = 'Piyush Mehta',
  publishedTime,
  modifiedTime,
  tags = [],
  canonical,
  noindex = false,
  schema,
  keywords = [
    'Piyush Mehta',
    'Senior Software Engineer',
    'TypeScript',
    'React',
    'Node.js',
    'Astro',
    'Software Architecture',
    'AI Workflows',
    'Technical Writing',
  ],
} = Astro.props;

const requestBaseUrl = (
  Astro.url.origin ||
  Astro.site?.toString() ||
  'https://piyushmehta.com'
).replace(/\/$/, '');
const productionBaseUrl = (Astro.site?.toString() || 'https://piyushmehta.com').replace(/\/$/, '');
const canonicalBaseUrl = import.meta.env.DEV ? requestBaseUrl : productionBaseUrl;
// Use the same base as the canonical URL, not the raw request origin. A page served through a
// non-canonical host (a *.workers.dev / Cloudflare preview URL) must still advertise og:image on
// piyushmehta.com — an og:image on an unreachable preview host is another way to end up blank.
const imageBaseUrl = canonicalBaseUrl;

// Optimize and sanitize content
const optimizedDescription = sanitizeDescription(description);
const canonicalUrl = canonical || generateCanonicalUrl(Astro.url.pathname, canonicalBaseUrl);

// The manifest is the single source of truth for which /og/**.png files actually got
// prerendered. Resolving through it (rather than optimistically building a path) means a page
// with no dedicated card degrades to the branded /og/default.png instead of a 404.
const socialCardManifest = await getSocialCardManifest();
const canonicalPathname = new URL(canonicalUrl).pathname;

const generatedImageMetadata = createSocialCardMetadata({
  pathname: canonicalPathname,
  baseUrl: imageBaseUrl,
  title,
  author,
  manifest: socialCardManifest,
});

if (import.meta.env.DEV) {
  const resolved = resolveSocialCardForPathname(canonicalPathname, socialCardManifest);
  if (resolved.isFallback) {
    console.warn(
      `[social-card] No dedicated card for "${canonicalPathname}" — falling back to /og/default.png. ` +
        'Add an entry to STATIC_SOCIAL_PAGES in src/utils/social-card.ts (or to the blog collection).',
    );
  }
}

// Handle image metadata with full OG Protocol compliance.
// Prefer explicit raster overrides only when crawlers can reliably render them.
let providedImageMetadata: ImageMetadata | undefined;
// PNG vs JPEG inferred from the URL rather than hardcoded — a .png override previously always
// advertised og:image:type "image/jpeg", which some scrapers reject outright.
const inferImageType = (url: string): string => (/\.png(?:[?#]|$)/i.test(url) ? 'image/png' : 'image/jpeg');

if (image && typeof image === 'string') {
  // Use the provided image URL directly
  const imageUrl = image.startsWith('http') ? image : `${imageBaseUrl}${image}`;
  providedImageMetadata = {
    url: imageUrl,
    secureUrl: imageUrl,
    type: inferImageType(imageUrl),
    width: 1200,
    height: 630,
    alt: `${title} - ${author}`,
  };
} else if (image && typeof image === 'object' && image.url) {
  // Use the provided image object
  const imageUrl = image.url.startsWith('http') ? image.url : `${imageBaseUrl}${image.url}`;
  providedImageMetadata = {
    url: imageUrl,
    secureUrl: imageUrl,
    alt: image.alt || `${title} - ${author}`,
    width: image.width || 1200,
    height: image.height || 630,
    type: image.type || inferImageType(imageUrl),
  };
}

const isCrawlerSafeRasterImage = (metadata?: ImageMetadata) => {
  if (!metadata?.url) return false;
  if (metadata.type === 'image/svg+xml') return false;
  // .webp deliberately excluded: X/Twitter and LinkedIn do not reliably render WebP og:image.
  return /\.(png|jpe?g)(?:[?#].*)?$/i.test(metadata.url);
};

const imageMetadata = isCrawlerSafeRasterImage(providedImageMetadata)
  ? providedImageMetadata!
  : generatedImageMetadata;

// Validate image for optimal social sharing
const imageValidation = validateImageForSocialSharing(imageMetadata);
if (!imageValidation.isValid && import.meta.env.DEV) {
  console.warn(`SEO Image Issues for "${title}":`, imageValidation.warnings);
}

// Generate structured data
const defaultSchemaData = generateStructuredData({
  type,
  title,
  description: optimizedDescription,
  url: canonicalUrl,
  author,
  publishedTime,
  modifiedTime,
  tags,
  image: imageMetadata.url,
});

const schemaData = schema || defaultSchemaData;

// Optimize keywords
const optimizedKeywords = optimizeKeywords(keywords, tags);
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={optimizedDescription} />
<meta name="author" content={author} />
<meta name="keywords" content={optimizedKeywords} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<!-- Facebook Meta Tags -->
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={optimizedDescription} />
<meta property="og:image" content={imageMetadata.url} />
<meta property="og:image:url" content={imageMetadata.url} />
{imageMetadata.secureUrl && <meta property="og:image:secure_url" content={imageMetadata.secureUrl} />}
{imageMetadata.type && <meta property="og:image:type" content={imageMetadata.type} />}
{imageMetadata.width && <meta property="og:image:width" content={imageMetadata.width.toString()} />}
{imageMetadata.height && <meta property="og:image:height" content={imageMetadata.height.toString()} />}
{imageMetadata.alt && <meta property="og:image:alt" content={imageMetadata.alt} />}
<meta property="og:site_name" content="Piyush Mehta" />
<meta property="og:locale" content="en_US" />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:domain" content="piyushmehta.com" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title.length > 70 ? title.substring(0, 67) + '...' : title} />
<meta name="twitter:description" content={optimizedDescription.length > 200 ? optimizedDescription.substring(0, 197) + '...' : optimizedDescription} />
<meta name="twitter:image" content={imageMetadata.url} />
<meta name="twitter:image:src" content={imageMetadata.url} />
<meta name="twitter:image:alt" content={imageMetadata.alt || `${title} - ${author}`} />
<meta name="twitter:site" content="@piyushmehtas" />
<meta name="twitter:creator" content="@piyushmehtas" />

<!-- Article specific meta tags -->
{
  type === 'article' && publishedTime && (
    <>
      <meta
        property="article:published_time"
        content={publishedTime.toISOString()}
      />
      {modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )}
      <meta property="article:author" content={author} />
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
      <meta property="article:section" content="Technology" />
    </>
  )
}

<!-- Additional SEO tags -->
<meta name="theme-color" content="#1a1a2e" />
<meta name="msapplication-TileColor" content="#1a1a2e" />
<meta name="format-detection" content="telephone=no" />

<!-- Preconnect to external domains -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<!-- Additional structured data for articles -->
{
  type === 'article' && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://piyushmehta.com',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Blog',
            item: 'https://piyushmehta.com/blog',
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: title,
            item: url,
          },
        ],
      })}
    />
  )
}

<!-- WebSite schema with SearchAction for Google Sitelinks Searchbox -->
{
  type === 'website' && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Piyush Mehta',
        url: 'https://piyushmehta.com',
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: 'https://piyushmehta.com/blog?q={search_term_string}',
          },
          'query-input': 'required name=search_term_string',
        },
      })}
    />
  )
}

<!-- Person structured data -->
{
  type === 'website' && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Piyush Mehta',
        url: 'https://piyushmehta.com',
        jobTitle: 'Senior Software Engineer',
        description:
          'Senior software engineer in Canada building reliable web platforms, enterprise AI workflows, and scalable product systems.',
        image: 'https://piyushmehta.com/images/icon-512.png',
        sameAs: [
          'https://github.com/piyush97',
          'https://linkedin.com/in/piyush24',
          'https://twitter.com/piyushmehtas',
        ],
        worksFor: {
          '@type': 'Organization',
          name: 'Tech Industry',
        },
        alumniOf: {
          '@type': 'EducationalOrganization',
          name: 'University of Windsor',
        },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Toronto',
          addressRegion: 'Ontario',
          addressCountry: 'Canada',
        },
        knowsAbout: [
          'Software Engineering',
          'Full Stack Development',
          'Node.js',
          'React',
          'TypeScript',
          'Astro',
          'Enterprise AI Workflows',
          'Software Architecture',
          'Azure',
          'AWS',
          'PostgreSQL',
          'Microservices',
          'Security',
          'Technical Leadership',
          'Developer Education',
          'Technical Writing',
        ],
        hasOccupation: {
          '@type': 'Occupation',
          'name': 'Software Engineer',
          'occupationLocation': {
            '@type': 'Country',
            'name': 'Canada'
          }
        },
        awards: [
          'Tech speaker and workshop lead',
          'Google Developer Student Clubs mentor',
          '5+ years building production software',
        ],
      })}
    />
  )
}
