*.code-workspace
.claude/
.serena/
.claudedocs/
*.md
tests/*.ts-snapshots
.agents/*
.omx/*
.playwright-mcp/*env.d.ts
src/varlock.env.d.ts
# Local draft material and tooling artifacts (not part of the blog content)
.drafts/
.codex/
skills-lock.json
env.d.ts
.env*
